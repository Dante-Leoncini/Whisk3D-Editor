# malla de prueba del ORDEN DE TRANSPARENTES del override de visibilidad:
# 4 triangulos, DOS materiales (tris 0-1 = solido opaco, tris 2-3 = vidrio
# transparente). 1 usemtl = 1 mesh part; faces[] conserva el orden del archivo.
mtllib vis-dos.mtl
v -4 0 -1
v -3 0 -1
v -3.5 0 1
v -2 0 -1
v -1 0 -1
v -1.5 0 1
v 1 0 -1
v 2 0 -1
v 1.5 0 1
v 3 0 -1
v 4 0 -1
v 3.5 0 1
vt 0 0
vt 1 0
vt 0.5 1
vn 0 1 0
usemtl solido
f 1/1/1 2/2/1 3/3/1
f 4/1/1 5/2/1 6/3/1
usemtl vidrio
f 7/1/1 8/2/1 9/3/1
f 10/1/1 11/2/1 12/3/1
