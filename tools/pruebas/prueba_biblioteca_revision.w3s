# ---- Q. "Open in IDE" de la biblioteca con lo tipeado SIN GUARDAR: pregunta antes de descartar ----
# (antes: el IDE recargaba el archivo y se perdian los cambios y su undo, sin ningun cartel)
escenadefecto
guardarw3d prueba_revision_rtQ.w3d
abrirw3d prueba_revision_rtQ.w3d
entradatexto scripts/a.lua -- script a
entradatexto scripts/b.lua -- script b
vpkind 5 7
idebib abrir scripts/a.lua
idebib archivo scripts/a.lua
idebib ensuciar
idebib sucio 1
# el MISMO script: no se recarga (lo tipeado se queda)
idebib abrir scripts/a.lua
idebib tiene tipeado sin guardar
# otro script: el cartel; "No" deja todo como estaba
idebib abrir scripts/b.lua
outconfirmar no
idebib archivo scripts/a.lua
idebib tiene tipeado sin guardar
# "Si" descarta y abre el otro
idebib abrir scripts/b.lua
outconfirmar si
idebib archivo scripts/b.lua
idebib sucio 0
idebib tiene script b

