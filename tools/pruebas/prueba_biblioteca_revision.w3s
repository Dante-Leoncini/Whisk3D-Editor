# ==========================================================================
#  LA BIBLIOTECA: los casos que la revision de la FASE 4b encontro rotos. Cada bloque es un caso que
#  antes fallaba (el comentario dice que pasaba).
# ==========================================================================
window 1280 720

# ---- A. una MALLA 3D borrada (la retiene el undo), guardar y Ctrl+Z: el proyecto se puede volver a guardar ----
# (antes: el recurso seguia nombrando su entrada del .w3d viejo y todo guardado posterior fallaba)
scenedefault
savew3d prueba_revision_rtA.w3d
openw3d prueba_revision_rtA.w3d
recdeleteforced meshes Cubo
savew3d prueba_revision_rtA.w3d
undo
meshcheck Cubo resource Cubo
savew3d prueba_revision_rtA2.w3d
openw3d prueba_revision_rtA2.w3d
meshcheck Cubo resource Cubo
meshesresource n 1
# la variante del HUERFANO: el objeto borrado primero y despues su recurso
selobj Cubo
delete
recdelete meshes Cubo
savew3d prueba_revision_rtA3.w3d
undo
savew3d prueba_revision_rtA4.w3d
openw3d prueba_revision_rtA4.w3d
meshcheck Cubo resource Cubo

# ---- B. una TEXTURA pasada afuera, guardar y Ctrl+Z: vuelve adentro con su archivo ----
# (antes: el guardado siguiente la escribia "ext:texturas/..." como faltante)
scenedefault
selobj Cubo
matnew
objtexture Cubo dosmats.png
savew3d prueba_revision_rtB.w3d
openw3d prueba_revision_rtB.w3d
reclocate textures textures/dosmats.png outside prueba_revision_rt_dosmats.png
savew3d prueba_revision_rtB.w3d
undo
reclocation textures textures/dosmats.png inside
savew3d prueba_revision_rtB2.w3d
jsonhas prueba_revision_rtB2.w3d "ext:texturas 0
openw3d prueba_revision_rtB2.w3d
resource textures textures/dosmats.png exists 1 users 1
# ...y BORRAR EN USO, guardar y Ctrl+Z: la unica copia estaba en el .w3d que se piso
recdeleteforced textures textures/dosmats.png
savew3d prueba_revision_rtB3.w3d
undo
savew3d prueba_revision_rtB4.w3d
jsonhas prueba_revision_rtB4.w3d "ext:texturas 0
openw3d prueba_revision_rtB4.w3d
resource textures textures/dosmats.png exists 1 users 1

# ---- C. un SONIDO pasado afuera, guardar y Ctrl+Z ----
scenedefault
savew3d prueba_revision_rtC.w3d
openw3d prueba_revision_rtC.w3d
entryraw sounds/bip.wav sounds/bip.wav
savew3d prueba_revision_rtC.w3d
openw3d prueba_revision_rtC.w3d
reclocate sounds sounds/bip.wav outside prueba_revision_rt_bip.wav
savew3d prueba_revision_rtC.w3d
undo
savew3d prueba_revision_rtC2.w3d
openw3d prueba_revision_rtC2.w3d
resource sounds sounds/bip.wav exists 1

# ---- D. soltar un MATERIAL en el 3D sobre una malla COMPARTIDA: lo ven todos sus objetos ----
# (antes: solo el tocado; al guardar el recurso se partia en dos y el Alt+D se perdia)
scenedefault
selobj Cubo
matnew
meshdup Cubo linked
matloose Rojo
outview library
outrelease Rojo 3d 0 0
meshcheck Cubo material 0 Rojo
meshcheck Cubo.001 material 0 Rojo
savew3d prueba_revision_rtD.w3d
openw3d prueba_revision_rtD.w3d
meshcheck Cubo.001 shares Cubo
meshesregistry n 1

# ---- E. soltar en el 3D una malla cuya .w3db esta ROTA: no queda un objeto vacio ni una malla fantasma ----
scenedefault
recduplicate meshes Cubo Cubo.001
selobj Cubo
delete
savew3d prueba_revision_rtE.w3d
w3dbbreak prueba_revision_rtE.w3d prueba_revision_rtE2.w3d cut
openw3d prueba_revision_rtE2.w3d
outview library
outrelease Cubo.001 3d 0 0
fail selobj Cubo.001
meshesregistry n 1
meshesresource n 1

# ---- F. el MODO MOVER de la biblioteca (G) y abrir otro proyecto: el undo de carpetas sigue andando ----
# (antes: el grupo quedaba abierto para siempre y el proximo G + Esc metia las carpetas del proyecto anterior)
scenedefault
foldernew - BCarpeta
matloose Bmat
savew3d prueba_revision_rtF.w3d
scenedefault
matloose Xmat
foldernew - Pieles
outview library
outclick Xmat
outkeypc g
outkey down
outmove si
openw3d prueba_revision_rtF.w3d
outview library
foldernew - Nueva
folders has Nueva
undo
folders hasnot Nueva
outclick Bmat
outkeypc g
outkeypc esc
folders has BCarpeta hasnot Pieles

# ---- G. Ctrl+Z en medio del modo mover: CANCELA el modo (como Esc) y no se come lo deshecho ----
scenedefault
matloose Suelto
matloose Piel
outview library
foldernew - A
recmove materials Piel A
outclick Suelto
outkeypc g
outkeypc down
outmove si
resource materials Suelto folder A
undo
outmove no
resource materials Suelto folder -
resource materials Piel folder A
undo
resource materials Piel folder -

# ---- H. un recurso elegido en EDIT MODE: volver a elegir el objeto en la escena lo suelta ----
scenedefault
selobj Cubo
matnew
mode edit
outview library
outclick Material
propsmesh tab 3 resource 1
mode object
outview scene
outclick Cubo
selection n 1 has Cubo
propstab 3
propsmesh tab 3 resource 0 mesh3d 1

# ---- I. elegir un OBJETO con la biblioteca a la vista: la fila del recurso deja de estar activa y elegida ----
scenedefault
selobj Cubo
matnew
outview library
outclick Material
outsel n 1
selobj Cubo
recactive none
outrender
outsel n 0
fail outcolor Material active

# ---- J. borrar una seleccion con CARPETAS y recursos: la carpeta (vacia) tambien se borra ----
scenedefault
savew3d prueba_revision_rtJ.w3d
openw3d prueba_revision_rtJ.w3d
matloose Suelto
outview library
foldernew - Vacia
outclick Vacia
outclick Suelto ctrl
outsel n 2
outkeypc supr
outconfirm si has The selected folders are deleted too if they end up empty.
folders n 0
resource materials Suelto exists 0
undo
folders has Vacia

# ---- K. el cartel de borrar una MALLA 3D en uso dice que sus OBJETOS se borran ----
scenedefault
savew3d prueba_revision_rtK.w3d
openw3d prueba_revision_rtK.w3d
outview library
outclick Cubo
outmenu Delete
outconfirm si has Its objects will be deleted too (Undo brings them back).
fail selobj Cubo
undo
selobj Cubo

# ---- L. "Skinned" es del objeto (un armature), no "tiene grupos de vertices" ----
scenedefault
selobj Cubo
vgnew Seleccion
savew3d prueba_revision_rtL.w3d
openw3d prueba_revision_rtL.w3d
recfield meshes Cubo Vertex groups = 1
recfield meshes Cubo Skinned = No

# ---- M. doble click en el OJO de una fila: alterna el ojo, NO abre el renombrar ----
scenedefault
outview scene
fail outdobleclick Cubo ojo
outdoubleclick Cubo
outesc

# ---- N. la cuadricula de una LIBRERIA externa no dibuja el recurso homonimo del proyecto abierto ----
scenedefault
selobj Cubo
matnew
matcolor 1 0 0
savew3d prueba_revision_rtN_v4.w3d
scenedefault
selobj Cubo
matnew
matcolor 0 0 1
liblink prueba_revision_rtN_v4.w3d
outview lib:prueba_revision_rtN_v4
outgrid 1
# (la libreria dibuja SU material -rojo-, no el homonimo azul del proyecto)
outmini Material si cell red
outview library
outmini Material si cell blue

# ---- O. la esfera de un material lleva su TEXTURA (dos blancos con texturas distintas ya no son iguales) ----
scenedefault
selobj Cubo
matnew
objtexture Cubo dosmats.png
add cube
selobj Cubo.001
matnew
objtexture Cubo.001 dosmats-b.png
minidistinct materials Material Material.001

# ---- P. abrir un proyecto con varias texturas: nada queda "sin guardar" cuando terminan de cargar ----
scenedefault
selobj Cubo
matnew
objtexture Cubo dosmats.png
add cube
selobj Cubo.001
matnew
objtexture Cubo.001 dosmats-b.png
add cube
selobj Cubo.002
matnew
objtexture Cubo.002 capas_base.png
savew3d prueba_revision_rtP.w3d
openw3d prueba_revision_rtP.w3d
changes n 0
texasleep frames 5
changes n 0

# ---- Q. "Open in IDE" de la biblioteca con lo tipeado SIN GUARDAR: pregunta antes de descartar ----
# (antes: el IDE recargaba el archivo y se perdian los cambios y su undo, sin ningun cartel)
scenedefault
savew3d prueba_revision_rtQ.w3d
openw3d prueba_revision_rtQ.w3d
entrytext scripts/a.lua -- script a
entrytext scripts/b.lua -- script b
vpkind 5 7
idelibrary open scripts/a.lua
idelibrary file scripts/a.lua
idelibrary markDirty
idelibrary dirty 1
# el MISMO script: no se recarga (lo tipeado se queda)
idelibrary open scripts/a.lua
idelibrary has tipeado sin guardar
# otro script: el cartel; "No" deja todo como estaba
idelibrary open scripts/b.lua
outconfirm no
idelibrary file scripts/a.lua
idelibrary has tipeado sin guardar
# "Si" descarta y abre el otro
idelibrary open scripts/b.lua
outconfirm si
idelibrary file scripts/b.lua
idelibrary dirty 0
idelibrary has script b

# ---- R. "External (choose where)...": al lado del .w3d ya hay OTRO archivo con ese nombre -> otro lugar ----
# (antes: la UI solo ofrecia la ruta de al lado del .w3d y no habia salida)
scenedefault
savew3d prueba_revision_rtR.w3d
openw3d prueba_revision_rtR.w3d
entryraw textures/dosmats.png dosmats-b.png
outview library
outclick dosmats.png
recactive textures textures/dosmats.png
fail recubicar textures textures/dosmats.png fuera
recexternal prueba_revision_rt_elegida.png
reclocation textures prueba_revision_rt_elegida.png outside
undo
reclocation textures textures/dosmats.png inside

# ---- S. los ATAJOS que anuncian los menus del outliner andan con el mouse sobre el outliner ----
# (antes: Shift+D, Alt+D y Ctrl+I no hacian nada ahi y Alt+A sin seleccion seleccionaba todo)
scenedefault
outview scene
selobj Cubo
outkeypc shiftd
selection n 1 has Cubo.001
meshcheck Cubo.001 noshare Cubo
outkeypc altd
selection n 1 has Cubo.002
meshcheck Cubo.002 shares Cubo.001
outkeypc alta
selection n 0
outkeypc alta
selection n 0
outkeypc ctrli
selection has Cubo has Cubo.001 has Cubo.002
selobj Cubo
outkeypc ctrli
selection has Cubo.001 has Cubo.002
matloose Uno
matloose Dos
outview library
outclick Uno
outkeypc a
outsel has Uno has Dos
outkeypc alta
outsel n 1 has Uno
