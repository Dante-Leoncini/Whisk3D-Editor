# ==========================================================================
#  LA BIBLIOTECA: los casos que la revision de la FASE 4b encontro rotos. Cada bloque es un caso que
#  antes fallaba (el comentario dice que pasaba).
# ==========================================================================
ventana 1280 720

# ---- A. una MALLA 3D borrada (la retiene el undo), guardar y Ctrl+Z: el proyecto se puede volver a guardar ----
# (antes: el recurso seguia nombrando su entrada del .w3d viejo y todo guardado posterior fallaba)
escenadefecto
guardarw3d prueba_revision_rtA.w3d
abrirw3d prueba_revision_rtA.w3d
recborrarforzado mallas Cubo
guardarw3d prueba_revision_rtA.w3d
undo
mallainfo Cubo recurso Cubo
guardarw3d prueba_revision_rtA2.w3d
abrirw3d prueba_revision_rtA2.w3d
mallainfo Cubo recurso Cubo
mallasrecurso n 1
# la variante del HUERFANO: el objeto borrado primero y despues su recurso
selobj Cubo
delete
recborrar mallas Cubo
guardarw3d prueba_revision_rtA3.w3d
undo
guardarw3d prueba_revision_rtA4.w3d
abrirw3d prueba_revision_rtA4.w3d
mallainfo Cubo recurso Cubo

# ---- B. una TEXTURA pasada afuera, guardar y Ctrl+Z: vuelve adentro con su archivo ----
# (antes: el guardado siguiente la escribia "ext:texturas/..." como faltante)
escenadefecto
selobj Cubo
matnew
texasignar Cubo dosmats.png
guardarw3d prueba_revision_rtB.w3d
abrirw3d prueba_revision_rtB.w3d
recubicar texturas texturas/dosmats.png fuera prueba_revision_rt_dosmats.png
guardarw3d prueba_revision_rtB.w3d
undo
recubicacion texturas texturas/dosmats.png dentro
guardarw3d prueba_revision_rtB2.w3d
jsontiene prueba_revision_rtB2.w3d "ext:texturas 0
abrirw3d prueba_revision_rtB2.w3d
recurso texturas texturas/dosmats.png existe 1 usuarios 1
# ...y BORRAR EN USO, guardar y Ctrl+Z: la unica copia estaba en el .w3d que se piso
recborrarforzado texturas texturas/dosmats.png
guardarw3d prueba_revision_rtB3.w3d
undo
guardarw3d prueba_revision_rtB4.w3d
jsontiene prueba_revision_rtB4.w3d "ext:texturas 0
abrirw3d prueba_revision_rtB4.w3d
recurso texturas texturas/dosmats.png existe 1 usuarios 1

