# ==========================================================================
#  LIBRERIAS EXTERNAS (2): lo de ADENTRO de una libreria (io/Librerias.h, objects/ProxyW3d.h)
#  Correr DESDE ESTA CARPETA:
#    ../../platform/linux/build/whisk3d --script prueba_librerias_extras.w3s
#
#  La libreria "personajes" (libcrear) y una segunda, "extras" (libcrearextras), que VINCULA a
#  personajes (una libreria adentro de otra) y trae: el prefab "Cartel" (textura y script AFUERA de
#  su .w3d, "ext:"), el prefab "Escuadra" (un proxy del Enemigo de personajes + un cubo con su malla
#  Tronco), el prefab "Sonoro" (sonido() de un wav suelto y de una entrada suya) y la escena "Panel"
#  (una escena UI con una imagen cuyo script le pone una textura de la libreria).
#    A) LIBRERIA ADENTRO DE LIBRERIA: el nivel vincula SOLO extras; personajes se monta OCULTA
#       ("extras~personajes") y la Escuadra genera su Enemigo y su Viga. Si el nivel vincula el mismo
#       archivo, la de adentro es ESA (comparten memoria); guardar no escribe nada de la de adentro;
#    B) lo que la libreria deja AFUERA de su .w3d ("ext:") se lee de al lado de SU .w3d; su script
#       (tambien de afuera) nombra un archivo SUELTO al lado de la libreria y una ENTRADA suya;
#    C) sonido() de un script de la libreria: el suelto y la entrada de SU libreria;
#    D) una escena UI de la libreria: sus rutas (textura, script) son de ella, y setTextura() tambien;
#    E) el nombre pelado de un prefab de la de adentro desde un script de la libreria (instanciar);
#    F) desvincular regenera sus proxies VACIOS (y Ctrl+Z / Ctrl+Y); volver a vincular el mismo archivo
#       recupera su nombre.
# ==========================================================================

window 1280 720
libcreate /tmp/w3d_f8x/lib personajes.w3d dosmats.png
libcreateextras /tmp/w3d_f8x/extras extras.w3d dosmats.png /tmp/w3d_f8x/lib/personajes.w3d
# (la libreria: su textura y su script de afuera quedan "ext:"; lo suelto no entra; lo importado si)
entryhas /tmp/w3d_f8x/extras/extras.w3d project.json ext:fuera/cartel.png 1
entryhas /tmp/w3d_f8x/extras/extras.w3d prefabs/cartel.w3dp ext:fuera/externo.lua 1
entryexists /tmp/w3d_f8x/extras/extras.w3d textures/cartel.png 0
entryexists /tmp/w3d_f8x/extras/extras.w3d scripts/externo.lua 0
entryexists /tmp/w3d_f8x/extras/extras.w3d sounds/entrada.wav 1
entryexists /tmp/w3d_f8x/extras/extras.w3d extra/roca.w3d 1
entryexists /tmp/w3d_f8x/extras/extras.w3d textures/logo.png 1
entryexists /tmp/w3d_f8x/extras/extras.w3d sounds/bip.wav 0
entryexists /tmp/w3d_f8x/extras/extras.w3d anexos/piedra.w3d 0
entryhas /tmp/w3d_f8x/extras/extras.w3d project.json "libs": 1
entryhas /tmp/w3d_f8x/extras/extras.w3d prefabs/escuadra.w3dp "proxy", 1
entryhas /tmp/w3d_f8x/extras/extras.w3d prefabs/escuadra.w3dp personajes/Tronco 1

# --- A) LIBRERIA ADENTRO DE LIBRERIA ---
scenedefault
liblink /tmp/w3d_f8x/extras/extras.w3d
libinfo extras linked 1 prefabs 4 scenes 2 count 1
libinfo personajes linked 0
libproxy extras prefab Escuadra 0 0 0
libnested extras personajes as extras~personajes
libinfo personajes linked 0 count 1
prefabnode Escuadra Enemigo type proxy generated 1
prefabnode Escuadra Enemigo/Enemigo/Esqueleto/Cuerpo type mesh generated 1
prefabnode Escuadra Viga type mesh generated 1
meshcheck Viga resource extras~personajes/Tronco
libshared extras~personajes prefab Enemigo proxies 1 meshes 1 animsets 1 materials 1 textures 1
libresource mesh extras~personajes/Cuerpo exists 1 lib extras~personajes library 0
libmark Escuadra Enemigo/Enemigo/Esqueleto/Cuerpo lock
libmark Escuadra Viga lock
libmark Escuadra proxy -
# (el proxy de adentro no se toca: ni Edit Mode, ni las filas de Properties)
libedit Escuadra Enemigo/Enemigo/Esqueleto/Cuerpo
prefabsel Escuadra Enemigo/Enemigo/Esqueleto/Cuerpo
libpropsmesh 3 lectura 1 try
# (el nivel vincula el MISMO archivo: la de adentro pasa a ser esa y comparten memoria)
liblink /tmp/w3d_f8x/lib/personajes.w3d
libnested extras personajes as personajes
libproxy personajes prefab Enemigo 4 0 0
libproxy extras prefab Escuadra 8 0 0
libshared personajes prefab Enemigo proxies 2 meshes 1 animsets 1 materials 1 textures 1
# (guardar: nada de la de adentro entra al nivel; reabrir la vuelve a resolver igual)
savew3d /tmp/w3d_f8x/nivel/nivel.w3d
entryhas /tmp/w3d_f8x/nivel/nivel.w3d project.json extras~ 0
entryhas /tmp/w3d_f8x/nivel/nivel.w3d project.json Tronco 0
entryexists /tmp/w3d_f8x/nivel/nivel.w3d meshes/tronco.w3db 0
openw3d /tmp/w3d_f8x/nivel/nivel.w3d
libnested extras personajes as personajes
libshared personajes prefab Enemigo proxies 3 meshes 1 animsets 1 materials 1 textures 1
savew3d /tmp/w3d_f8x/nivel/nivel2.w3d
openw3d /tmp/w3d_f8x/nivel/nivel2.w3d
savew3d /tmp/w3d_f8x/nivel/nivel3.w3d
w3dequal /tmp/w3d_f8x/nivel/nivel2.w3d /tmp/w3d_f8x/nivel/nivel3.w3d

# --- B) AFUERA de su .w3d ("ext:"), SUELTOS y ENTRADAS que nombra su script ---
scenedefault
liblink /tmp/w3d_f8x/extras/extras.w3d
libproxy extras prefab Cartel 0 0 0
libtexload
texrefof material extras/Pintura /tmp/w3d_f8x/extras/fuera/cartel.png
prefabnode Cartel . type empty generated 1
simplay 3
scriptinfo shared externo OK
scriptinfo shared anexos Piedra+Roca
simstop

# --- C) sonido() de un script de la libreria: lo suelto y la entrada son de SU libreria ---
libproxy extras prefab Sonoro 4 0 0
simplay 3
scriptinfo shared sonoro listo
libsound /tmp/w3d_f8x/extras/sounds/bip.wav cached 1
libsound lib:extras/sounds/entrada.wav cached 1
simstop

# --- D) una escena UI de la libreria: sus rutas son de ELLA (y las de su setTextura) ---
libproxy extras scene Panel 0 0 4
libimage Fondo texture lib:extras/textures/logo.png
libimage Icono texture - script lib:extras/scripts/panel.lua
simplay 3
libimage Icono texture lib:extras/textures/logo.png
simstop

# --- E) un script de la libreria instancia un prefab de la de ADENTRO (el nombre de SU registro) ---
scenedefault
liblink /tmp/w3d_f8x/extras/extras.w3d
libproxy extras prefab Llamador 0 0 0
simplay 3
scriptinfo shared llamado proxy
scriptinfo shared tronco si
prefablive 2
simstop
prefablive 1

# --- F) desvincular: sus proxies se regeneran VACIOS; Ctrl+Z / Ctrl+Y ---
scenedefault
liblink /tmp/w3d_f8x/lib/personajes.w3d
libproxy personajes prefab Enemigo 0 0 0 times 3
libunlink personajes
libinfo personajes linked 0 count 0
libproxyinfo Enemigo lib personajes generated 0 empty 1
libproxyinfo Enemigo.002 generated 0 empty 1
undo
libinfo personajes linked 1 count 1
libproxyinfo Enemigo generated 4 empty 0
libproxyinfo Enemigo.002 generated 4 empty 0
redo
libproxyinfo Enemigo.001 generated 0 empty 1
undo
libproxyinfo Enemigo.001 generated 4 empty 0
# (volver a vincular el MISMO archivo, sin Ctrl+Z: recupera su nombre y sus proxies vuelven)
libunlink personajes
libproxyinfo Enemigo empty 1
liblink /tmp/w3d_f8x/lib/personajes.w3d
libinfo personajes linked 1
libproxyinfo Enemigo generated 4 empty 0
undo
libproxyinfo Enemigo empty 1
libinfo personajes linked 0
