# ==========================================================================
#  LOS ARCHIVOS QUE FALTAN (biblioteca)
#  "guardo y dice que un archivo externo no esta, pero no veo nada en la biblioteca": el ORIGEN de una malla importada
#  (el .obj/.stl del que salio) que ya no esta en la maquina se lista en "Archivos que faltan" como HUERFANO. Es solo
#  procedencia (la geometria viaja adentro del .w3d): "Purgar huerfanos" lo olvida y el guardado deja de avisar.
# ==========================================================================
scenedefault
deletefile /tmp/w3d_faltan_cubo.stl
stl export /tmp/w3d_faltan_cubo.stl sel
import /tmp/w3d_faltan_cubo.stl
resources missing n 0
# (el archivo de origen desaparece: un pendrive que se saco, un proyecto que vino de otra maquina)
deletefile /tmp/w3d_faltan_cubo.stl
savew3d /tmp/w3d_faltan.w3d
entryexists /tmp/w3d_faltan.w3d EXTERNALS.txt 1
resources missing n 1
recpurge missing n 1
resources missing n 0
savew3d /tmp/w3d_faltan.w3d
entryexists /tmp/w3d_faltan.w3d EXTERNALS.txt 0
