# Quad HORIZONTAL de 1x1 (plano XZ). El .w3d lo inclina con rotX y lo escala:
# asi la RAMPA y el BLOB comparten EXACTAMENTE el mismo plano (coplanares de
# verdad, bit a bit), que es el peor caso del z-fighting.
o sombra-piso
v -0.5 0.0 -0.5
v  0.5 0.0 -0.5
v  0.5 0.0  0.5
v -0.5 0.0  0.5
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 1.0 0.0
usemtl sombra-piso
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
