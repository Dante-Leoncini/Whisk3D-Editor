# ==========================================================================
#  LIBRERIAS en el JUEGO: los proxies de un nivel y instanciar("<libreria>/<prefab>", ...) de lua,
#  en el Play del editor y en el JUEGO COMPILADO (io/Librerias.h, objects/ProxyW3d.h).
#  Correr DESDE ESTA CARPETA (ver prueba_juego3d.w3s):
#    ../../platform/linux/build/whisk3d --script prueba_juego3d_librerias.w3s
#
#  libjuegomin: un juego 3D minimo que VINCULA la libreria "personajes" (en una carpeta HERMANA del
#  juego: "ext:../lib/personajes.w3d"), con 3 proxies de su prefab "Enemigo" (el del medio con el
#  override vida=25) y un "Director" que jugando instancia 5 enemigos mas con instanciar("personajes/
#  Enemigo", ...). El enemigo.lua es DE LA LIBRERIA: cada uno cuenta en compartido y mira SU cuerpo
#  (scope por proxy). El veredicto ("[librerias] OK creados=5 enemigos=8 scope=8 vida=95") sale en el
#  Play y en el binario. "Compilar juego" empaqueta las entradas de la libreria en librerias/personajes/
#  (el runtime lee sus rutas "lib:personajes/..." de ahi, sin el .w3d de la libreria): con los assets
#  sueltos al lado del binario y con los assets EMPAQUETADOS en el pak.
#  Compila un juego de verdad (cmake + g++), asi que tarda mas que las demas.
# ==========================================================================

window 640 480
libcreate /tmp/w3d_f8_juego/lib personajes.w3d dosmats.png
entryexists /tmp/w3d_f8_juego/lib/personajes.w3d scripts/enemigo.lua 1
libgamemin /tmp/w3d_f8_juego/juego /tmp/w3d_f8_juego/lib/personajes.w3d
savew3d /tmp/w3d_f8_juego/juego/libjuego.w3d
entryhas /tmp/w3d_f8_juego/juego/libjuego.w3d project.json ext:../lib/personajes.w3d 1
entryexists /tmp/w3d_f8_juego/juego/libjuego.w3d scripts/enemigo.lua 0
openw3d /tmp/w3d_f8_juego/juego/libjuego.w3d
prefablive 3
libproxyinfo Enemigo.001 lib personajes element Enemigo generated 4
prefabinfo Enemigo.001 overrides 1
libshared personajes prefab Enemigo proxies 3 meshes 1 animsets 1 materials 1 textures 1

# --- el Play del editor: instanciar() de un prefab de la libreria crea proxies ---
simplay 30
scriptinfo shared juez OK
scriptinfo shared enemigos 8
scriptinfo shared scope_ok 8
scriptinfo shared vida_total 95
prefablive 8
simstop
prefablive 3

# --- el binario (modo debug: deja su whisk3d.log); la libreria viaja en librerias/personajes/ ---
compilegame 0 0 1
libpath /tmp/w3d_f8_juego/juego/platform-build/linux/libs/personajes/project.json lee 1
libpath /tmp/w3d_f8_juego/juego/platform-build/linux/libs/personajes/scripts/enemigo.lua lee 1
libpath /tmp/w3d_f8_juego/juego/platform-build/linux/libs/personajes/textures/piel.png lee 1
libpath /tmp/w3d_f8_juego/juego/platform-build/linux/lib/personajes.w3d lee 0
libgamelog /tmp/w3d_f8_juego/juego libjuego creados=5 enemigos=8 scope=8 vida=95

# --- lo mismo con los assets EMPAQUETADOS (el pak): la libreria viaja adentro del binario ---
compilegame 0 1 1
libpath /tmp/w3d_f8_juego/juego/build/linux/libs/personajes/project.json lee 0
libgamelog /tmp/w3d_f8_juego/juego libjuego creados=5 enemigos=8 scope=8 vida=95
