# ==========================================================================
#  HITBOX en el EDITOR: Add > Hitbox (hijo del activo con el tamano de su malla,
#  o suelto), Shift+D (W3dDuplicarUno), la tarjeta del panel de propiedades, el
#  icono del outliner y el guardado/carga de todos los campos.
#  Correr DESDE ESTA CARPETA (ver prueba_hitbox.w3s):
#    ../../platform/linux/build/whisk3d --script prueba_hitbox_editor.w3s
# ==========================================================================

window 1280 720
scenedefault

# un cubo escalado: el hitbox HIJO toma el tamano de la malla en el espacio LOCAL
# del cubo (la escala del padre la aplica el motor, no se hornea en 'tam')
add cube
nameactive Caja
objscale 3 3 3
hitboxadd Caja
hitboxinfo Hitbox parent Caja owner Caja size 2 2 2 center 0 0 0 active 1 bodies 0
# sin activo: suelto, con el cubo unitario (y es su propio dueno)
hitboxadd -
hitboxinfo Hitbox.001 parent - owner Hitbox.001 size 1 1 1

# un hitbox con TODOS los campos distintos del default
hitboxnew Sensor label jugador filter enemigo bodies 1 active 0 size 1 2 3 center 0.5 0 -0.5 pos 4 0 0
hitboxdup Sensor
hitboxinfo Sensor.001 label jugador filter enemigo bodies 1 active 0 size 1 2 3 center 0.5 0 -0.5
hitboxprops Sensor

# guardar + abrir: los campos viajan todos
savew3d prueba_hitbox_editor_v4.w3d
openw3d prueba_hitbox_editor_v4.w3d
hitboxinfo Sensor label jugador filter enemigo bodies 1 active 0 size 1 2 3 center 0.5 0 -0.5
hitboxinfo Sensor.001 label jugador filter enemigo bodies 1 active 0
hitboxinfo Hitbox parent Caja owner Caja size 2 2 2
hitboxinfo Hitbox.001 parent - size 1 1 1
hitboxprops Hitbox
