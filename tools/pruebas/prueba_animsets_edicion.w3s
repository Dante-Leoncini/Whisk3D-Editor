# prueba_animsets_edicion.w3s — FASE 3: los clips COMPARTIDOS de un animset en el EDITOR
#
#  Criterios de aceptacion:
#   - MIRAR no copia: ver el clip de un armature en el dope sheet y en el editor de curvas,
#     encuadrarlo, elegir un keyframe (la tarjeta Keyframe), posar en Pose Mode, reproducir y
#     dibujar la UI entera dejan al armature colgado del animset (sin memoria de mas);
#   - EDITAR copia (copy-on-write) SOLO al armature editado, por cualquier camino de la UI:
#     mover/escalar/cancelar/borrar/duplicar keyframes, interpolacion, tipo de handle, Smart
#     Euler, la tarjeta Keyframe, arrastrar un handle, la I de Pose Mode, el End del clip (solo si
#     cambia) y el Ctrl+Z. El animset queda INTACTO (los SELLOS se verifican antes de cada
#     comando) y los demas usuarios reproducen exactamente igual;
#   - reordenar o borrar los clips de un armature no copia nada y se guarda;
#   - los animsets como RECURSOS del proyecto (lo que usa el outliner por recursos): usuarios,
#     renombrar (unico en el registro), carpeta cosmetica, purgar huerfanos; todo sobrevive al
#     guardado.
window 1280 720

# 16 armatures del mismo rig (el segundo con un "Quieto" propio, el tercero con un clip repetido,
# que pasa a clips propios al abrir) -> 15 colgados del animset "Personaje"
animsetsynthetic 16 prueba_animsets_ed_v4.w3d
openw3d prueba_animsets_ed_v4.w3d
animsetinfo live 1 refs 15 clips 5 copies 1
animsetarm Personaje.002 shared 0
animsetstamps clips 5
posesnapshot animsets_ed_base.pose game 1
# los dos que NO se van a editar, para compararlos al final de B
posesnapshot animsets_ed_otros_a.pose game 1 only Personaje.001 only Personaje.002

# ---- A) MIRAR no copia ----
animsetshow Personaje 1 shared 1 copies 0
animsetshow Personaje.001 0 shared 1 copies 0
animsetshow Personaje.004 2 shared 1 copies 0
animsetshow Personaje.002 1 shared 0 copies 0
meminfo
animsetinfo live 1 refs 15 copies 1
posesnapshot animsets_ed_ver.pose game 1
posesnapshotequal animsets_ed_base.pose animsets_ed_ver.pose

# ---- B) EDITAR copia solo al editado; el animset y los demas no se enteran ----
# (cada 'animsetdope' asierta que SU armature paso a clips propios con UNA copia; los sellos del
#  comando siguiente, que el animset sigue intacto)
posesnapshot animsets_ed_p3a.pose game 1 only Personaje.003
animsetdope Personaje.003 1 move shared 0 copies 1
posesnapshot animsets_ed_p3b.pose game 1 only Personaje.003
fail posefotoigual animsets_ed_p3a.pose animsets_ed_p3b.pose
# Ctrl+Z devuelve las curvas (en sus clips ya propios: no hay otra copia)
animsetdope Personaje.003 1 undo shared 0 copies 0
posesnapshot animsets_ed_p3c.pose game 1 only Personaje.003
posesnapshotequal animsets_ed_p3a.pose animsets_ed_p3c.pose
animsetdope Personaje.004 1 scale shared 0 copies 1
# cancelar un transform: arrancarlo ya es editar (copia) pero la animacion queda como estaba
posesnapshot animsets_ed_p5a.pose game 1 only Personaje.005
animsetdope Personaje.005 1 cancel shared 0 copies 1
posesnapshot animsets_ed_p5b.pose game 1 only Personaje.005
posesnapshotequal animsets_ed_p5a.pose animsets_ed_p5b.pose
posesnapshot animsets_ed_p6a.pose game 1 only Personaje.006
animsetdope Personaje.006 1 delete shared 0 copies 1
posesnapshot animsets_ed_p6b.pose game 1 only Personaje.006
fail posefotoigual animsets_ed_p6a.pose animsets_ed_p6b.pose
animsetdope Personaje.007 1 duplicate shared 0 copies 1
animsetdope Personaje.008 1 interp shared 0 copies 1
animsetdope Personaje.009 1 handletype shared 0 copies 1
animsetdope Personaje.010 1 euler shared 0 copies 1
posesnapshot animsets_ed_p11a.pose game 1 only Personaje.011
animsetdope Personaje.011 1 kfvalue shared 0 copies 1
posesnapshot animsets_ed_p11b.pose game 1 only Personaje.011
fail posefotoigual animsets_ed_p11a.pose animsets_ed_p11b.pose
animsetdope Personaje.012 1 handle shared 0 copies 1
posesnapshot animsets_ed_p13a.pose game 1 only Personaje.013
animsetdope Personaje.013 1 insert shared 0 copies 1
posesnapshot animsets_ed_p13b.pose game 1 only Personaje.013
fail posefotoigual animsets_ed_p13a.pose animsets_ed_p13b.pose
# el End del clip: confirmado IGUAL no copia; cambiado, si
animsetdope Personaje 2 endequal shared 1 copies 0
animsetdope Personaje 2 end shared 0 copies 1
# los dos botones Rename del clip (el rename in-place guarda un PUNTERO al nombre: tiene que ser
# el de un clip ya propio, sino renombraba el clip de todos)
animsetdope Personaje.014 3 rename shared 0 copies 1
animsetclip Personaje.014 3 name Renombrado
animsetdope Personaje.015 3 renamearm shared 0 copies 1
animsetclip Personaje.015 3 name Renombrado
animsetclip Personaje.001 3 name Saltar
animsetstamps clips 5
# el detector de los sellos, probado: una escritura sin copiar SE VE
animsetstamps test Personaje.001
# quedan colgados Personaje.001 (el del "Quieto" propio, que igual esta en la biblioteca)
animsetinfo live 1 refs 1
animsetarm Personaje.001 shared 1
# y los que no se editaron reproducen EXACTAMENTE como al abrir
posesnapshot animsets_ed_otros_b.pose game 1 only Personaje.001 only Personaje.002
posesnapshotequal animsets_ed_otros_a.pose animsets_ed_otros_b.pose

# ---- C) REORDENAR los clips de un armature colgado no copia (su lista de punteros es suya) ----
animsetactive Personaje.001
anim down
animsetarm Personaje.001 shared 1 clips 4
animsetclip Personaje.001 1 name Quieto
animsetinfo copies 15
savew3d prueba_animsets_ed_rt.w3d
posesnapshot animsets_ed_rt_a.pose game 1
openw3d prueba_animsets_ed_rt.w3d
animsetclip Personaje.001 1 name Quieto
posesnapshot animsets_ed_rt_b.pose game 1
posesnapshotequal animsets_ed_rt_a.pose animsets_ed_rt_b.pose

# ---- C2) BORRAR un clip de un armature colgado tampoco copia: solo suelta el puntero (el clip
#          sigue en el animset para los demas) y el guardado escribe el subconjunto. Sin clips,
#          el armature suelta el recurso (ya no es usuario) ----
openw3d prueba_animsets_ed_v4.w3d
animsetinfo live 1 refs 15 copies 16
posesnapshot animsets_ed_del_a.pose game 1 sin Personaje.004
animsetactive Personaje.004
anim of
animsetarm Personaje.004 shared 1 clips 3
animsetclip Personaje.004 0 name Caminar same Personaje 1 1
animsetinfo live 1 refs 15 clips 5 copies 16
anim of
anim of
animsetarm Personaje.004 shared 1 clips 1
anim of
animsetarm Personaje.004 shared 0 clips 0
animsetinfo live 1 refs 14 clips 5 copies 16
animsetusers Personaje 15
posesnapshot animsets_ed_del_b.pose game 1 sin Personaje.004
posesnapshotequal animsets_ed_del_a.pose animsets_ed_del_b.pose
savew3d prueba_animsets_ed_del_rt.w3d
animsetsw3d prueba_animsets_ed_del_rt.w3d animsets 1 clips 6 armatures 15 registry 1
# el UNICO usuario se lleva los clips (sin copiar) y el borrado se libera: el recurso muere
animsetsynthetic 1 prueba_animsets_ed_del1_v4.w3d
openw3d prueba_animsets_ed_del1_v4.w3d
animsetinfo live 1 refs 1 clips 4
animsetactive Personaje
anim of
animsetarm Personaje shared 0 clips 3
animsetinfo live 0

# ---- D) los animsets como RECURSOS del proyecto ----
openw3d prueba_animsets_ed_v4.w3d
# usuarios: los 15 colgados + Personaje.002, que paso a clips propios pero vuelve a este animset
animsetusers Personaje 16
animsetpurge 0
animsetrenameset Personaje Enemigos Enemigos
animsetusers Enemigos 16
animsetusers Personaje 0
animsetarm Personaje animset Enemigos
animsetfolder Enemigos set Personajes/Malos
animsetfolder Enemigos es Personajes/Malos
# (el guardado suma el "Caminar.001" que la reparacion de nombres le dio al repetido de Personaje.002)
savew3d prueba_animsets_ed_rec_rt.w3d
animsetsw3d prueba_animsets_ed_rec_rt.w3d animsets 1 clips 6 armatures 16 registry 1
zipentry prueba_animsets_ed_rec_rt.w3d animations/enemigos.w3da
zipentry prueba_animsets_ed_rec_rt.w3d animations/personaje.w3da no
openw3d prueba_animsets_ed_rec_rt.w3d
animsetinfo live 1 refs 16 registry 1
animsetfolder Enemigos es Personajes/Malos
animsetarm Personaje.004 shared 1 animset Enemigos
posesnapshot animsets_ed_rec.pose game 1
posesnapshotequal animsets_ed_base.pose animsets_ed_rec.pose
# sin usuarios queda HUERFANO (se conserva al guardar) hasta que se purga
animsetdelete Personajes
animsetusers Enemigos 0
savew3d prueba_animsets_ed_huerf_rt.w3d
animsetsw3d prueba_animsets_ed_huerf_rt.w3d animsets 1 armatures 0 registry 1
animsetpurge 1
animsetinfo registry 0
savew3d prueba_animsets_ed_purga_rt.w3d
animsetsw3d prueba_animsets_ed_purga_rt.w3d animsets 0 armatures 0 registry 0
zipentry prueba_animsets_ed_purga_rt.w3d animations/enemigos.w3da no

# ---- E) renombrar a un nombre que ya usa OTRO animset del registro: queda unico (.NNN) ----
animsetsynthetic 3 prueba_animsets_ed_var_v4.w3d inverted
openw3d prueba_animsets_ed_var_v4.w3d
animsetinfo registry 2
animsetrenameset Invertido Personaje Personaje.001
animsetarm Invertido animset Personaje.001
animsetrenameset Personaje.001 Invertido Invertido
animsetrenameset Personaje " Personaje " Personaje
fail animsetrenombrarset NoExiste Algo

# ---- F) cerrar el proyecto ----
scenedefault
animsetinfo live 0 registry 0
animsetstamps clips 0
