# ==========================================================================
#  CLIPS DE JERARQUIA: los BORDES que encontro la revision de la fase 6.
#  Correr DESDE ESTA CARPETA:
#    ../../platform/linux/build/whisk3d --script prueba_clipsjer_bordes.w3s
#
#  Se prueba:
#    A) borrar (con undo) la RAIZ cuya vista del clip esta abierta no le saca la pista "." al
#       clip COMPARTIDO (la raiz detachada ya no escribe su vista): la copia que usa la misma
#       biblioteca la conserva, en memoria, al deshacer y en el .w3da guardado;
#    B) renombrar el clip que se edita con la raiz POSADA a mitad del clip (re-lee la vista) no
#       corre su pista ".": la pose sigue igual y el guardado escribe la raiz en su reposo;
#    C) guardar en el MIX con una raiz que solo anima una CAPA de clip de jerarquia (sin vista
#       abierta) escribe su transform de reposo, no la mezcla del cabezal;
#    D) el guardado que junta dos bibliotecas IGUALES en una pasa la vista que se edita al clip
#       que queda: lo que se keyea despues llega al clip (y al archivo);
#    E) una velocidad o un frame ENORMES (clip, capa) no cuelgan el tick: el cabezal queda adentro;
#    F) en "Juego" el rombo de Properties, Delete Keyframe y Clear Keyframe no tocan el ultimo
#       clip elegido (tampoco el clip de jerarquia compartido) y avisan; los rombos no muestran keys;
#    G) en la vista de un clip de jerarquia, el rombo sobre un objeto de FUERA avisa (como la I);
#    H) elegir en el desplegable "Clips" una biblioteca cuya entrada no se puede leer avisa (con
#       T()) y deja el objeto como estaba: el proyecto se sigue pudiendo guardar.
# ==========================================================================

window 1280 720

# ==== A) borrar la raiz con su vista abierta ====
scenedefault
add cube
objname Auto
add cube
objname Puerta
parent Puerta Auto
selobj Auto
clipmenu Hierarchy Clip
clipname abrir
animrange 1 11
animcurve Auto:abrir Puerta ry 1 0 11 90
animcurve Auto:abrir . y 1 0 11 2
duphierarchy copy Auto +hijos
hierinfo Auto.001 lib Auto tracks abrir 2
selobj Auto
delete
# (la vista de Auto quedo sin su raiz: el clip compartido sigue entero para Auto.001)
hierinfo Auto.001 lib Auto tracks abrir 2
undo
hierinfo Auto lib Auto tracks abrir 2
redo
hierinfo Auto.001 lib Auto tracks abrir 2
savew3d /tmp/w3d_f6_bordes/a.w3d
# (guardar con la raiz borrada no le cambia la animacion elegida: el Ctrl+Z la devuelve editandose)
undo
animlist active Auto:abrir
hierinfo Auto lib Auto tracks abrir 2
frame 6
objat Auto 0 1 0 0.001
openw3d /tmp/w3d_f6_bordes/a.w3d
hierinfo Auto.001 lib Auto tracks abrir 2

# ==== B) renombrar el clip que se edita con la raiz posada ====
scenedefault
add cube
objname Auto
selobj Auto
clipmenu Hierarchy Clip
clipname abrir
animrange 1 11
animcurve Auto:abrir . y 1 0 11 2
frame 6
objat Auto 0 1 0 0.001
recrename animations Auto/abrir cerrar Auto/cerrar
frame 1
frame 6
objat Auto 0 1 0 0.001
# (el Ctrl+Z / Ctrl+Y del renombre tambien re-leen la vista)
undo
frame 1
frame 6
objat Auto 0 1 0 0.001
redo
frame 1
frame 6
objat Auto 0 1 0 0.001
rootanim Scene
frame 1
savew3d /tmp/w3d_f6_bordes/b.w3d
openw3d /tmp/w3d_f6_bordes/b.w3d
objat Auto 0 0 0 0.001

# ==== C) guardar en el Mix: una raiz que solo tiene una capa ====
scenedefault
add cube
objname Auto
selobj Auto
clipmenu Hierarchy Clip
clipname Clip
animrange 1 11
animcurve Auto:Clip . y 1 0 11 2
rootanim Scene
add cube
objname Moto
selobj Moto
objpos 5 0 0
hierlib Moto Auto
clipmenu Mix
mixhier Auto Clip
hierlayer Moto 1 Clip
frame 11
objat Moto 5 2 0 0.001
savew3d /tmp/w3d_f6_bordes/c.w3d
# (el guardado no la movio: sigue mostrando la mezcla)
objat Moto 5 2 0 0.001
openw3d /tmp/w3d_f6_bordes/c.w3d
hiermix release
objat Moto 5 0 0 0.001
objat Auto 0 0 0 0.001
# ...y re-guardado y reabierto no acumula la pista de la raiz
hiermix frame 11
objat Moto 5 2 0 0.001
savew3d /tmp/w3d_f6_bordes/c2.w3d
openw3d /tmp/w3d_f6_bordes/c2.w3d
hiermix release
objat Moto 5 0 0 0.001

# ==== D) dos bibliotecas iguales se juntan al guardar: la vista que se edita sigue viva ====
scenedefault
add cube
objname A
add cube
objname B
selobj A
clipmenu Hierarchy Clip
rootanim Scene
selobj B
clipmenu Hierarchy Clip
animlist active B:Clip
savew3d /tmp/w3d_f6_bordes/d.w3d
hierinfo B lib A
animlist active B:Clip
selobj B
frame 1
rootkey
hierinfo B tracks Clip 1
savew3d /tmp/w3d_f6_bordes/d.w3d
openw3d /tmp/w3d_f6_bordes/d.w3d
hierinfo B lib A tracks Clip 1

# ==== E) velocidades y frames enormes: el tick no se cuelga ====
scenedefault
add cube
objname Auto
selobj Auto
clipmenu Hierarchy Clip
clipname abrir
animrange 1 11
animcurve Auto:abrir . y 1 0 11 2
rootanim Scene
hierplay Auto abrir loop 1
hiervel Auto 1000000000
hiertick 0.0166667 3
hiervel Auto -1000000000
hiertick 0.0166667 3
hiervel Auto 1e38
hiertick 0.0166667 2
hierreset
add cube
objname Moto
hierlib Moto Auto
hierlayer Moto 1 abrir vel 1000000000
hiermix tick 0.0166667 3
hierlayer Moto 1 abrir frame 1e30
hiermix tick 0.0166667 2
hierlayer Moto 1 -

# ==== F) "Juego": el rombo y Delete/Clear Keyframe no tocan el clip elegido ====
scenedefault
rootmenu 3d New Game
add cube
objname Auto
add cube
objname Puerta
parent Puerta Auto
selobj Auto
clipmenu Hierarchy Clip
animcurve Auto:Clip Puerta x 1 1 11 3
rootanim game
rootmode kind 2 game 1
selobj Auto
frame 1
notif clear
keydiamond 0 1 state 0
notif has A game has no keyframes: choose one of its clips in the timeline to animate
hierinfo Auto tracks Clip 1
selobj Puerta
keydiamond 0 0 state 0
menuobject 511
menuobject 512
hierinfo Auto tracks Clip 1
# (fuera de "Juego", en la vista del clip, el rombo si keyea: el clip gana la pista ".")
clipmenu Auto: Clip
selobj Auto
keydiamond 0 1 state 2
hierinfo Auto tracks Clip 2
savew3d /tmp/w3d_f6_bordes/f.w3d
hierinfo Auto tracks Clip 2

# ==== G) el rombo sobre un objeto de FUERA de la jerarquia avisa ====
scenedefault
add cube
objname Auto
add cube
objname Puerta
parent Puerta Auto
add cube
objname Suelto
selobj Auto
clipmenu Hierarchy Clip
selobj Suelto
notif clear
keydiamond 0 0 state 0
notif has This hierarchy clip only animates its root and its children
hierinfo Auto tracks Clip 0
selobj Puerta
notif clear
keydiamond 0 0 state 2
notif no This hierarchy clip only animates its root and its children
hierinfo Auto tracks Clip 1

# ==== H) una biblioteca rota en el desplegable "Clips" ====
scenedefault
add cube
objname Auto
add cube
objname Moto
selobj Auto
clipmenu Hierarchy Clip
animcurve Auto:Clip . y 1 0 11 2
rootanim Scene
savew3d /tmp/w3d_f6_bordes/h.w3d
# Auto la suelta: la biblioteca queda HUERFANA en el registro (se conserva tal cual)
hierlibmenu Auto (none)
savew3d /tmp/w3d_f6_bordes/h.w3d
animsetbreak /tmp/w3d_f6_bordes/h.w3d /tmp/w3d_f6_bordes/h_roto.w3d cut
openw3d /tmp/w3d_f6_bordes/h_roto.w3d
notif clear
hierlibmenu Moto Auto
notif has The clip library could not be read
hierinfo Moto lib -
# (sin paso de undo: no cambio nada)
savew3d /tmp/w3d_f6_bordes/h2.w3d

