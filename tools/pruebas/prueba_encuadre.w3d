// ==========================================================================
//  PRUEBA sintetica del ENCUADRE DECLARADO (formato texto). La corre
//  prueba_encuadre.w3s.
//
//  `aspecto:` es la palabra nueva de Camera: el aspecto de imagen (ancho/alto)
//  con el que la camara CINEMATOGRAFICA quiere dibujar (40:27 = 1.481481, el
//  encuadre tipico de un juego con listas de visibilidad horneadas por nodo).
//  En modo juego el viewport dibuja EXACTAMENTE ese frustum y rellena el resto
//  de la ventana con barras negras (letterbox/pillarbox).
//
//  Dos carteles a la misma profundidad: uno al CENTRO (adentro del encuadre) y
//  uno al COSTADO, puesto adonde una ventana ancha lo mostraria pero el
//  encuadre 40:27 NO: su pixel tiene que ser barra negra.
//
//  OJO: en el .w3d de TEXTO la vertical se llama `z` y la profundidad `y`.
// ==========================================================================
Whisk3D {
    version: 20251127
    Escena {
        background: "0.05, 0.05, 0.05, 1.0"

        Camera {
            name: "Camara"
            fov: 60.0
            near: 0.10
            far: 1000.0
            aspecto: 1.481481
        }

        // CENTRO (rojo): bien adentro del encuadre, se tiene que seguir viendo
        Wavefront { name: "Centro"  filePath: espejo-poste.obj  x: 0.0 y: -10.0 z: 0.0 scale: 2.0 }
        // COSTADO (amarillo): a 10 de profundidad el semiancho del encuadre
        // 40:27 con fov 60 es tan(30)*1.481*10 = 8.55. A x=9.5 queda AFUERA del
        // encuadre pero ADENTRO de una ventana 2:1 y pico (semiancho 11.5+).
        Wavefront { name: "Costado" filePath: espejo-poste2.obj x: 9.5 y: -10.0 z: 0.0 scale: 1.0 }
    }
}
