# prueba_prop_menu_material.w3s — las filas de los MAPAS del material (Rugosidad, Metalico, Alfa: un numero; Emision y
#   el color base: un color) en el menu contextual (restablecer / copiar / pegar, con Ctrl+Z) y con el DEDO: arrastrar de
#   costado el numero lo cambia (antes el toque se ejecutaba al soltar y el arrastre quedaba armado: no pasaba nada)
#   (una ventana alta: la tarjeta Material entera a la vista)
window 1200 1800
scale 2
selobj Cubo
propstab 2
tick
propclick New Material
tick
menupick New Material
tick
matshow roughness 0.5
proprightclick Roughness
menuopen si
menuitem Reset
menuitem Copy
menuitem Paste
fail menuitem Insert Keyframe
menupick Copy
matrt 0.2 0
tick
proprightclick Roughness
menupick Paste
matshow roughness 0.5
matrt 0.9 0
tick
proprightclick Roughness
menupick Reset
matshow roughness 0.5
undo
matshow roughness 0.9
proprightclick Emission
menuopen si
menupick Copy
proprightclick Emission
menupick Reset
matshow emission 0 0 0
# el DEDO: arrastrar de costado el numero de la rugosidad lo lleva hasta el tope (1)
wait 600
propfingerdrag 2000 Roughness
matshow roughness 1
undo
matshow roughness 0.9
