# ==========================================================================
#  LAS MALLAS 3D COMO RECURSO: los BORDES (lo que prueba_mallasrecurso.w3s no
#  miraba). Correr DESDE ESTA CARPETA:
#    cd <motor>/tools/pruebas
#    ../../platform/linux/build/whisk3d --script prueba_mallasrecurso_bordes.w3s
#
#  Cada seccion es un caso que perdia datos, dejaba memoria colgando o no se
#  podia deshacer:
#   A) EXPORTAR a .obj mallas con la edicion PENDIENTE en su recurso (salian sin caras).
#   B) una HUERFANA sin cargar conserva el material que solo ella usa, y un rename del
#      material le llega a su PART.
#   C) dos mallas que INTERCAMBIAN nombres (entradas) al guardar: cada recurso queda con SU
#      descriptor en el almacen (antes quedaba uno ajeno y el vinculo recargaba encima).
#   D) mas de 32767 usuarios de una malla: purgar las transitorias no la libera.
#   E) guardar despues de ABRIR otro proyecto estando en Edit Mode (puntero colgando).
#   F) publicar desde un objeto no borra lo que OTRO objeto del recurso tenia sin publicar.
#   G) editar la topologia desde un objeto no mata las vertex anims de los demas.
#   H) vincular mientras la carga ASYNC de la malla esta EN_VUELO (no falla ni pierde refs).
#   I) una huerfana cuya entrada falta en el contenedor no impide guardar.
#   J) dos usuarios con el MISMO cambio terminan en UN recurso (no en dos identicos).
#   K) seleccionar no deja la edicion de todo en memoria (solo la ACTIVA, y se suelta).
#   L) Shift+D, o dos primitivas iguales, NO quedan vinculadas al guardar (cada una nace con SU malla 3D).
#   M) Ctrl+Z / Ctrl+Y de Apply Transform y de Join sobre una malla COMPARTIDA.
#   N) TODA malla nace con su malla 3D (con nombre): New Copy (la tarjeta), Rename y Folder (la
#      biblioteca), con undo (y la carpeta de verdad: vacio, espacios, normalizacion).
#   O) el ORDEN del registro "mallas" no depende de que la activa tenga su edicion en memoria
#      (abrir y guardar sin tocar nada daba otro proyecto.json).
#  Escribe en tools/debug.
# ==========================================================================
window 1280 720
formatmeshes binary

# --- A) EXPORT OBJ con la edicion pendiente ------------------------------------------
scenesynthetic 3 ../debug/mrb_exp.w3d
openw3d ../debug/mrb_exp.w3d
meshcheck Arbol edit pending users 3
export ../debug/mrb_exp.obj 0 0
# 3 esferas de 32x16 = 3 x 512 caras (antes: 0 caras, solo los vertices)
objfaces ../debug/mrb_exp.obj 1536
export ../debug/mrb_exp_mod.obj 1 1
objfaces ../debug/mrb_exp_mod.obj 1536
# el export devuelve la edicion prestada (no deja las caras de todas en memoria)
meshcheck Arbol edit pending
meshcheck Arbol.002 edit pending

# --- B) una HUERFANA sin cargar conserva su material ---------------------------------
scenesynthetic 3 ../debug/mrb_o1.w3d
openw3d ../debug/mrb_o1.w3d
meshunique Arbol.001
meshmaterial Arbol.001 0 MatSolo
savew3d ../debug/mrb_o2.w3d
openw3d ../debug/mrb_o2.w3d
meshassign Arbol.001 Arbol
savew3d ../debug/mrb_o3.w3d
# o3: Arbol.001 es huerfana y es la UNICA que usa MatSolo
openw3d ../debug/mrb_o3.w3d
meshesregistry n 2 has Arbol.001 loaded 1
savew3d ../debug/mrb_o4.w3d
openw3d ../debug/mrb_o4.w3d
meshassign Arbol.002 Arbol.001
meshcheck Arbol.002 resource Arbol.001 material 0 MatSolo
# un rename del material en una sesion donde la huerfana NO se cargo le llega a su PART
openw3d ../debug/mrb_o3.w3d
matrename MatSolo MatSola
savew3d ../debug/mrb_o5.w3d
openw3d ../debug/mrb_o5.w3d
meshassign Arbol.002 Arbol.001
meshcheck Arbol.002 material 0 MatSola

# --- C) dos mallas que intercambian nombres (y entradas) al guardar ------------------
scenesynthetic 2 ../debug/mrb_r1.w3d
openw3d ../debug/mrb_r1.w3d
meshunique Arbol.001
savew3d ../debug/mrb_r2.w3d
openw3d ../debug/mrb_r2.w3d
meshrender
meshrename Arbol.001 Pino
meshrename Arbol Arbol.001
savew3d ../debug/mrb_r3.w3d
# cada recurso quedo con SU descriptor (la clave vieja no quedo huerfana en el almacen)
recinfo mesh meshes/arbol.001.w3db state LISTO
recinfo mesh meshes/pino.w3db state LISTO
recinfo mesh meshes/arbol.w3db state NADA
meshvert Arbol 0 save r0
meshdup Arbol linked
meshcheck @ultimo resource Arbol.001 users 2 shares Arbol
meshvert Arbol 0 delta r0 0 0 0
openw3d ../debug/mrb_r3.w3d
meshesregistry n 2 has Pino has Arbol.001 hasnot Arbol
meshcheck Arbol resource Arbol.001
meshcheck Arbol.001 resource Pino

# --- D) mas de 32767 usuarios: purgar las transitorias no libera la malla -------------
scenesynthetic 3 ../debug/mrb_k1.w3d
openw3d ../debug/mrb_k1.w3d
recinfo mesh meshes/arbol.w3db refs 3
# 32767 objetos mas que la usan (referencias permanentes, sin armar los objetos)
meshrefs meshes/arbol.w3db 32767
recinfo mesh meshes/arbol.w3db refs 32770
meshacquire meshes/arbol.w3db bloqueante
recinfo mesh meshes/arbol.w3db trefs 1
purge
recinfo mesh meshes/arbol.w3db state LISTO
recinfo mesh meshes/arbol.w3db refs 32770
meshrefs meshes/arbol.w3db -32767
recinfo mesh meshes/arbol.w3db refs 3
meshcheck Arbol users 3 vbo shared

# --- E) guardar tras abrir otro proyecto estando en Edit Mode -------------------------
scenesynthetic 2 ../debug/mrb_g1.w3d
scenesynthetic 1 ../debug/mrb_g2.w3d
openw3d ../debug/mrb_g1.w3d
selobj Arbol
mode edit
openw3d ../debug/mrb_g2.w3d
selobj Arbol
vgnew G
savew3d ../debug/mrb_g3.w3d
openw3d ../debug/mrb_g3.w3d
meshcheck Arbol groups 1

# --- F) publicar desde un objeto no borra lo que OTRO tenia sin publicar --------------
scenesynthetic 2 ../debug/mrb_v1.w3d
openw3d ../debug/mrb_v1.w3d
selobj Arbol.001
vgnew Hueso
meshrender
meshcheck Arbol.001 groups 1
selobj Arbol
mode edit
select all
move 0.5
mode object
# el grupo de Arbol.001 se publico al dejar de ser la activa: lo ven los dos y el move tambien
meshcheck Arbol.001 groups 1 resource Arbol users 2
meshcheck Arbol groups 1 shares Arbol.001

# --- G) cambiar la topologia desde un objeto no mata las vertex anims de otro ----------
scenesynthetic 4 ../debug/mrb_va1.w3d
openw3d ../debug/mrb_va1.w3d
meshva Arbol.003 10
meshvert Arbol.003 0 save va10
selobj Arbol.001
mode edit
select all
duplicate
mode object
# Arbol.003 (animada) se aparto a una copia con la malla ANTERIOR y sigue en su pose
meshcheck Arbol.003 resource Arbol.001 users 1 faces 512
meshvert Arbol.003 0 delta va10 0 0 0
# los demas ven la edicion (el doble de caras)
meshcheck Arbol resource Arbol users 3 faces 1024 shares Arbol.002

# --- H) vincular mientras la carga ASYNC esta EN_VUELO -------------------------------
openw3d ../debug/mrb_o3.w3d
meshacquire meshes/arbol.001.w3db async
recinfo mesh meshes/arbol.001.w3db state EN_VUELO
meshassign Arbol.002 Arbol.001
meshcheck Arbol.002 resource Arbol.001 users 1
recinfo mesh meshes/arbol.001.w3db refs 2
pump 1
purge
recinfo mesh meshes/arbol.001.w3db refs 1
undo
meshcheck Arbol.002 resource Arbol users 3
# sin usuarios ni transitorias: la malla se descargo (no quedo una referencia perdida)
recinfo mesh meshes/arbol.001.w3db state NADA

# --- I) una huerfana cuya entrada falta no impide guardar ----------------------------
w3dnoentry ../debug/mrb_o3.w3d ../debug/mrb_o3sin.w3d meshes/arbol.001.w3db
openw3d ../debug/mrb_o3sin.w3d
meshesregistry n 2 has Arbol.001
savew3d ../debug/mrb_o3sin2.w3d
openw3d ../debug/mrb_o3sin2.w3d
meshesregistry n 1 hasnot Arbol.001
meshcheck Arbol users 3

# --- J) dos usuarios con el MISMO cambio: un solo recurso -----------------------------
scenesynthetic 2 ../debug/mrb_d1.w3d
openw3d ../debug/mrb_d1.w3d
selobj Arbol
vgnew G
selobj Arbol.001
vgnew G
meshrender
savew3d ../debug/mrb_d2.w3d
openw3d ../debug/mrb_d2.w3d
meshesregistry n 1
meshcheck Arbol groups 1 shares Arbol.001

# --- K) seleccionar no deja la edicion de todo en memoria ----------------------------
scenesynthetic 200 ../debug/mrb_sel.w3d
openw3d ../debug/mrb_sel.w3d
selectall
activename Arbol.100
meshrender
# solo la ACTIVA tiene su edicion en memoria (las demas se miran con la topologia del recurso)
meshcheck Arbol.100 edit loaded
meshcheck Arbol.050 edit pending
meshcheck Arbol.199 edit pending
selobj Arbol.050
meshrender
# la que dejo de ser la activa suelta su edicion
meshcheck Arbol.100 edit pending
meshcheck Arbol.050 edit loaded
deselectall
meshrender
# guardar sin cambios sigue copiando la entrada tal cual (proyecto.json cambia: la sesion
# recuerda el objeto activo)
savew3d ../debug/mrb_sel2.w3d
w3dequal ../debug/mrb_sel.w3d ../debug/mrb_sel2.w3d meshes/

# --- L) Shift+D y dos primitivas iguales NO se vinculan al guardar (cada una nace con su malla 3D) --
# (cada caso arranca ABRIENDO la escena base: abrir rearma el layout. Un ReiniciarEscena del
# harness sin abrir deja el panel de Properties atado a mallas liberadas hasta el proximo dibujo)
scenesynthetic 1 ../debug/mrb_base.w3d
openw3d ../debug/mrb_base.w3d
add cube
meshcheck Cubo resource Cubo users 1
meshdup Cubo copy
meshcheck @ultimo resource Cubo.001 users 1
add cube
meshcheck Cubo.002 resource Cubo.002 users 1
savew3d ../debug/mrb_l1.w3d
meshesregistry n 4
meshcheck Cubo users 1 noshare Cubo.001 noshare Cubo.002
meshvert Cubo.001 0 save l0
selobj Cubo
mode edit
select all
move 0.5
mode object
meshvert Cubo.001 0 delta l0 0 0 0
openw3d ../debug/mrb_l1.w3d
meshesregistry n 4
meshcheck Cubo users 1 noshare Cubo.001 noshare Cubo.002
# (y un archivo VIEJO sigue juntando sus sueltas iguales: prueba_mallasrecurso.w3s, seccion G)

# --- M) Ctrl+Z / Ctrl+Y de Apply Transform y Join sobre una malla COMPARTIDA ----------
openw3d ../debug/mrb_base.w3d
add cube
meshvert Cubo 0 save c0
meshdup Cubo linked
selobj Cubo
objscale 2 1 1
apply scale
meshcheck Cubo resource Cubo.001 users 1
meshvert Cubo 0 delta c0 -1 0 0
meshvert @ultimo 0 delta c0 0 0 0
undo
meshcheck Cubo resource Cubo users 2
meshvert Cubo 0 delta c0 0 0 0
redo
meshrender
meshcheck Cubo resource Cubo.001 users 1
meshvert Cubo 0 delta c0 -1 0 0
meshvert @ultimo 0 delta c0 0 0 0
undo
redo
meshvert Cubo 0 delta c0 -1 0 0
# JOIN
openw3d ../debug/mrb_base.w3d
add cube
meshdup Cubo linked
add cube
selobj Cubo.002
selname Cubo
activename Cubo
join
meshcheck Cubo faces 12 users 1
meshcheck Cubo.001 faces 6
undo
meshcheck Cubo faces 6 users 2 shares Cubo.001
meshcheck Cubo.002 faces 6
redo
meshrender
meshcheck Cubo faces 12 users 1
meshcheck Cubo.001 faces 6
fail mallainfo Cubo.002

# --- N) TODA malla nace con su malla 3D: New Copy, Rename y Folder, con undo --------------
openw3d ../debug/mrb_base.w3d
add cube
meshrender
meshcheck Cubo resource Cubo users 1
meshmaterial Cubo 0 MatX
meshnew Cubo
meshcheck Cubo resource Cubo.001
undo
# el Ctrl+Z deshace el New Copy (vuelve a su malla 3D de antes), no el cambio de material
meshcheck Cubo resource Cubo material 0 MatX
redo
meshcheck Cubo resource Cubo.001 material 0 MatX
# el RENAME (la biblioteca: el mismo paso que el renombrar en linea del outliner)
meshrename Cubo Caja
meshcheck Cubo resource Caja
undo
meshcheck Cubo resource Cubo.001
redo
meshcheck Cubo resource Caja
# el nombre ya tomado se uniquifica (con el aviso de siempre)
add cube
meshrename Cubo.001 Caja
meshcheck Cubo.001 resource Caja.001
# la CARPETA (la biblioteca): se normaliza, vacio y solo espacios = sin carpeta
meshfolder Cubo.001 Rocas//Grandes/
meshcheck Cubo.001 folder Rocas/Grandes
meshfolder Cubo.001 __
meshcheck Cubo.001 folder -
undo
meshcheck Cubo.001 folder Rocas/Grandes
meshfolder Cubo.001 -
meshcheck Cubo.001 folder -

# --- O) el orden del registro no depende de la edicion materializada de la activa ------
# Arbol (el PRIMER usuario de su malla) activa y con su edicion en memoria al guardar; al
# reabrir se guarda sin dibujar (edicion pendiente): el registro sale en el mismo orden
scenesynthetic 3 ../debug/mrb_ord.w3d
openw3d ../debug/mrb_ord.w3d
meshunique Arbol.001
selobj Arbol
meshrender
meshcheck Arbol edit loaded
savew3d ../debug/mrb_ord1.w3d
openw3d ../debug/mrb_ord1.w3d
meshcheck Arbol edit pending
savew3d ../debug/mrb_ord2.w3d
w3dequal ../debug/mrb_ord1.w3d ../debug/mrb_ord2.w3d
formatmeshes project
