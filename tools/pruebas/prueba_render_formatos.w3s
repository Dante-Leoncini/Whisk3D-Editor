# ==========================================================================
#  EL FORMATO DEL RENDER A ARCHIVO (tarjeta Render)
#  PNG y JPG: una imagen por pase y por cuadro. MKV y MP4: Render Animation hace un video por pase con el ffmpeg de la
#  maquina (sin ffmpeg, los controles de los videos se saltean). La COMPOSICION FINAL se puede no guardar; con ella, con
#  ALFA (PNG RGBA: el alfa sale del pase de alfa) y con el POSTPROCESADO.
# ==========================================================================
scenedefault
routineset Constructor 0 n 1 0 1 1
frame 1
# ---- JPG ----
deletefile /tmp/w3d_fmt_0001.jpg
deletefile /tmp/w3d_fmt_0001.png
renderformat jpg 95
renderimage /tmp w3d_fmt.png
exists /tmp/w3d_fmt_0001.jpg
exists /tmp/w3d_fmt_0001.png no
pngpx /tmp/w3d_fmt_0001.jpg 4 4 255 0 255 - 6
# ---- PNG con ALFA: el fondo transparente, el cubo opaco ----
deletefile /tmp/w3d_fmt_0001.png
renderformat png
renderfinal 1 1 1
renderimage /tmp w3d_fmt.png
pngpx /tmp/w3d_fmt_0001.png 2 2 255 0 255 0
pngpx /tmp/w3d_fmt_0001.png 640 360 0 0 0 255 255
# ---- SIN la composicion final: solo los pases tildados ----
deletefile /tmp/w3d_fmt_0001.png
deletefile /tmp/w3d_fmt_alpha_0001.png
renderfinal 0 0 1
renderpasses 0 0 1
renderimage /tmp w3d_fmt.png
exists /tmp/w3d_fmt_0001.png no
exists /tmp/w3d_fmt_alpha_0001.png
pngpx /tmp/w3d_fmt_alpha_0001.png 2 2 0 0 0
renderpasses 0 0 0
renderfinal 1 0 1
# ---- VIDEOS: Ctrl+F12 = Render Animation. UN video, la composicion final: sin pases (aunque esten tildados) y aunque
#      la composicion final este destildada (los pases son de las secuencias de imagenes) ----
deletefile /tmp/w3d_fmt.mp4
deletefile /tmp/w3d_fmt_alpha.mp4
deletefile /tmp/w3d_fmt_alpha_0001.png
deletefile /tmp/w3d_fmt.mkv
renderrange 1 3
renderformat mp4 80
renderpasses 1 1 1
renderfinal 0 0 1
keyreal 3d Ctrl+F12
videoframes /tmp/w3d_fmt.mp4 3 1280 720
exists /tmp/w3d_fmt_alpha.mp4 no
exists /tmp/w3d_fmt_alpha_0001.png no
renderpasses 0 0 0
renderfinal 1 0 1
renderformat mkv 100
keyreal 3d Ctrl+F12
videoframes /tmp/w3d_fmt.mkv 3 1280 720
# (Render Image con un formato de video: la imagen en PNG)
deletefile /tmp/w3d_fmt_0001.png
frame 1
keyreal 3d F12
exists /tmp/w3d_fmt_0001.png
renderrange 0 0
renderformat png
# ---- SIN PANEL DE PROPIEDADES NI VISTA 3D en la pantalla: F12 renderiza igual (las opciones son del programa) ----
renderformat png
vptype 3 4
vptype 1 3
deletefile /tmp/w3d_fmt_0002.png
frame 2
keyreal uv F12
exists /tmp/w3d_fmt_0002.png
pngpx /tmp/w3d_fmt_0002.png 2 2 255 0 255
