# ==========================================================================
#  LIBRERIAS EXTERNAS: la ACEPTACION de la fase con un PERSONAJE (io/Librerias.h, objects/ProxyW3d.h)
#  Correr DESDE ESTA CARPETA:
#    ../../platform/linux/build/whisk3d --script prueba_librerias_personaje.w3s
#
#  La libreria "personajes" (libcrear ... prefab Personaje) trae el prefab "Personaje": un Esqueleto con dos
#  clips (su animset), un Cuerpo skinneado con el material "Piel" CON TEXTURA, un Sensor (hitbox) y enemigo.lua
#  (cada personaje cuenta en compartido() y mira SU cuerpo por scope). La libreria "otros" tiene las MISMAS
#  entradas y los mismos nombres adentro (otra textura).
#    A) un nivel con 20 proxies del Personaje: UNA malla, UN animset, UN material, UNA textura y UN script, todos
#       de la libreria con su prefijo (nada en la biblioteca del proyecto); 20 hitbox (uno por proxy); en el Play
#       cada proxy corre SU script (su scope, su override de vida) y sus hitbox entran al motor;
#    B) guardar el nivel no ingiere NADA de la libreria (ni sus entradas ni sus nombres); abrirlo lo regenera igual
#       y re-guardar da los mismos bytes;
#    C) la libreria CAMBIA en disco (el Personaje gana un "Casco" y su Piel otro color): reabrir el nivel lo
#       muestra en los 20 (y el nivel guardado sigue dando los mismos bytes); si FALTA, los proxies abren vacios
#       sin perder nada al guardar, y vuelven cuando vuelve;
#    D) dos librerias con entradas y nombres iguales no chocan (cada proxy usa lo de SU libreria);
#    E) instanciar("personajes/Personaje") en el Play del editor y en un JUEGO COMPILADO de prueba (la libreria
#       viaja empaquetada en librerias/personajes/ y el runtime la lee igual).
#  Compila un juego de verdad (cmake + g++), asi que tarda mas que las demas.
# ==========================================================================

window 1280 720
libcreate /tmp/w3d_f8_pj/lib personajes.w3d dosmats.png prefab Personaje
libcreate /tmp/w3d_f8_pj/otra otros.w3d dosmats-b.png prefab Personaje
# (todo lo del Personaje vive ADENTRO del .w3d de la libreria)
entryexists /tmp/w3d_f8_pj/lib/personajes.w3d prefabs/personaje.w3dp 1
entryexists /tmp/w3d_f8_pj/lib/personajes.w3d meshes/cuerpo.w3db 1
entryexists /tmp/w3d_f8_pj/lib/personajes.w3d animations/esqueleto.w3da 1
entryexists /tmp/w3d_f8_pj/lib/personajes.w3d textures/piel.png 1
entryexists /tmp/w3d_f8_pj/lib/personajes.w3d scripts/enemigo.lua 1
entryhas /tmp/w3d_f8_pj/lib/personajes.w3d prefabs/personaje.w3dp "hitbox" 1
entryhas /tmp/w3d_f8_pj/lib/personajes.w3d project.json "Piel" 1

# --- A) 20 proxies del Personaje: comparten todo, cada uno con su estado ---
scenedefault
liblink /tmp/w3d_f8_pj/lib/personajes.w3d
libinfo personajes linked 1 prefabs 3
libproxy personajes prefab Personaje 0 0 -6 times 20
prefablive 20
libproxyinfo Personaje lib personajes element Personaje type prefab generated 4 empty 0
prefabnode Personaje.007 . name Personaje generated 1
prefabnode Personaje.007 Esqueleto type armature generated 1
prefabnode Personaje.007 Esqueleto/Cuerpo type mesh generated 1
prefabnode Personaje.007 Esqueleto/Sensor type hitbox generated 1
libshared personajes prefab Personaje proxies 20 meshes 1 animsets 1 materials 1 textures 1 scripts 1 hitboxes 20
libresource mesh personajes/Cuerpo exists 1 lib personajes library 0
libresource material personajes/Piel exists 1 lib personajes library 0 color 0.9 0.7 0.6
libresource animset personajes/Esqueleto exists 1 lib personajes library 0
libresource texture lib:personajes/textures/piel.png exists 1 lib personajes library 0
# (la pose y el scope son de CADA proxy)
prefabskin Personaje.012
prefabscope Personaje.003 Esqueleto Cuerpo Personaje.003
prefabclip Personaje.001 Esqueleto Quieto
prefabclip Personaje.002 Esqueleto Saludo
prefabpose Personaje.001 Personaje.002 10 distinct
# (un override de su script en UNO: como en una instancia de prefab)
prefaboverride Personaje.004 prop Esqueleto vida 25
# (el Play: 20 scripts, uno por proxy, cada uno con su scope y su vida; 20 hitbox en el motor)
simplay 3
scriptinfo shared enemigos 20
scriptinfo shared scope_ok 20
scriptinfo shared vida_total 215
hitboxstats hitboxes 20
simstop
prefablive 20

# --- B) guardar el nivel: NADA de la libreria entra; abrir lo regenera igual ---
savew3d /tmp/w3d_f8_pj/nivel/nivel.w3d
entryhas /tmp/w3d_f8_pj/nivel/nivel.w3d project.json "proxy", 1
entryhas /tmp/w3d_f8_pj/nivel/nivel.w3d project.json ext:../lib/personajes.w3d 1
entryhas /tmp/w3d_f8_pj/nivel/nivel.w3d project.json "vida": 1
entryhas /tmp/w3d_f8_pj/nivel/nivel.w3d project.json Esqueleto 0
entryhas /tmp/w3d_f8_pj/nivel/nivel.w3d project.json Sensor 0
entryhas /tmp/w3d_f8_pj/nivel/nivel.w3d project.json Piel 0
entryhas /tmp/w3d_f8_pj/nivel/nivel.w3d project.json enemigo.lua 0
entryhas /tmp/w3d_f8_pj/nivel/nivel.w3d project.json personajes/Cuerpo 0
entryexists /tmp/w3d_f8_pj/nivel/nivel.w3d prefabs/personaje.w3dp 0
entryexists /tmp/w3d_f8_pj/nivel/nivel.w3d meshes/cuerpo.w3db 0
entryexists /tmp/w3d_f8_pj/nivel/nivel.w3d animations/esqueleto.w3da 0
entryexists /tmp/w3d_f8_pj/nivel/nivel.w3d textures/piel.png 0
entryexists /tmp/w3d_f8_pj/nivel/nivel.w3d scripts/enemigo.lua 0
openw3d /tmp/w3d_f8_pj/nivel/nivel.w3d
libinfo personajes linked 1
prefablive 20
libshared personajes prefab Personaje proxies 20 meshes 1 animsets 1 materials 1 textures 1 scripts 1 hitboxes 20
prefabinfo Personaje.004 overrides 1
savew3d /tmp/w3d_f8_pj/nivel/nivel2.w3d
openw3d /tmp/w3d_f8_pj/nivel/nivel2.w3d
savew3d /tmp/w3d_f8_pj/nivel/nivel3.w3d
w3dequal /tmp/w3d_f8_pj/nivel/nivel2.w3d /tmp/w3d_f8_pj/nivel/nivel3.w3d

# --- C) la LIBRERIA cambia en disco: reabrir el nivel lo muestra ---
openw3d /tmp/w3d_f8_pj/lib/personajes.w3d
rootopen Personaje prefab
add cube
objname Casco
parent Casco Esqueleto
selobj Cuerpo
matcolor 0.2 0.8 0.3
rootopen Scene
savew3d /tmp/w3d_f8_pj/lib/personajes.w3d
openw3d /tmp/w3d_f8_pj/nivel/nivel.w3d
prefablive 20
libproxyinfo Personaje.015 generated 5
prefabnode Personaje.015 Esqueleto/Casco type mesh generated 1
libshared personajes prefab Personaje proxies 20 meshes 2 animsets 1 materials 2 textures 1 scripts 1 hitboxes 20
libresource material personajes/Piel exists 1 lib personajes library 0 color 0.2 0.8 0.3
# (el nivel sigue sin tener nada de la libreria: guardado ahora da los MISMOS bytes que antes del cambio)
savew3d /tmp/w3d_f8_pj/nivel/nivel4.w3d
entryhas /tmp/w3d_f8_pj/nivel/nivel4.w3d project.json Casco 0
entryhas /tmp/w3d_f8_pj/nivel/nivel4.w3d project.json personajes/Cubo 0
w3dequal /tmp/w3d_f8_pj/nivel/nivel3.w3d /tmp/w3d_f8_pj/nivel/nivel4.w3d
# (la libreria FALTA en disco: sus proxies abren VACIOS, el Play anda y guardar no pierde nada; cuando vuelve, vuelven)
libmove /tmp/w3d_f8_pj/lib/personajes.w3d /tmp/w3d_f8_pj/lib/personajes.aparte
openw3d /tmp/w3d_f8_pj/nivel/nivel.w3d
prefablive 20
libproxyinfo Personaje lib personajes element Personaje generated 0 empty 1
libinfo personajes linked 1
simplay 3
simstop
savew3d /tmp/w3d_f8_pj/nivel/nivel5.w3d
w3dequal /tmp/w3d_f8_pj/nivel/nivel4.w3d /tmp/w3d_f8_pj/nivel/nivel5.w3d
libmove /tmp/w3d_f8_pj/lib/personajes.aparte /tmp/w3d_f8_pj/lib/personajes.w3d
openw3d /tmp/w3d_f8_pj/nivel/nivel5.w3d
libproxyinfo Personaje.015 generated 5 empty 0
prefabinfo Personaje.004 overrides 1

# --- D) DOS librerias con las mismas entradas y los mismos nombres adentro: no chocan ---
scenedefault
liblink /tmp/w3d_f8_pj/lib/personajes.w3d
liblink /tmp/w3d_f8_pj/otra/otros.w3d
libinfo otros linked 1 prefabs 3 count 2
libproxy personajes prefab Personaje 0 0 0
libproxy otros prefab Personaje 4 0 0
libdistinct Personaje Personaje.001
libshared personajes prefab Personaje proxies 1 meshes 2 animsets 1 materials 2 textures 1 scripts 1
libshared otros prefab Personaje proxies 1 meshes 1 animsets 1 materials 1 textures 1 scripts 1
libresource material personajes/Piel exists 1 lib personajes library 0
libresource material otros/Piel exists 1 lib otros library 0
libresource mesh otros/Cuerpo exists 1 lib otros library 0
libresource texture lib:otros/textures/piel.png exists 1 lib otros library 0

# --- E) instanciar("personajes/Personaje") en el Play y en el juego compilado ---
libgamemin /tmp/w3d_f8_pj/juego /tmp/w3d_f8_pj/lib/personajes.w3d prefab Personaje
savew3d /tmp/w3d_f8_pj/juego/libpersonaje.w3d
entryexists /tmp/w3d_f8_pj/juego/libpersonaje.w3d scripts/enemigo.lua 0
entryexists /tmp/w3d_f8_pj/juego/libpersonaje.w3d prefabs/personaje.w3dp 0
openw3d /tmp/w3d_f8_pj/juego/libpersonaje.w3d
prefablive 3
libshared personajes prefab Personaje proxies 3 meshes 2 animsets 1 materials 2 textures 1 scripts 1 hitboxes 3
simplay 30
scriptinfo shared juez OK
scriptinfo shared enemigos 8
scriptinfo shared scope_ok 8
scriptinfo shared vida_total 95
prefablive 8
libshared personajes prefab Personaje proxies 8 meshes 2 animsets 1 materials 2 textures 1 scripts 1 hitboxes 8
simstop
prefablive 3
compilegame 0 1 1
libgamelog /tmp/w3d_f8_pj/juego libpersonaje creados=5 enemigos=8 scope=8 vida=95
