# ==========================================================================
#  PREFABS: los casos de borde de la revision de la fase (io/Prefabs.h, io/PrefabsEditor.h,
#  script/SimJuego.cpp, objects/ObjectMode.cpp).
#  Correr DESDE ESTA CARPETA:
#    ../../platform/linux/build/whisk3d --script prueba_prefabs_revision.w3s
#  (los casos de memoria -A y G- se miran con el build ASan: aca pasan igual, pero sin el arreglo
#   el ASan corta con heap-use-after-free)
#
#    A) regenerar una instancia (cambiarle el prefab, Reset Overrides) con pasos en el historial que
#       nombran lo generado (elegirlo, ocultarlo con H): el Ctrl+Z vuelve a colgar la generacion vieja
#    B) con el Play andando: cambiar el prefab / Reset estan bloqueados; guardar escribe la estructura del
#       usuario (lo destruido por un script si, lo instanciado no); destruir() de algo PUESTO en la escena
#       deja su objeto("ref") en nil (como el juego compilado)
#    C) renombrar un objeto de la escena no reescribe la ref de un script generado que apunta a SU
#       propio homonimo (los nombres son por scope)
#    D) instanciar() desde un inicio() (un spawner): lo creado es de la partida y el Stop lo borra
#    E) un script agregado a mano a un objeto generado no se vuelve override (ni corre los valores)
#    F) prefabs ANIDADOS: lo que se cambia en lo generado por la anidada se guarda como override de la
#       de afuera; renombrar el anidado no deja rancia la definicion del que lo contiene
#    G) el RIEL de una camara en una curva de una instancia destruida jugando: el Stop no la devuelve
#    H) Unpack: las refs internas siguen a su objeto renumerado (no al homonimo de afuera)
#    I) instanciar(): los cuerpos rigidos existen en su inicio() (fisicaVel llega)
#    J) el "_origen" de un nodo en seco se lee exacto (mas alla de 2^24)
#    K) los overrides sin sincronizar sobreviven a regenerar (volver de editar) y a Shift+D
#    L) editando un prefab, Add va adentro de su objeto raiz; Join, G y los keyframes no tocan lo
#       generado
#    M) borrar un prefab que solo usa una escena SIN CARGAR; "Select Users" y "borrar igual"
# ==========================================================================

window 1280 720

# --- A) regenerar con el historial nombrando lo generado ---
prefabenemy /tmp/w3d_f7_rev/a physics 1
prefabinstantiate Enemigo 0 0 -6 name Enemigo
prefabh Enemigo Esqueleto/Sensor
prefabnode Enemigo Esqueleto/Sensor visible 0
# (lo generado no se mueve: G no arranca y no deja paso)
prefabsel Enemigo Esqueleto/Cuerpo
fail objmove 1 0 0
notif has It belongs to a prefab instance: edit the prefab or unpack the instance
prefabsel Enemigo
prefabchange Enemigo Caja
prefabinfo Enemigo prefab Caja generated 1 root Caja
undo
prefabinfo Enemigo prefab Enemigo generated 4 overrides 1
prefabnode Enemigo Esqueleto/Sensor visible 0
undo
prefabnode Enemigo Esqueleto/Sensor visible 1
undo
redo
redo
prefabnode Enemigo Esqueleto/Sensor visible 0
redo
prefabinfo Enemigo prefab Caja generated 1
undo
undo
undo
prefabinfo Enemigo prefab Enemigo generated 4 overrides 0
# Reset Overrides con el historial nombrando lo generado
prefabh Enemigo Esqueleto/Cuerpo
prefabinfo Enemigo overrides 1
prefabsel Enemigo
prefabreset Enemigo
prefabinfo Enemigo overrides 0
prefabnode Enemigo Esqueleto/Cuerpo visible 1
undo
prefabinfo Enemigo overrides 1
prefabnode Enemigo Esqueleto/Cuerpo visible 0
undo
undo
prefabnode Enemigo Esqueleto/Cuerpo visible 1
redo
redo
redo
prefabinfo Enemigo overrides 0
prefabnode Enemigo Esqueleto/Cuerpo visible 1

# --- B) con el Play andando ---
prefabenemy /tmp/w3d_f7_rev/b physics 1
prefabinstantiate Enemigo -4 0 -6 name Enemigo
prefabinstantiate Enemigo 0 0 -6 name Enemigo.001
prefaboverride Enemigo.001 visible Esqueleto/Sensor 0
savew3d /tmp/w3d_f7_rev/b/b.w3d
openw3d /tmp/w3d_f7_rev/b/b.w3d
rootscript Cubo prueba_prefabs_destructor.lua
simplay 3
prefabchange Enemigo Caja fails
prefabreset Enemigo fails
simplay 3
scriptinfo shared creado Enemigo.002
# guardar JUGANDO escribe la estructura del usuario: lo destruido por el script esta y lo creado no (la partida
# sigue igual despues)
savew3d /tmp/w3d_f7_rev/b/enjuego.w3d
prefablive 2
fail prefabinfo Enemigo.001
prefabinfo Enemigo.002 generated 4
simplay 1
simstop
prefablive 2
prefabinfo Enemigo prefab Enemigo generated 4 overrides 0
prefabinfo Enemigo.001 generated 4 overrides 1
openw3d /tmp/w3d_f7_rev/b/enjuego.w3d
prefablive 2
prefabinfo Enemigo.001 generated 4 overrides 1
prefabnode Enemigo.001 Esqueleto/Sensor visible 0
fail prefabinfo Enemigo.002
# destruir() de lo PUESTO en la escena: la ref del script queda en nil (objeto() da nil), como en el binario
rootscript Cubo prefab_rev_objetivo.lua objetivo Enemigo.001
simplay 4
scriptinfo shared sigue false
simstop
prefabinfo Enemigo.001 generated 4

# --- C) renombrar en la escena no toca las refs de lo generado (su "Cuerpo" es el suyo) ---
prefabenemy /tmp/w3d_f7_rev/c
prefabinstantiate Enemigo 0 0 -6 name Enemigo
add cube
objname Cuerpo
objname Tronco
prefabinfo Enemigo overrides 0
prefabnode Enemigo Esqueleto ref cuerpo Cuerpo
savew3d /tmp/w3d_f7_rev/c/c.w3d
openw3d /tmp/w3d_f7_rev/c/c.w3d
prefabinfo Enemigo overrides 0
prefabnode Enemigo Esqueleto ref cuerpo Cuerpo

# --- D) instanciar() en un inicio(): lo creado arranca (su inicio() corre) y el Stop lo borra ---
prefabenemy /tmp/w3d_f7_rev/d
rootscript Cubo prefab_rev_spawn.lua
prefablive 0
simplay 3
prefablive 1
scriptinfo shared spawn Enemigo
scriptinfo shared enemigos 1
simstop
prefablive 0

# --- E) un script agregado a un objeto generado no es un override (y no corre los valores de los otros) ---
prefabenemy /tmp/w3d_f7_rev/e physics 1
prefabinstantiate Enemigo 0 0 -6 name Enemigo
rootscript Esqueleto /tmp/w3d_f7_rev/e/caja.lua vida 5
prefabinfo Enemigo overrides 0
savew3d /tmp/w3d_f7_rev/e/e.w3d
openw3d /tmp/w3d_f7_rev/e/e.w3d
prefabinfo Enemigo overrides 0
prefabnode Enemigo Esqueleto ref vida 10

# --- F) ANIDADOS: lo generado por la anidada es de la de afuera (se guarda); renombrar el anidado ---
prefabenemy /tmp/w3d_f7_rev/f physics 1
rootopen Caja prefab
prefabinstantiate Enemigo 0 3 0 name Enemigo
rootopen Scene
prefabinstantiate Caja 4 5 -6 name Caja
prefabinfo Caja generated 6 overrides 0
prefaboverride Caja visible Enemigo/Enemigo/Esqueleto/Cuerpo 0
prefaboverride Caja prop Enemigo/Enemigo/Esqueleto vida 77
prefabinfo Caja overrides 2
savew3d /tmp/w3d_f7_rev/f/n.w3d
openw3d /tmp/w3d_f7_rev/f/n.w3d
prefabinfo Caja generated 6 overrides 2
prefabnode Caja Enemigo/Enemigo/Esqueleto/Cuerpo visible 0
prefabnode Caja Enemigo/Enemigo/Esqueleto ref vida 77
# volver de editar el ANIDADO regenera la de afuera con sus overrides
rootopen Enemigo prefab
rootopen Scene
prefabinfo Caja generated 6 overrides 2
prefabnode Caja Enemigo/Enemigo/Esqueleto/Cuerpo visible 0
# renombrar el anidado: la definicion del que lo contiene lo sigue (una instancia nueva lo genera entero)
outview prefabs
recrename prefabs Enemigo Soldado
outview scene
prefabinstantiate Caja 8 5 -6 name Caja.001
prefabinfo Caja.001 generated 6
prefabnode Caja.001 Enemigo type prefab
prefabunpack Caja.001
savew3d /tmp/w3d_f7_rev/f/r.w3d
entryexists /tmp/w3d_f7_rev/f/r.w3d prefabs/soldado.w3dp 1
entryexists /tmp/w3d_f7_rev/f/r.w3d prefabs/enemigo.w3dp 0
openw3d /tmp/w3d_f7_rev/f/r.w3d
prefabinfo Caja generated 6
# (la instancia anidada que quedo en la escena al desempaquetar es de "Soldado", no de un prefab que ya no existe)
prefabinfo Enemigo prefab Soldado generated 4 empty 0

# --- G) el riel de la camara en una curva de una instancia creada y destruida jugando ---
openw3d prueba_prefabs_riel.w3d
selobj RielB
prefabcreate name RielB
simplay 10
scriptinfo shared riel true
simstop

# --- H) Unpack: las refs internas siguen a SU objeto renumerado ---
prefabenemy /tmp/w3d_f7_rev/h
add cube
objname Cuerpo
objrel Cuerpo parent -
prefabinstantiate Enemigo -4 0 -6 name Enemigo
prefabinstantiate Enemigo 4 0 -6 name Enemigo.001
prefabunpack Enemigo
objrel Cuerpo.001 parent Esqueleto
prefabobj Esqueleto ref cuerpo Cuerpo.001
prefabunpack Enemigo.001
objrel Cuerpo.002 parent Esqueleto.001
prefabobj Esqueleto.001 ref cuerpo Cuerpo.002
# (Ctrl+Z: vuelve la instancia y su ref vuelve a su nombre del prefab; Ctrl+Y la vuelve a arrastrar)
undo
prefablive 1
prefabnode Enemigo.001 Esqueleto ref cuerpo Cuerpo
redo
prefablive 0
prefabobj Esqueleto.001 ref cuerpo Cuerpo.002
savew3d /tmp/w3d_f7_rev/h/u.w3d
openw3d /tmp/w3d_f7_rev/h/u.w3d
prefabobj Esqueleto ref cuerpo Cuerpo.001
prefabobj Esqueleto.001 ref cuerpo Cuerpo.002

# --- I) instanciar() jugando: sus cuerpos rigidos existen en su inicio() ---
prefabenemy /tmp/w3d_f7_rev/i physics 1
prefabinstantiate Caja -3 5 0 name Caja
rootscript Cubo prefab_rev_caida.lua
simplay 4
scriptinfo shared caida cae
simstop

# --- J) el "_origen" en seco, exacto ---
prefaborigin 16777215
prefaborigin 16777217
prefaborigin 16777219
prefaborigin 4000000001

# --- K) overrides SIN sincronizar (el ojo de un hijo, sin mirar la tarjeta): volver de editar el prefab y
#     Shift+D los conservan ---
prefabenemy /tmp/w3d_f7_rev/k
prefabinstantiate Enemigo 0 0 -6 name Enemigo
visible 0 Sensor
prefabnode Enemigo Esqueleto/Sensor visible 0
rootopen Enemigo prefab
rootopen Scene
prefabnode Enemigo Esqueleto/Sensor visible 0
visible 0 Cuerpo
prefabsel Enemigo
menuobject 1
# (Shift+D deja la copia agarrada: elegirla termina el transform)
prefabsel Enemigo.001
prefabnode Enemigo.001 Esqueleto/Sensor visible 0
prefabnode Enemigo.001 Esqueleto/Cuerpo visible 0
prefabinfo Enemigo.001 overrides 2

# --- L) editando un prefab Add va ADENTRO de su objeto raiz; Join, G y los keyframes no tocan lo generado ---
prefabenemy /tmp/w3d_f7_rev/l
prefabinstantiate Enemigo 0 0 -6 name Enemigo
rootopen Enemigo prefab
prefabadd cube
objname Arma
objrel Arma parent Enemigo
rootopen Scene
prefabinfo Enemigo generated 5
prefabnode Enemigo Arma type mesh generated 1
prefabpick Cuerpo CuboAfuera
join
prefabinfo Enemigo generated 5
prefabpick CuboAfuera Cuerpo
join
objrel CuboAfuera parent -
prefabinfo Enemigo generated 5
prefabsel Enemigo Esqueleto
fail objmove 2 0 0
prefabworld Enemigo Esqueleto x less 0.1
prefabkey
prefabnode Enemigo Esqueleto curves 0
keydiamond 0 0 state 0
prefabnode Enemigo Esqueleto curves 0

# --- M) borrar un prefab: sus instancias en una escena SIN CARGAR cuentan; Select Users; borrar igual ---
prefabenemy /tmp/w3d_f7_rev/m
rootnew scene Nivel2
prefabinstantiate Enemigo 0 0 -6 name Enemigo
rootopen Scene
savew3d /tmp/w3d_f7_rev/m/p.w3d
openw3d /tmp/w3d_f7_rev/m/p.w3d
outview prefabs
recdelete prefabs Enemigo fails
outrow Enemigo users 1
outview scene
rootopen Nivel2
prefabinfo Enemigo generated 4 empty 0
rootopen Scene
prefabinstantiate Enemigo -4 0 -6 name Enemigo
prefabinstantiate Enemigo 4 0 -6 name Enemigo.001
outview prefabs
outrow Enemigo users 3
outclick Enemigo
outmenu Select Users
selection n 2 has Enemigo has Enemigo.001
recdeleteforced prefabs Enemigo
outview scene
prefablive 2
undo
outview prefabs
outrow Enemigo users 3
outview scene
