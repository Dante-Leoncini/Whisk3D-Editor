# ==========================================================================
#  HITBOX contra CUERPOS RIGIDOS + el evento alTocar de los contactos.
#  Correr DESDE ESTA CARPETA (ver prueba_hitbox.w3s):
#    ../../platform/linux/build/whisk3d --script prueba_hitbox_rigido.w3s
#
#  Escena prueba_hitbox_rigido.w3d: una Caja dinamica (1x1x1, arranca en y=4; su
#  script la despierta) cae sobre un Piso estatico. En el camino atraviesa:
#    - Zona (y 2..3, detectarCuerpos): la zona y la caja reciben entrar 1 y salir 1
#      (la caja con mio = nil y suyo = Zona: los cuerpos no tienen hitbox propio);
#    - Ciega (y 1.25..1.75, SIN detectarCuerpos): nada;
#    - ConFiltro (y 3.3..3.7, detecta cuerpos pero con filtro): nada (los cuerpos
#      no tienen etiqueta).
#  Al aterrizar, alTocar en el piso y en la caja (normal de cada uno HACIA el
#  otro: +Y del motor para el piso, -Y para la caja; lua la recibe Z arriba,
#  asi que hitbox_contador.lua anota la vertical nz en <prefijo>_nz). Apoyada,
#  la caja se DUERME y el par sigue "tocandose": dormir no dispara otro alTocar.
#  prueba_hitbox_rigido_oculta.w3d es la misma escena con la Caja OCULTA: la
#  fisica la sigue simulando (cae y se apoya), pero un objeto oculto no participa:
#  ni entra a la Zona ni dispara alTocar (ni en el piso ni en ella).
# ==========================================================================

openw3d prueba_hitbox_rigido.w3d
hitboxinfo Zona bodies 1
hitboxinfo Ciega bodies 0

simplay 60
scriptinfo shared zona_entrar 1
scriptinfo shared zona_salir 1
scriptinfo shared zona_otro Caja
scriptinfo shared zona_suyo nil
scriptinfo shared caja_entrar 1
scriptinfo shared caja_salir 1
scriptinfo shared caja_otro Zona
scriptinfo shared caja_mio nil
scriptinfo shared caja_suyo Zona
scriptinfo shared ciega_entrar 0
scriptinfo shared confiltro_entrar 0
scriptinfo shared piso_tocado Caja
scriptinfo shared caja_tocado Piso
sharednum piso_tocar 1
sharednum caja_tocar 1
sharednum piso_nz 0.99 1.01
sharednum caja_nz -1.01 -0.99
posobject Caja 0 0.5 0 0.05
hitboxstats bodies 2 contacts 1

# 100 ticks mas: la caja se duerme apoyada y NO vuelve a "tocar"
simplay 100
sharednum piso_tocar 1
sharednum caja_tocar 1
hitboxstats contacts 1

simstop
posobject Caja 0 4 0
hitboxstats contacts 0

# --- la misma caja OCULTA: se simula, pero no participa (ni hitbox ni alTocar) ---
openw3d prueba_hitbox_rigido_oculta.w3d
simplay 60
posobject Caja 0 0.5 0 0.05
scriptinfo shared zona_entrar 0
scriptinfo shared caja_entrar 0
sharednum piso_tocar 0
sharednum caja_tocar 0
hitboxstats bodies 1 contacts 0
simstop
