# ==========================================================================
#  DUPLICAR UN PERSONAJE ENTERO (esqueleto + cuerpo skinneado + hitbox hijo)
#  Correr DESDE ESTA CARPETA:
#    cd <motor>/tools/pruebas
#    ../../platform/linux/build/whisk3d --script prueba_dup_personaje.w3s
#
#  Antes: Alt+D sobre un armature daba una Instance (un dibujo del original, sin
#  pose propia ni hijos de verdad: sin hitbox, sin eventos) y Shift+D no creaba
#  nada; con el cuerpo y el sensor elegidos tambien, el cuerpo nuevo quedaba
#  colgado del esqueleto ORIGINAL y deformado por el. Ahora, con los mismos
#  comandos del teclado (NewInstance / DuplicatedObject):
#    A) Alt+D del personaje entero = otro personaje: otro esqueleto con los
#       MISMOS clips (los propios del original pasan a un animset en memoria),
#       otro cuerpo con la MISMA malla deformado por SU esqueleto y otro sensor
#       hijo que avisa a SU esqueleto; el original no cambia;
#    B) Ctrl+Z saca el personaje ENTERO (antes los hijos de un borrado se
#       preservaban colgados del abuelo) y Ctrl+Y lo devuelve;
#    C) Alt+D de un esqueleto solo / de un hitbox solo: copias de verdad;
#    D) Shift+D del personaje entero = copia REAL (clips propios, malla con su
#       propio recurso), con la misma jerarquia y el cuerpo en SU esqueleto;
#    E) guardar y reabrir: los cuatro esqueletos caen en UN animset compartido.
# ==========================================================================

window 640 480
charactersmin /tmp/w3d_duppj 1
objrel Personaje parent - children 2 type armature
animsetarm Personaje shared 0 clips 2
animsetinfo live 0

# --- A) Alt+D del personaje entero ---
duphierarchy linked Personaje +hijos
objrel Personaje.001 parent - children 2 type armature
objrel Cuerpo.001 parent Personaje.001 skin Personaje.001 type mesh
objrel Sensor.001 parent Personaje.001 type hitbox
hitboxinfo Sensor.001 parent Personaje.001 owner Personaje.001 filter jugador
meshcheck Cuerpo.001 resource Cuerpo shares Cuerpo
animsetarm Personaje shared 1 clips 2
animsetarm Personaje.001 shared 1 clips 2
animsetclip Personaje.001 0 same Personaje 0 1
animsetclip Personaje.001 1 same Personaje 1 1
animsetinfo live 1 refs 2 clips 2 inmemory 1
# poses por instancia: con OTRO clip activo la copia se deforma distinto (su cuerpo sigue a SU
# esqueleto; si siguiera al original quedaria con la misma pose)
clipactive Personaje.001 Quieto
charactersshow 2 shared 1
# el original no se movio de lugar ni de esqueleto
objrel Personaje parent - children 2
objrel Cuerpo parent Personaje skin Personaje
hitboxinfo Sensor parent Personaje owner Personaje

# --- B) Ctrl+Z / Ctrl+Y ---
undo
objrel Personaje.001 none
objrel Cuerpo.001 none
objrel Sensor.001 none
objrel Personaje children 2
redo
objrel Personaje.001 parent - children 2
objrel Cuerpo.001 parent Personaje.001 skin Personaje.001
objrel Sensor.001 parent Personaje.001
charactersshow 2 shared 1

# --- C) un esqueleto solo, un hitbox solo ---
duphierarchy linked Personaje
objrel Personaje.002 parent - children 0 type armature
animsetarm Personaje.002 shared 1 clips 2
animsetinfo live 1 refs 3
duphierarchy linked Sensor
objrel Sensor.002 parent Personaje type hitbox
hitboxinfo Sensor.002 parent Personaje owner Personaje filter jugador
objrel Personaje children 3

# --- D) Shift+D del personaje entero: copia REAL ---
duphierarchy copy Personaje.001 +hijos
objrel Personaje.003 parent - children 2 type armature
objrel Cuerpo.002 parent Personaje.003 skin Personaje.003 type mesh
objrel Sensor.003 parent Personaje.003 type hitbox
hitboxinfo Sensor.003 parent Personaje.003 owner Personaje.003
animsetarm Personaje.003 shared 0 clips 2 setname Personaje
meshcheck Cuerpo.002 users 1
animsetinfo live 1 refs 3
# el de origen sigue en su lugar y con su esqueleto
objrel Cuerpo.001 parent Personaje.001 skin Personaje.001

# --- E) guardar y reabrir: un animset para los cuatro ---
savew3d /tmp/w3d_duppj/dup.w3d
animsetsw3d /tmp/w3d_duppj/dup.w3d animsets 1 clips 2 armatures 4 inline 0 registry 1
animsetinfo inmemory 0
openw3d /tmp/w3d_duppj/dup.w3d
animsetinfo live 1 refs 4 clips 2 inmemory 0 descriptores 1
animsetarm Personaje.003 shared 1 clips 2
objrel Personaje.001 parent - children 2
objrel Cuerpo.001 parent Personaje.001 skin Personaje.001
objrel Cuerpo.002 parent Personaje.003 skin Personaje.003
hitboxinfo Sensor.001 parent Personaje.001 owner Personaje.001
hitboxinfo Sensor.003 parent Personaje.003 owner Personaje.003
meshcheck Cuerpo.001 resource Cuerpo shares Cuerpo
