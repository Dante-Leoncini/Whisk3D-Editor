# ==========================================================================
#  EL FONDO DEL RENDER: COLOR O TEXTURA 360 (equirectangular), ROTACION, ANIMACION
#  Correr DESDE ESTA CARPETA:
#    cd <motor>/tools/pruebas
#    ../../platform/linux/build/whisk3d --script prueba_fondo360.w3s
#
#  1. la vista Render muestra la imagen 360 alrededor de la escena (arriba el cielo azul, abajo el suelo marron)
#  2. se guarda y se abre con el proyecto (antes el fondo ni se guardaba: volvia a negro)
#  3. la rotacion se anima con su rombo (las curvas viven en la coleccion de la escena)
# ==========================================================================

window 640 480
scenedefault
selobj Cubo
objpos 0 0 -40
view3d shading 2
view3d gizmo 0
background texture fondo360_prueba.png
background show mode 1
background show list 1
tick 10
# (la vista mira hacia abajo: se ve el SUELO de la imagen; girada 180 grados en Y, el CIELO. La rutina "Limpiar
#  pantalla" de la escena de fabrica borra la pantalla: el cielo se vuelve a dibujar despues)
uishot /tmp/w3d_fondo_vista.png
pngpx /tmp/w3d_fondo_vista.png 200 300 120 80 40 - 12
background rot 0 180 0
tick 3
uishot /tmp/w3d_fondo_vista.png
pngpx /tmp/w3d_fondo_vista.png 200 300 40 90 220 - 12
# el TRAZADO DE RAYOS ve lo mismo (la misma cuenta de la direccion a la imagen)
view3d raytraced 1 2
tick 30
uishot /tmp/w3d_fondo_rt.png
pngpx /tmp/w3d_fondo_rt.png 200 300 40 90 220 - 12
view3d raytraced 0
background rot 0 0 0

# ---- 2) guardar y abrir ----
background rot 0 0 30
savew3d /tmp/w3d_fondo360.w3d
jsonhas /tmp/w3d_fondo360.w3d "backgroundTextures"
scenedefault
background show mode 0
background show list 0
openw3d /tmp/w3d_fondo360.w3d
background show mode 1
background show list 1
background show texture fondo360_prueba
background show rot 0 0 30

# ---- 3) la rotacion animada (rombo de "Rotacion Z" del fondo: AnimFondoRot = 21, Z = 2) ----
frame 1
background rot 0 0 0
keydiamond 21 2
frame 11
background rot 0 0 90
keydiamond 21 2
frame 6
background show rot 0 0 45 15
frame 11
background show rot 0 0 90 0.01
