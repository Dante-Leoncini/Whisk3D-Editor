# ==========================================================================
#  LA ANIMACION QUE SE ESTABA EDITANDO VUELVE AL ABRIR EL PROYECTO
#  Correr DESDE ESTA CARPETA:
#    cd <motor>/tools/pruebas
#    ../../platform/linux/build/whisk3d --script prueba_anim_sesion.w3s
#
#  EL CASO. Con un clip de un armature elegido en la linea de tiempo, guardar,
#  cerrar y abrir volvia a la animacion de ESCENA: con cientos de clips habia
#  que buscar otra vez el que se estaba editando. Ahora la sesion del .w3d
#  guarda que mira la linea de tiempo (animTipo / animObjeto), se repone al
#  abrir (con su rango y el cuadro donde estaba) y el selector marca el clip
#  en VERDE (abre scrolleado a el).
# ==========================================================================

window 900 700
charactersmin /tmp/w3d_animsesion 1
clipmenu Quieto
animactive armature Personaje Quieto
frame 3
savew3d /tmp/w3d_animsesion/sesion.w3d
jsonhas /tmp/w3d_animsesion/sesion.w3d "animType": "armature"
openw3d /tmp/w3d_animsesion/sesion.w3d
animactive armature Personaje Quieto frame 3
# el otro clip, por las dudas (no es "el primero")
clipmenu Saludo
animactive armature Personaje Saludo
savew3d /tmp/w3d_animsesion/sesion.w3d
openw3d /tmp/w3d_animsesion/sesion.w3d
animactive armature Personaje Saludo
# de vuelta a una animacion de escena: en un JUEGO (abre en "Juego") tambien se nombra
clipmenu Scene
animactive scene
savew3d /tmp/w3d_animsesion/sesion.w3d
jsonhas /tmp/w3d_animsesion/sesion.w3d "animType": "escena"
openw3d /tmp/w3d_animsesion/sesion.w3d
animactive scene
# en una ESCENA comun la animacion de escena es lo de siempre: no se escribe nada (un .w3d de antes abre igual)
scenedefault
savew3d /tmp/w3d_animsesion/comun.w3d
jsonhas /tmp/w3d_animsesion/comun.w3d "animType" 0
openw3d /tmp/w3d_animsesion/comun.w3d
animactive scene
