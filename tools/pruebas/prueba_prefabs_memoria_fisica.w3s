# ==========================================================================
#  PREFABS: VERTEX ANIMS COMPARTIDAS y FISICA ADENTRO DE LAS INSTANCIAS
#  (io/Prefabs.h, animation/VertexAnimation.h: VertexAnimCompartir / VertexAnimAdoptarClave,
#   physics/W3dRigido.cpp: EspacioDe)
#  Correr DESDE ESTA CARPETA:
#    ../../platform/linux/build/whisk3d --script prueba_prefabs_memoria_fisica.w3s
#
#  A) un prefab con una VERTEX ANIM y N instancias: UN solo juego de frames en memoria (el de la
#     plantilla) mientras el prefab NO se guardo (la definicion sale de la memoria), y tambien despues de
#     guardar/abrir (la definicion sale de su entrada: todas leen el MISMO blob y lo comparten). La pose
#     es por instancia. Editar la plantilla le hace su copia (COW): las instancias no cambian hasta volver.
#  B) cuerpos rigidos DOS niveles adentro de lo generado (Pila > Base > Bloque), con la instancia
#     rotada y ESCALADA: la caja se mide con la escala de mundo, cae al piso y queda apoyada a su altura;
#     mover la INSTANCIA jugando arrastra al cuerpo; el Stop devuelve todo.
# ==========================================================================

window 1280 720
prefabenemy /tmp/w3d_f7_mf
prefabflag
meminfo anims 0

# --- A) sin guardar: la definicion sale de la MEMORIA; las instancias comparten los frames de la plantilla ---
prefabinstantiate Bandera -4 0 -6 name Bandera
prefabinstantiate Bandera 0 0 -6 times 4 name Bandera.004
prefabframes Bandera instances 5 games 1 template 1
meminfo anims 1
meminfo animsrefs 6
prefabvapose Bandera Bandera.001
# regenerar las instancias (volver de editar el prefab) sigue compartiendo; las viejas sueltan su ref
prefabregenerate Bandera n 5
prefabframes Bandera instances 5 games 1 template 1
meminfo anims 1
meminfo animsrefs 6
# editar la PLANTILLA (un keyframe nuevo): se hace su copia (COW) y las instancias siguen con los de antes
prefabvakey Bandera 5
prefabframes Bandera instances 5 games 1 template 0
meminfo animsrefs 5
prefabregenerate Bandera n 5
prefabframes Bandera instances 5 games 1 template 1
meminfo anims 1
meminfo animsrefs 6

# --- A2) guardar/abrir: la raiz del prefab NO esta cargada y la definicion sale de su ENTRADA: las cinco
#     leen el MISMO blob de frames y lo comparten (uno solo en memoria) ---
savew3d /tmp/w3d_f7_mf/mf.w3d
openw3d /tmp/w3d_f7_mf/mf.w3d
rootinfo loaded Bandera 0
prefabframes Bandera instances 5 games 1
meminfo anims 1
meminfo animsrefs 5
prefabvapose Bandera.002 Bandera.003
prefabregenerate Bandera n 5
prefabframes Bandera instances 5 games 1
meminfo anims 1
# abrir el prefab y volver: ahora la plantilla esta cargada y las instancias comparten con ella
rootopen Bandera prefab
rootopen Scene
prefabframes Bandera instances 5 games 1 template 1
savew3d /tmp/w3d_f7_mf/mf2.w3d
openw3d /tmp/w3d_f7_mf/mf2.w3d
prefabframes Bandera instances 5 games 1
savew3d /tmp/w3d_f7_mf/mf3.w3d
w3dequal /tmp/w3d_f7_mf/mf2.w3d /tmp/w3d_f7_mf/mf3.w3d

# --- B) FISICA: el cuerpo esta DOS niveles adentro (Pila > Base > Bloque); la segunda instancia esta
#     girada 90 grados y ESCALADA x2 (su caja mide 2 de semieje y queda apoyada a y = 2) ---
prefabstack
prefabinstantiate Pila 0 6 0 name Pila
prefabinstantiate Pila 8 6 0 name Pila.001
selobj Pila.001
objscale 2 2 2
objrot 90
prefabworld Pila Base/Bloque y greater 6.9
prefabworld Pila Base/Bloque x greater 0.9
prefabworld Pila.001 Base/Bloque y greater 7.9
prefabworld Pila.001 Base/Bloque z less -1.9
simplay 1
prefabrigid Pila Base/Bloque body 1 semi 1
prefabrigid Pila.001 Base/Bloque body 1 semi 2
simplay 89
prefabworld Pila Base/Bloque y greater 0.9
prefabworld Pila Base/Bloque y less 1.1
prefabworld Pila Base/Bloque x greater 0.9
prefabworld Pila Base/Bloque x less 1.1
prefabworld Pila.001 Base/Bloque y greater 1.9
prefabworld Pila.001 Base/Bloque y less 2.1
prefabworld Pila.001 Base/Bloque x greater 7.9
prefabworld Pila.001 Base/Bloque x less 8.1
prefabworld Pila.001 Base/Bloque z greater -2.1
prefabworld Pila.001 Base/Bloque z less -1.9
# mover la INSTANCIA jugando: su cuerpo la sigue (no se queda en el piso)
selobj Pila
objpos 0 20 0
simplay 1
prefabrigid Pila Base/Bloque center y greater 14
prefabworld Pila Base/Bloque y greater 14
simstop
prefabworld Pila Base/Bloque y greater 6.9
prefabworld Pila Base/Bloque y less 7.1
prefabworld Pila.001 Base/Bloque y greater 7.9
prefabworld Pila.001 Base/Bloque y less 8.1
# guardar/abrir y jugar otra vez: lo mismo
savew3d /tmp/w3d_f7_mf/fis.w3d
openw3d /tmp/w3d_f7_mf/fis.w3d
simplay 90
prefabworld Pila Base/Bloque y greater 0.9
prefabworld Pila Base/Bloque y less 1.1
prefabworld Pila.001 Base/Bloque y greater 1.9
prefabworld Pila.001 Base/Bloque y less 2.1
simstop
prefabworld Pila.001 Base/Bloque y greater 7.9
