escenadefecto
selobj Cubo
matnew
matsuelto M01
matsuelto M02
matsuelto M03
matsuelto M04
matsuelto M05
matsuelto M06
matsuelto M07
matsuelto M08
matsuelto M09
matsuelto M10
matsuelto M11
matsuelto M12
matsuelto M13
matsuelto M14
matsuelto M15
matsuelto M16
matsuelto M17
matsuelto M18
matsuelto M19
matsuelto M20
matsuelto M21
matsuelto M22
matsuelto M23
matsuelto M24
matsuelto M25
matsuelto M26
matsuelto M27
matsuelto M28
matsuelto M29
matsuelto M30
matsuelto M31
matsuelto M32
matsuelto M33
matsuelto M34
matsuelto M35
matsuelto M36
matsuelto M37
matsuelto M38
matsuelto M39
matsuelto M40
outvista materiales
outfilas n 41
outclick M01
outclick M03 ctrl
outfondo M01 sel
outfondo M02 nosel
outfondo M03 sel
# abajo de todo (la lista scrolleada)
outclick M38
outclick M40 ctrl
outclick M39 ctrl
outsel n 3
outfondo M38 sel
outfondo M39 sel
outfondo M40 sel
outfondo M37 nosel
# el DESTINO de un arrastre: la carpeta del recurso apuntado (bien abajo, tambien scrolleado)
carpetanueva materiales - A
carpetanueva materiales - B
outclick M01
outclick M25 shift
outmenu mover A
recmover materiales M26 B
recmover materiales M27 B
outdragsobre M40 M27 B
outdragsobre M40 B B
outdragsobre M40 M30 -
recurso materiales M40 carpeta -

# ---- I) "Select Users" solo con usuarios OBJETO; el de Properties vuelve a la escena ----
escenadefecto
add cube
selobj Cubo.001
matnew
mallasrecurso
selobj Cubo.001
delete
selobj Cubo
seleccion n 1 tiene Cubo
# (su unico usuario es la malla huerfana del registro: no hay nada que seleccionar)
outvista materiales
outfila Material estado uso usuarios 1
outclick Material
fail outmenu Select Users
outcontexto Material
outbarra c menu ninguno
recboton usuarios oculto
# elegir un recurso de la biblioteca DESELECCIONA la escena (fase 4b: o se eligen objetos o recursos)
seleccion n 0
# el boton de Properties: selecciona Y el outliner vuelve a la escena, como el menu
selobj Cubo
matnew
mallasrecurso
outvista mallas
outclick Cubo
recboton usuarios
outvista es escena
seleccion n 1 tiene Cubo

# ---- J) un script nombra una textura solo si nombra su archivo ENTERO ----
abrirw3d prueba_outliner_bordes_v4.w3d
texentrada dosmats-b.png
outvista texturas
outfila dosmats-b.png usuarios 0 estado huerfano
entradatexto scripts/nota.lua -- no la usa: "otrodosmats-b.png" ni "dosmats-b.png.bak"
outfila dosmats-b.png usuarios 0 estado huerfano
entradatexto scripts/hud.lua setTextura(obj, "texturas/dosmats-b.png")
outfila dosmats-b.png usuarios 1 estado uso
recpurgar texturas n 0
outfila dosmats-b.png estado uso

