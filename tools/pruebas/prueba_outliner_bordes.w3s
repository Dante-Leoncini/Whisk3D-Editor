# prueba_outliner_bordes.w3s — FASE 4: los BORDES del outliner por recursos que encontro la revision
#
#  Criterios de aceptacion:
#   - Esc (o perder el foco sin cambiar nada) en el rename en linea o en el Name de Properties NO
#     renombra, aunque el nombre no este en la forma que pide su tipo ("texturas/Piso_A.png");
#   - la carpeta de una textura de DISCO que solo usan particulas (o elementos 2D, flipbooks) sigue a su
#     entrada en el PRIMER guardado;
#   - una textura que vive SOLO en memoria (New Texture / pintura) y nadie usa es un huerfano: se
#     guarda (con su carpeta) hasta purgarla;
#   - la FUENTE BITMAP de un Texto2D es un usuario de su png (en uso, no se purga) y renombrar el png
#     se lleva al Texto2D y a su .json de glifos (la fuente sigue cargando), con undo; el .json de
#     glifos HERMANO que vive en texturas/ (el par png + json) tambien esta en uso y no se purga;
#   - un animset que retiene un armature BORRADO (en el undo) no se "purga" a medias: se rechaza;
#   - las texturas de un material HUERFANO no se cargan al abrir (quedan DORMIDAS: ni GPU ni espera del
#     Play); el guardado las conserva byte a byte y despiertan cuando una malla usa el material;
#   - el teclado de PC por la puerta real (la UI compartida con el mouse sobre el outliner): las flechas
#     dejan la fila sola y Shift+flechas suma;
#   - con la lista SCROLLEADA, las filas de la seleccion multiple se ven resaltadas; un arrastre resalta
#     la CARPETA destino (no el recurso apuntado; la raiz no se resalta);
#   - "Select Users" solo se ofrece si algun usuario es un OBJETO, y el de Properties hace lo mismo que
#     el del outliner (vuelve a la escena);
#   - un script cuenta como usuario de una textura solo si nombra su archivo ENTERO;
#   - los datos del recurso (tarjeta Recurso) salen en el idioma de la UI, con singular y plural.
window 1280 720

# ---- A) Esc / sin cambios: NO renombra un nombre que no esta en la forma de entrada ----
scenedefault
selobj Cubo
matnew
meshesresource
objtexture Cubo dosmats.png
savew3d prueba_outliner_bordes_v4.w3d
openw3d prueba_outliner_bordes_v4.w3d
entryraw textures/Piso_A.png dosmats-b.png
outview textures
outrow Piso_A.png users 0 state huerfano
# el rename en linea: F2 + Esc
outclick Piso_A.png
outkeypc f2
outesc
resource textures textures/Piso_A.png exists 1
resource textures textures/piso_a.png exists 0
# el Name de Properties: enfocar + Esc
outclick Piso_A.png
fieldfocus recname
outesc
resource textures textures/Piso_A.png exists 1
resource textures textures/piso_a.png exists 0
# confirmar el MISMO texto tampoco toca nada
outkeypc f2
outwrite Piso_A.png
resource textures textures/Piso_A.png exists 1
# un nombre escrito de verdad SI renombra (a la forma de entrada), con undo
outclick Piso_A.png
outkeypc f2
outwrite Piso B
resource textures textures/piso_b.png exists 1
resource textures textures/Piso_A.png exists 0
undo
resource textures textures/Piso_A.png exists 1
resource textures textures/piso_b.png exists 0

# ---- B) la carpeta de una textura de DISCO que solo usa una particula, en el PRIMER guardado ----
scenedefault
pairtex Humo dosmats.png
outview textures
recmove textures dosmats.png UI
resource textures dosmats.png folder UI
savew3d prueba_outliner_bordes_rt1.w3d
texrefof particle Humo textures/dosmats.png
resource textures textures/dosmats.png folder UI
openw3d prueba_outliner_bordes_rt1.w3d
resource textures textures/dosmats.png folder UI users 1

# ---- C) una textura SOLO EN MEMORIA que nadie usa: se conserva (con su carpeta) ----
newtex Lienzo 64 64 uvgrid
outview textures
outrow lienzo.png users 0 state huerfano
recmove textures textures/lienzo.png Pintura
savew3d prueba_outliner_bordes_rt2.w3d
zipentry prueba_outliner_bordes_rt2.w3d textures/lienzo.png
openw3d prueba_outliner_bordes_rt2.w3d
resource textures textures/lienzo.png exists 1 users 0 folder Pintura
# (purgarla SI la saca del archivo)
recdelete textures textures/lienzo.png
savew3d prueba_outliner_bordes_rt3.w3d
zipentry prueba_outliner_bordes_rt3.w3d textures/lienzo.png no

# ---- D) la FUENTE BITMAP de un Texto2D: un usuario del png; renombrarlo lleva al texto y al json ----
openw3d prueba_fuente.w3d
savew3d prueba_outliner_bordes_fuente_v4.w3d
openw3d prueba_outliner_bordes_fuente_v4.w3d
outview textures
outrow fuente-bitmap-npot.png state use users 1
outrow fuente-bitmap-minima.png state use users 1
recdelete textures textures/fuente-bitmap-npot.png fails
recrename textures textures/fuente-bitmap-npot.png glifos textures/glifos.png
uifont
uiglyph TxtBitmap A 10 14 0 0 12
outrow glifos.png state use users 1
undo
resource textures textures/fuente-bitmap-npot.png exists 1 users 1
uiglyph TxtBitmap A 10 14 0 0 12
redo
resource textures textures/glifos.png exists 1 users 1
savew3d prueba_outliner_bordes_fuente_rt.w3d
zipentry prueba_outliner_bordes_fuente_rt.w3d textures/glifos.png
zipentry prueba_outliner_bordes_fuente_rt.w3d textures/fuente-bitmap-npot.png no
zipentry prueba_outliner_bordes_fuente_rt.w3d extra/glifos.json
zipentry prueba_outliner_bordes_fuente_rt.w3d extra/fuente-bitmap-npot.json no
openw3d prueba_outliner_bordes_fuente_rt.w3d
uiglyph TxtBitmap A 10 14 0 0 12
outview textures
outrow glifos.png state use users 1
# el par de la fuente con el .json AL LADO del png en texturas/ (como lo arman las herramientas de
# afuera): el json es del texto aunque el texto nombre el png; "Purge Orphans" no se lo lleva
entryraw textures/glifos.json textures/ui/fuente-bitmap-npot.json
outrow glifos.json state use users 1
outpx glifos.json use
recpurge textures n 0
outrow glifos.json state use
uiglyph TxtBitmap A 10 14 0 0 12

# ---- E) un animset que retiene un armature BORRADO (el undo): no se purga a medias ----
scenedefault
animsetsynthetic 1 add
savew3d prueba_outliner_bordes_anim_v4.w3d
openw3d prueba_outliner_bordes_anim_v4.w3d
selobj Personaje
delete
outview animations
outrow Personaje state huerfano
recpurge animations n 0
recdelete animations Personaje fails
resource animations Personaje exists 1
undo
outrow Personaje state use users 1

# ---- F) las texturas de un material HUERFANO quedan DORMIDAS ----
scenedefault
selobj Cubo
matnew
objtexture Cubo dosmats.png
add cube
selobj Cubo.001
matnew
objtexture Cubo.001 dosmats-b.png
selobj Cubo.001
delete
matloose Suelto
meshmaterial Cubo 0 Suelto
savew3d prueba_outliner_bordes_mat_v4.w3d
openw3d prueba_outliner_bordes_mat_v4.w3d
# "Material" y "Material.001" no los usa nadie: no se dibujan, sus texturas no se cargan
outview materials
outrow Material state huerfano
outrow Material.001 state huerfano
texasleep n 2
texloaded textures/dosmats.png 0
texloaded textures/dosmats-b.png 0
# (siguen siendo usuarios de sus texturas: no se purgan de abajo)
outview textures
outrow dosmats.png state use users 1
outrow dosmats-b.png state use users 1
# guardar con las dormidas: las entradas siguen y re-guardar da los mismos bytes
savew3d prueba_outliner_bordes_mat_rt1.w3d
zipentry prueba_outliner_bordes_mat_rt1.w3d textures/dosmats.png
zipentry prueba_outliner_bordes_mat_rt1.w3d textures/dosmats-b.png
openw3d prueba_outliner_bordes_mat_rt1.w3d
texasleep n 2
savew3d prueba_outliner_bordes_mat_rt2.w3d
w3dequal prueba_outliner_bordes_mat_rt1.w3d prueba_outliner_bordes_mat_rt2.w3d
# una malla que PASA a usar el material sin pasar por Properties (un undo, un script): la cola
# diferida del loop principal lo despierta sola
texasleep assign Cubo 0 Material frames 20 n 1
texloaded textures/dosmats.png 1
texloaded textures/dosmats-b.png 0
# Properties va a mostrar el otro huerfano: despierta
outview materials
outclick Material.001
recprops material Material.001
texasleep frames 2 n 0
texloaded textures/dosmats-b.png 1

# ---- G) el teclado de PC por la puerta real: flechas = la fila sola, Shift+flechas suma ----
scenedefault
selobj Cubo
matnew
matloose Piel
matloose Metal
matloose Cuero
matloose Hueso
outview materials
outclick Cuero
outclick Metal ctrl
outsel n 2
outkeypc down
outsel n 1 has Piel
outkeypc shiftup
outsel n 2 has Piel has Metal
outkeypc shiftup
outsel n 3 has Piel has Metal has Material

# ---- H) la lista SCROLLEADA: la seleccion multiple y el destino de un arrastre se ven ----
scenedefault
selobj Cubo
matnew
matloose M01
matloose M02
matloose M03
matloose M04
matloose M05
matloose M06
matloose M07
matloose M08
matloose M09
matloose M10
matloose M11
matloose M12
matloose M13
matloose M14
matloose M15
matloose M16
matloose M17
matloose M18
matloose M19
matloose M20
matloose M21
matloose M22
matloose M23
matloose M24
matloose M25
matloose M26
matloose M27
matloose M28
matloose M29
matloose M30
matloose M31
matloose M32
matloose M33
matloose M34
matloose M35
matloose M36
matloose M37
matloose M38
matloose M39
matloose M40
outview materials
outrows n 41
outclick M01
outclick M03 ctrl
outbackground M01 sel
outbackground M02 nosel
outbackground M03 sel
# abajo de todo (la lista scrolleada)
outclick M38
outclick M40 ctrl
outclick M39 ctrl
outsel n 3
outbackground M38 sel
outbackground M39 sel
outbackground M40 sel
outbackground M37 nosel
# el DESTINO de un arrastre: la carpeta del recurso apuntado (bien abajo, tambien scrolleado)
foldernew materials - A
foldernew materials - B
outclick M01
outclick M25 shift
outmenu move A
recmove materials M26 B
recmove materials M27 B
outdragover M40 M27 B
outdragover M40 B B
outdragover M40 M30 -
resource materials M40 folder -

# ---- I) "Select Users" solo con usuarios OBJETO; el de Properties vuelve a la escena ----
scenedefault
add cube
selobj Cubo.001
matnew
meshesresource
selobj Cubo.001
delete
selobj Cubo
selection n 1 has Cubo
# (su unico usuario es la malla huerfana del registro: no hay nada que seleccionar)
outview materials
outrow Material state use users 1
outclick Material
fail outmenu Select Users
outcontext Material
outbar c menu none
recbutton users hidden
# elegir un recurso de la biblioteca DESELECCIONA la escena (fase 4b: o se eligen objetos o recursos)
selection n 0
# el boton de Properties: selecciona, como el menu (la biblioteca SIGUE en la biblioteca: no vuelve a la escena)
selobj Cubo
matnew
meshesresource
outview meshes
outclick Cubo
recbutton users
outview es meshes
selection n 1 has Cubo

# ---- J) un script nombra una textura solo si nombra su archivo ENTERO ----
openw3d prueba_outliner_bordes_v4.w3d
texentry dosmats-b.png
outview textures
outrow dosmats-b.png users 0 state huerfano
entrytext scripts/nota.lua -- no la usa: "otrodosmats-b.png" ni "dosmats-b.png.bak"
outrow dosmats-b.png users 0 state huerfano
entrytext scripts/hud.lua setTexture(obj, "textures/dosmats-b.png")
outrow dosmats-b.png users 1 state use
recpurge textures n 0
outrow dosmats-b.png state use

# ---- K) los datos del recurso en el idioma de la UI (singular y plural) ----
scenedefault
selobj Cubo
matnew
meshesresource
animsetsynthetic 1 add
savew3d prueba_outliner_bordes_info_v4.w3d
openw3d prueba_outliner_bordes_info_v4.w3d
recdata meshes Cubo at 24 vertices, 12 triangles, 1 part
recdata meshes Cubo es 24 vértices, 12 triángulos, 1 parte
recdata animations Personaje es 4 clips, 5 huesos
recdata animations Personaje at 4 clips, 5 bones

# ---- lo que no tiene que pasar ----
fail recboton none
fail outfondo NoExiste sel
