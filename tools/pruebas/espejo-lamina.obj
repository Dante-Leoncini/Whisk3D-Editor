# Quad HORIZONTAL de 1x1 centrado en el origen. Caras v/vt/vn: sin vn el
# importador de Whisk3D descarta las UV.
mtllib espejo-lamina.mtl
o espejo-agua
v -0.5 0.0 -0.5
v  0.5 0.0 -0.5
v  0.5 0.0  0.5
v -0.5 0.0  0.5
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 1.0 0.0
usemtl espejo-lamina
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
