# malla de prueba del CULLING POR TRIANGULO (PVS): 4 triangulos independientes en
# fila sobre el plano XZ, UN solo material (1 usemtl = 1 mesh part -> faces[] queda
# en el ORDEN DE CARAS del archivo, que es el dominio del sidecar pvs-tris.pvs.json).
# Caras v/vt/vn (Whisk3D exige los tres indices).
v -4 0 -1
v -3 0 -1
v -3.5 0 1
v -2 0 -1
v -1 0 -1
v -1.5 0 1
v 1 0 -1
v 2 0 -1
v 1.5 0 1
v 3 0 -1
v 4 0 -1
v 3.5 0 1
vt 0 0
vt 1 0
vt 0.5 1
vn 0 1 0
f 1/1/1 2/2/1 3/3/1
f 4/1/1 5/2/1 6/3/1
f 7/1/1 8/2/1 9/3/1
f 10/1/1 11/2/1 12/3/1
