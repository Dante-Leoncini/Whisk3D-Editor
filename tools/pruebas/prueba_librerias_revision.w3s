# ==========================================================================
#  LIBRERIAS EXTERNAS: los arreglos de la REVISION (io/Librerias.h, objects/ProxyW3d.h)
#  Correr DESDE ESTA CARPETA:
#    ../../platform/linux/build/whisk3d --script prueba_librerias_revision.w3s
#
#    A) BORRAR un proxy (o una instancia de prefab) se lleva lo que genero: nada queda suelto en el nivel (editable,
#       guardado con recursos de la libreria, con sus scripts corriendo en el Play) y Ctrl+Z lo devuelve entero;
#       borrar SOLO el padre de un proxy conserva el proxy con lo suyo;
#    B) el juego compilado lleva una libreria que el nivel usa SOLO desde lua (instanciar("personajes/Enemigo") sin
#       ningun proxy);
#    C) un nivel cuyo unico objeto 3D es un proxy se compila como juego 3D;
#    D) los FLIPBOOKS de una libreria no se filtran al nivel (ni a un proyecto nuevo los del anterior);
#    E) DESVINCULAR con mallas de la libreria usadas por el proyecto: cada una pasa a su copia propia (Ctrl+Z la
#       devuelve) y el nivel se sigue guardando; una referencia a una libreria que NO ESTA (su archivo falta) se
#       conserva al guardar sin frenarlo y vuelve a resolverse al vincularla (malla y animset).
#  Compila juegos de verdad (cmake + g++), asi que tarda mas que las demas.
# ==========================================================================

window 1280 720
libcreate /tmp/w3d_f8_rev/lib personajes.w3d dosmats.png

# --- A) BORRAR un proxy se lleva lo que genero (y Ctrl+Z lo devuelve) ---
scenedefault
liblink /tmp/w3d_f8_rev/lib/personajes.w3d
libproxy personajes prefab Arbol 3 0 -6
libproxy personajes prefab Enemigo 0 0 -6 times 2
prefablive 3
selobj Tronco
selobj Arbol
delete
prefablive 2
fail selobj Tronco
fail selobj Arbol
undo
prefablive 3
libproxyinfo Arbol lib personajes element Arbol generated 2
prefabnode Arbol . name Arbol generated 1
libmark Arbol Tronco lock
redo
prefablive 2
fail selobj Tronco
# (un Enemigo borrado no deja su Cuerpo / Sensor / script sueltos: en el Play corre UN solo enemigo)
selobj Enemigo.001
delete
prefablive 1
savew3d /tmp/w3d_f8_rev/nivel/borrado.w3d
entryhas /tmp/w3d_f8_rev/nivel/borrado.w3d project.json Tronco 0
entryhas /tmp/w3d_f8_rev/nivel/borrado.w3d project.json Sensor 0
entryhas /tmp/w3d_f8_rev/nivel/borrado.w3d project.json personajes/Cuerpo 0
entryhas /tmp/w3d_f8_rev/nivel/borrado.w3d project.json lib:personajes/ 0
simplay 3
scriptinfo shared enemigos 1
simstop
# (borrar el PADRE de un proxy, sin el proxy: el proxy sube con lo suyo; borrar los dos: no queda nada)
prefabadd empty
objname Grupo
libproxy personajes prefab Arbol 6 0 -6
parent Arbol Grupo
selobj Grupo
delete
libproxyinfo Arbol generated 2
prefabnode Arbol Tronco type mesh generated 1
undo
prefabpick Grupo Arbol
delete
fail selobj Tronco
fail selobj Grupo
undo
libproxyinfo Arbol generated 2
# (una INSTANCIA de un prefab del PROYECTO, igual)
prefabenemy /tmp/w3d_f8_rev/pf
prefabinstantiate Enemigo 0 0 -6 times 2
prefablive 2
selobj Enemigo
delete
prefablive 1
undo
prefablive 2
prefabinfo Enemigo generated 4
redo
prefablive 1
savew3d /tmp/w3d_f8_rev/pf/inst.w3d
entryhas /tmp/w3d_f8_rev/pf/inst.w3d project.json Sensor 0
openw3d /tmp/w3d_f8_rev/pf/inst.w3d
prefablive 1
simplay 3
scriptinfo shared enemigos 1
simstop

# --- B) una libreria usada SOLO desde lua viaja con el juego compilado ---
libgamemin /tmp/w3d_f8_rev/sololua /tmp/w3d_f8_rev/lib/personajes.w3d proxies 0
prefablive 0
savew3d /tmp/w3d_f8_rev/sololua/sololua.w3d
entryhas /tmp/w3d_f8_rev/sololua/sololua.w3d project.json "proxy", 0
openw3d /tmp/w3d_f8_rev/sololua/sololua.w3d
simplay 30
scriptinfo shared juez OK
scriptinfo shared enemigos 5
simstop
compilegame 0 0 1
libpath /tmp/w3d_f8_rev/sololua/platform-build/linux/libs/personajes/project.json lee 1
libpath /tmp/w3d_f8_rev/sololua/platform-build/linux/libs/personajes/scripts/enemigo.lua lee 1
libgamelog /tmp/w3d_f8_rev/sololua sololua creados=5 enemigos=5 scope=5 vida=50

# --- C) un nivel cuyo UNICO objeto 3D es un proxy es un juego 3D ---
game3dmin /tmp/w3d_f8_rev/soloproxy
selobj Cubo
delete
selobj CuboAfuera
delete
selobj Camara
delete
liblink /tmp/w3d_f8_rev/lib/personajes.w3d
libproxy personajes prefab Lanzador 0 0 0
savew3d /tmp/w3d_f8_rev/soloproxy/soloproxy.w3d
openw3d /tmp/w3d_f8_rev/soloproxy/soloproxy.w3d
prefablive 1
compilegame 0 0 1
libpath /tmp/w3d_f8_rev/soloproxy/platform-build/linux/project.json lee 1
libpath /tmp/w3d_f8_rev/soloproxy/platform-build/linux/libs/personajes/project.json lee 1

# --- D) los FLIPBOOKS de una libreria no se filtran al nivel ---
scenedefault
fliptex Chispa /tmp/w3d_f8_rev/lib/piel.png
rootnew prefab Cosa
add cube
rootopen Scene
savew3d /tmp/w3d_f8_rev/fx/fx.w3d
entryhas /tmp/w3d_f8_rev/fx/fx.w3d project.json Chispa 1
# (un proyecto NUEVO no hereda los flipbooks del anterior)
scenedefault
fail texrefde flipbook Chispa -
savew3d /tmp/w3d_f8_rev/fx/vacio.w3d
entryhas /tmp/w3d_f8_rev/fx/vacio.w3d project.json Chispa 0
liblink /tmp/w3d_f8_rev/fx/fx.w3d
libproxy fx prefab Cosa 0 0 0
texrefof flipbook fx/Chispa /tmp/w3d_f8_rev/lib/piel.png
savew3d /tmp/w3d_f8_rev/fx/nivel.w3d
entryhas /tmp/w3d_f8_rev/fx/nivel.w3d project.json fx/Chispa 0
entryhas /tmp/w3d_f8_rev/fx/nivel.w3d project.json "flipbooks" 0
openw3d /tmp/w3d_f8_rev/fx/nivel.w3d
texrefof flipbook fx/Chispa /tmp/w3d_f8_rev/lib/piel.png
savew3d /tmp/w3d_f8_rev/fx/nivel2.w3d
entryhas /tmp/w3d_f8_rev/fx/nivel2.w3d project.json fx/Chispa 0

# --- E) DESVINCULAR con mallas de la libreria en el proyecto: cada una pasa a su copia (Ctrl+Z la devuelve) ---
scenedefault
liblink /tmp/w3d_f8_rev/lib/personajes.w3d
outview lib:personajes
add cube
selobj Cubo.001
propstab 3
outrelease Tronco props mesh
meshcheck Cubo.001 resource personajes/Tronco
libunlink personajes
libinfo personajes linked 0
meshcheck Cubo.001 resource Tronco
undo
libinfo personajes linked 1
meshcheck Cubo.001 resource personajes/Tronco
redo
meshcheck Cubo.001 resource Tronco
savew3d /tmp/w3d_f8_rev/nivel/n1.w3d
entryexists /tmp/w3d_f8_rev/nivel/n1.w3d meshes/tronco.w3db 1
openw3d /tmp/w3d_f8_rev/nivel/n1.w3d
meshcheck Cubo.001 resource Tronco
savew3d /tmp/w3d_f8_rev/nivel/n2.w3d
# (una referencia a una libreria que NO ESTA: su archivo falta. El objeto queda vacio pero se guarda sin frenar y con
#  su referencia; vuelve cuando la libreria vuelve: al reabrir, y en la sesion al vincularla otra vez)
scenedefault
liblink /tmp/w3d_f8_rev/lib/personajes.w3d
outview lib:personajes
add cube
selobj Cubo.001
propstab 3
outrelease Tronco props mesh
outview scene
savew3d /tmp/w3d_f8_rev/nivel/ref.w3d
entryhas /tmp/w3d_f8_rev/nivel/ref.w3d project.json personajes/Tronco 1
libmove /tmp/w3d_f8_rev/lib/personajes.w3d /tmp/w3d_f8_rev/lib/personajes.aparte
openw3d /tmp/w3d_f8_rev/nivel/ref.w3d
libinfo personajes linked 1
savew3d /tmp/w3d_f8_rev/nivel/ref2.w3d
entryhas /tmp/w3d_f8_rev/nivel/ref2.w3d project.json personajes/Tronco 1
entryexists /tmp/w3d_f8_rev/nivel/ref2.w3d meshes/tronco.w3db 0
w3dequal /tmp/w3d_f8_rev/nivel/ref.w3d /tmp/w3d_f8_rev/nivel/ref2.w3d
libmove /tmp/w3d_f8_rev/lib/personajes.aparte /tmp/w3d_f8_rev/lib/personajes.w3d
openw3d /tmp/w3d_f8_rev/nivel/ref2.w3d
meshcheck Cubo.001 resource personajes/Tronco
# (en la sesion: falta al abrir, vuelve el archivo, desvincular + vincular la resuelve)
libmove /tmp/w3d_f8_rev/lib/personajes.w3d /tmp/w3d_f8_rev/lib/personajes.aparte
openw3d /tmp/w3d_f8_rev/nivel/ref2.w3d
libmove /tmp/w3d_f8_rev/lib/personajes.aparte /tmp/w3d_f8_rev/lib/personajes.w3d
libunlink personajes
liblink /tmp/w3d_f8_rev/lib/personajes.w3d
meshcheck Cubo.001 resource personajes/Tronco
# (el ANIMSET de una libreria que no esta, en un esqueleto del PROYECTO: sin clips, se guarda sin frenar con su
#  referencia, y vuelve con la libreria)
prefabenemy /tmp/w3d_f8_rev/anim
liblink /tmp/w3d_f8_rev/lib/personajes.w3d
prefabinstantiate Enemigo 0 0 0
prefabunpack Enemigo
savew3d /tmp/w3d_f8_rev/anim/a.w3d
animsetpoint /tmp/w3d_f8_rev/anim/a.w3d /tmp/w3d_f8_rev/anim/b.w3d Esqueleto personajes/Esqueleto
openw3d /tmp/w3d_f8_rev/anim/b.w3d
animsetarm Esqueleto animset personajes/Esqueleto clips 2 notloaded 0
libmove /tmp/w3d_f8_rev/lib/personajes.w3d /tmp/w3d_f8_rev/lib/personajes.aparte
openw3d /tmp/w3d_f8_rev/anim/b.w3d
animsetarm Esqueleto clips 0 notloaded 0
savew3d /tmp/w3d_f8_rev/anim/b2.w3d
entryhas /tmp/w3d_f8_rev/anim/b2.w3d project.json personajes/Esqueleto 1
libmove /tmp/w3d_f8_rev/lib/personajes.aparte /tmp/w3d_f8_rev/lib/personajes.w3d
openw3d /tmp/w3d_f8_rev/anim/b2.w3d
animsetarm Esqueleto animset personajes/Esqueleto clips 2 notloaded 0
