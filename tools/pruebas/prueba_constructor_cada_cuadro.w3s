# ==========================================================================
#  CONSTRUCTOR / CADA CUADRO
#  Lo de ADENTRO del Constructor corre UNA vez al empezar el juego (en el editor corre en cada cuadro solo porque la
#  interfaz pisa su estado). Limpiar la pantalla es de CADA cuadro: va AFUERA del constructor, justo despues y antes
#  de la coleccion. En el outliner los separa una linea negra de 3 pixeles (no es una fila: corre las de abajo).
#  Un proyecto de antes con la limpieza ADENTRO del constructor la saca afuera al abrirse.
# ==========================================================================
scenedefault
children - : Constructor | Limpiar pantalla | Colección
children Constructor :

# ---- el outliner: la linea va arriba de "Limpiar pantalla" (la fila 1) y los clicks caen en la fila de abajo ----
scenerow 0 Constructor
scenerow 1 Limpiar pantalla
scenerow 2 Colección
outcuts 1
sceneclick name Limpiar pantalla
checkactive Limpiar pantalla
sceneclick name Colección
checkactive Colección
sceneclick name Cubo
checkactive Cubo
sceneclick name Constructor
checkactive Constructor
# con el Constructor oculto (menu del ojo) no hay linea; con las demas rutinas ocultas va arriba de la coleccion
outshow 0 1
outcuts -
outshow 1 0
outcuts 1
scenerow 1 Colección
sceneclick name Colección
checkactive Colección
outshow 1 1

# ---- un proyecto de ANTES: la limpieza adentro del constructor (y otra rutina que si es de una vez) ----
routine Viejo Constructor
routinestep Viejo clear
routine Una Constructor
routinestep Una pointSize n0=2
children Constructor : Viejo | Una
savew3d /tmp/w3d_constructor_cada_cuadro.w3d
openw3d /tmp/w3d_constructor_cada_cuadro.w3d
# la que limpia sale afuera, pegada al constructor; la otra se queda adentro
children - : Constructor | Viejo | Limpiar pantalla | Colección
children Constructor : Una
# (y se guarda asi)
savew3d /tmp/w3d_constructor_cada_cuadro_2.w3d
openw3d /tmp/w3d_constructor_cada_cuadro_2.w3d
children - : Constructor | Viejo | Limpiar pantalla | Colección
children Constructor : Una

# ---- el modo SOLO JUEGO: lo de adentro del constructor corre UNA vez; limpiar, en cada cuadro ----
routineprofile on
gamepure
drawframe
drawframe
drawframe
drawframe
routineprofile
routineprofile es pointSize 1
routineprofile es clear 8
# (cover y de vuelta con la UI)
gamepure
gamepure
