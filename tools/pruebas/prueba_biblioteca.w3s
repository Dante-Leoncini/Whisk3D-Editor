# prueba_biblioteca.w3s — FASE 4b: el outliner es la BIBLIOTECA (el explorador del .w3d)
#
#  Criterios de aceptacion:
#   - UN SOLO arbol de carpetas cosmeticas que MEZCLA todos los tipos (mallas, materiales, texturas,
#     animaciones...) + el FILTRO por tipo (no esconde carpetas); LINEAS GUIA de la jerarquia; el color
#     de una CARPETA elegida (activa / seleccionada) se ve como el de un recurso;
#   - elegir un recurso o una carpeta DESELECCIONA los objetos de la escena, y elegir un objeto suelta el
#     recurso;
#   - RENOMBRAR EN LINEA con doble click / doble tap / F2, en las dos vistas: Enter confirma, Esc cancela,
#     un click afuera confirma;
#   - la barra: [1] la vista (el ojo), [2] Objeto (escena: Delete, Rename, Move, Hide/Show, Duplicate,
#     Duplicate Linked; biblioteca: Delete, Rename, Move to Folder, Duplicate Resource, Select Users),
#     [3] Seleccion (todo / nada / invertir), [4] el UNICO "+" (escena, juego, prefab, carpeta, material);
#   - TACTIL: un toque elige (arrastrar con el dedo es scroll), la pulsacion larga AGARRA la fila (con
#     su marca), soltarla sin mover abre el menu contextual y moverla la lleva a una carpeta (en la
#     biblioteca) o la emparenta con otro objeto (en la escena);
#   - la CUADRICULA: celdas con MINIATURAS perezosas (textura, material, malla); no van al .w3d;
#   - los .w3d de la fase anterior (carpetas POR TIPO) se MIGRAN al arbol unico al abrir.
window 1280 720

# ---- 0) un proyecto con recursos de varios tipos ----
scenedefault
selobj Cubo
matnew
matloose Piel
objtexture Cubo dosmats.png
animsetsynthetic 1 add
savew3d prueba_biblioteca_v4.w3d
openw3d prueba_biblioteca_v4.w3d
meshesresource n 1

# ---- A) UN arbol que mezcla los tipos; el FILTRO; las LINEAS GUIA ----
outview library
foldernew - Arte
recmove materials Piel Arte
recmove meshes Cubo Arte
recmove textures textures/dosmats.png Arte
outrow Arte prof 0
outrow Piel folder Arte prof 1 type materials
outrow Cubo folder Arte prof 1 type meshes
outrow dosmats.png folder Arte prof 1 type textures
outrow Personaje prof 0 type animations
outrow Material prof 0 type materials
# la linea guia de la carpeta Arte, a la izquierda de sus hijos (en la raiz no hay)
outline Piel 0 si
outline Material 0 no
# el filtro: solo materiales (la carpeta sigue: el arbol es uno)
outfilter materials
outrow Arte
outrow Piel folder Arte
outnorow dosmats.png
outnorow Personaje
outfilter all
outrow Personaje
outrow dosmats.png

# ---- B) el COLOR de lo elegido: una carpeta activa / seleccionada se ve igual que un recurso ----
outclick Arte
outcolor Arte active
outclick Piel ctrl
outcolor Piel active
outcolor Arte selection
outcolor Material normal
outclick Material
outcolor Arte normal

# ---- C) o se eligen OBJETOS o se eligen RECURSOS ----
selobj Cubo
selection n 1 has Cubo
outclick Personaje
recactive animations Personaje
selection n 0
selobj Cubo
outclick Arte
selection n 0
recactive none
outclick Piel
recactive materials Piel
outview scene
outclick Cubo
selection n 1 has Cubo
recactive none

# ---- D) RENOMBRAR EN LINEA (doble click / doble tap / F2), en las dos vistas ----
# la escena: doble click + Enter
outdoubleclick Cubo
outwrite Caja
selection n 1 has Caja
undo
selection n 1 has Cubo
redo
# Esc cancela
outdoubleclick Caja
outtype Otro
outesc
selection n 1 has Caja
# el doble TAP del dedo
outtap Caja double
outwrite Bloque
selection n 1 has Bloque
# F2
outkeypc f2
outwrite Caja
selection n 1 has Caja
# un click AFUERA (en otra fila) confirma lo tipeado
outdoubleclick Caja
outtype Caja2
outclick Luz
outrender
selection n 1 has Luz
outclick Caja2
outkeypc f2
outwrite Caja
selection n 1 has Caja
# la biblioteca: doble click / doble tap / F2
outview library
outdoubleclick Piel
outwrite Cuero
resource materials Cuero exists 1 folder Arte
undo
resource materials Piel exists 1
redo
outtap Cuero double
outtype Nada
outesc
resource materials Cuero exists 1
resource materials Nada exists 0
# una CARPETA tambien
outdoubleclick Arte
outwrite Arte2D
folders n 1 has Arte2D
resource materials Cuero folder Arte2D
# un click AFUERA confirma
outdoubleclick Arte2D
outtype Arte
outclick Material
folders n 1 has Arte

# ---- E) TACTIL: el toque elige sin armar arrastre; la pulsacion larga agarra ----
outtap Material
recactive materials Material
outkeep Material release
outkeep Material move Arte
resource materials Material folder Arte
undo
resource materials Material folder -
outview scene
outtap Caja
selection n 1 has Caja
outkeep Caja release
# en la ESCENA, llevar lo agarrado al medio de otra fila lo EMPARENTA (como el arrastre del mouse), con undo
outkeep Caja move Luz
objrel Caja parent Luz
objrel Luz children 1
undo
objrel Luz children 0
fail objrel Caja padre Luz

# ---- F) los MENUS de la barra ----
# la escena: Objeto
outclick Caja
outmenu Duplicate
selection n 1 has Caja.001
# (Shift+D: una malla 3D NUEVA, nombrada como la del original)
meshcheck Caja.001 resource Cubo.001 users 1
outmenu Duplicate Linked
selection n 1 has Caja.002
# (Alt+D: la MISMA malla 3D)
meshcheck Caja.002 resource Cubo.001 users 2
outmenu Hide/Show
objvis Caja.002 0
undo
objvis Caja.002 1
meshesresource n 2
# Seleccion: todo / nada / invertir
outmenu Deselect All
selection n 0
outmenu Select All
outmenu Invert Selection
selection n 0
outclick Caja
outmenu Invert Selection
selection hasnot Caja has Caja.001 has Caja.002
# la biblioteca: Objeto, Seleccion y el "+"
outview library
outclick Cuero
outmenu Duplicate Resource
resource materials Cuero.001 exists 1 folder Arte users 0
fail outmenu Select Users
outmenu New Material
recactive materials Material.001
outmenu New Folder
outwrite Nueva
folders n 2 has Arte has Arte/Nueva
outmenu Select All
outsel n 11
outmenu Invert Selection
outsel n 0

# ---- G) la CUADRICULA: miniaturas perezosas; la seleccion y el rename andan igual ----
outgrid 1
# una carpeta a la vez: en la raiz se ve la carpeta Arte (no lo de adentro) y no hay "Ir atras"
outrow Arte
outnorow dosmats.png
outnorow back
outmini Personaje no
# doble click en la carpeta: se entra (se ve solo lo de adentro y la celda "Ir atras")
outdoubleclick Arte
outrow back
outnorow Personaje
outmini dosmats.png si vividcolor
outmini Cuero si vividcolor
outmini Cubo si vividcolor
# "Ir atras" sube a la raiz; y se vuelve a entrar
outclick back
outrow Personaje
outnorow Cuero
outdoubleclick Arte
outclick Cuero
recactive materials Cuero
outdoubleclick Cuero
outwrite Pelaje
resource materials Pelaje exists 1
outrender
savew3d prueba_biblioteca_rt1.w3d
zipentry prueba_biblioteca_rt1.w3d miniaturas no
outgrid 0
openw3d prueba_biblioteca_rt1.w3d
folders n 2 has Arte has Arte/Nueva
resource materials Pelaje folder Arte
resource meshes Cubo folder Arte
resource textures textures/dosmats.png folder Arte
savew3d prueba_biblioteca_rt2.w3d
w3dequal prueba_biblioteca_rt1.w3d prueba_biblioteca_rt2.w3d

# ---- H) MIGRACION: un .w3d de la fase anterior (un arbol de carpetas POR TIPO) ----
openw3d prueba_biblioteca_carpetas_f4.w3d
folders n 4 has Viejos has Rocas has Rocas/Grandes has Fondos
resource materials Piel folder Viejos
resource meshes Cubo folder Rocas/Grandes
resource textures textures/dosmats.png folder Fondos
savew3d prueba_biblioteca_rt3.w3d
openw3d prueba_biblioteca_rt3.w3d
folders n 4 has Viejos has Rocas/Grandes has Fondos
resource meshes Cubo folder Rocas/Grandes

# ---- lo que no tiene que pasar ----
fail outfiltro cualquiera
fail outmini NoExiste
