# prueba_outliner_texturas.w3s — FASE 4: las TEXTURAS del outliner por recursos (renombrar la entrada,
# purgar una CARGADA en caliente y lo purgado que vuelve con un undo) y los nombres de recurso que
# tienen FORMA de entrada del contenedor
#
#  Criterios de aceptacion:
#   - una textura del proyecto se RENOMBRA (F2 / Name): su entrada del contenedor cambia de nombre
#     (misma carpeta y extension, nombre de entrada valido, unico) y la siguen TODOS los que la
#     nombran: materiales, particulas, flipbooks, la carpeta cosmetica, el recurso activo. Con undo.
#     Guardar deja la entrada nueva y NO la vieja;
#   - una textura CARGADA que nadie usa se purga en caliente: sale de la GPU y de las listas sin
#     esperar a guardar y reabrir; el objeto queda en un cementerio (ningun puntero colgado);
#   - si un undo vuelve a poner en uso un material purgado que la usaba, el material vuelve y la
#     textura se RECARGA (y el guardado la lleva);
#   - el atlas de un flipbook y el icono de un boton 2D cuentan como usuarios (no se purgan);
#   - un material / malla / animset / objeto que se LLAMA como una entrada ("texturas/piedra",
#     "mallas/rocas"...) no frena el guardado; vuelve igual y re-guardar da los mismos bytes.
window 1280 720

# ---- 0) una textura con TRES usuarios (material, particulas, flipbook) y una huerfana importada ----
scenedefault
selobj Cubo
matnew
objtexture Cubo dosmats.png
pairtex Humo dosmats.png
savew3d prueba_outliner_texturas_v4.w3d
openw3d prueba_outliner_texturas_v4.w3d
fliptex Llamas textures/dosmats.png
texentry dosmats-b.png
outview textures
outrow dosmats.png users 3 state use
outrow dosmats-b.png users 0 state huerfano
texrefof particle Humo textures/dosmats.png

# ---- A) RENOMBRAR una textura en uso (F2 en linea): la entrada y todos los que la nombran ----
recmove textures textures/dosmats.png UI
outclick dosmats.png
recactive textures textures/dosmats.png
outkeypc f2
outwrite Madera
resource textures textures/madera.png exists 1 users 3 folder UI
resource textures textures/dosmats.png exists 0
texloaded textures/madera.png 1
texloaded textures/dosmats.png 0
texrefof particle Humo textures/madera.png
texrefof flipbook Llamas textures/madera.png
recactive textures textures/madera.png
outrow madera.png cursor 1 folder UI
undo
resource textures textures/dosmats.png exists 1 users 3 folder UI
resource textures textures/madera.png exists 0
texrefof particle Humo textures/dosmats.png
texloaded textures/dosmats.png 1
redo
resource textures textures/madera.png users 3
texrefof flipbook Llamas textures/madera.png
# una HUERFANA importada en la sesion (vive en el overlay): desde el campo Name de Properties
outclick dosmats-b.png
recprops tab 1 name dosmats-b.png
recedit name Cielo Nublado
resource textures textures/cielo_nublado.png exists 1 users 0
resource textures textures/dosmats-b.png exists 0
# a un nombre TOMADO: queda unico ("-2", como las importadas)
recrename textures textures/madera.png cielo_nublado.png textures/cielo_nublado-2.png
undo
resource textures textures/madera.png exists 1 users 3
# (Esc descarta tambien aca)
outclick madera.png
outkeypc f2
outtype Otra
outesc
resource textures textures/madera.png exists 1
outrender

# ---- B) guardar y reabrir: la entrada NUEVA esta, la vieja no; todos la siguen nombrando ----
savew3d prueba_outliner_texturas_rt1.w3d
zipentry prueba_outliner_texturas_rt1.w3d textures/madera.png
zipentry prueba_outliner_texturas_rt1.w3d textures/dosmats.png no
zipentry prueba_outliner_texturas_rt1.w3d textures/cielo_nublado.png
zipentry prueba_outliner_texturas_rt1.w3d textures/dosmats-b.png no
openw3d prueba_outliner_texturas_rt1.w3d
resource textures textures/madera.png users 3 folder UI
resource textures textures/cielo_nublado.png users 0
texrefof particle Humo textures/madera.png
texrefof flipbook Llamas textures/madera.png
savew3d prueba_outliner_texturas_rt2.w3d
w3dequal prueba_outliner_texturas_rt1.w3d prueba_outliner_texturas_rt2.w3d

# ---- C) PURGAR EN CALIENTE una textura CARGADA que nadie usa ----
# (queda cargada: el material la usaba y paso a usar otra)
objtexture Cubo textures/cielo_nublado.png
objtexture Cubo textures/madera.png
texloaded textures/cielo_nublado.png 1
outview textures
outrow cielo_nublado.png users 0 state huerfano
outclick cielo_nublado.png
recprops tab 1 preview 1
outkeypc supr
outconfirm si
outnorow cielo_nublado.png
texloaded textures/cielo_nublado.png 0
texpurged n 1
recactive none
# una EN USO no se purga (y el flipbook cuenta: sin el, la textura seguiria en uso por el material)
recdelete textures textures/madera.png fails
outrender
savew3d prueba_outliner_texturas_rt3.w3d
zipentry prueba_outliner_texturas_rt3.w3d textures/cielo_nublado.png no
zipentry prueba_outliner_texturas_rt3.w3d textures/madera.png
openw3d prueba_outliner_texturas_rt3.w3d
texpurged n 0

# ---- D) LO PURGADO QUE VUELVE: un undo re-asigna el material purgado, y con el su textura ----
texentry dosmats-b.png
matloose Piedra
meshmaterial Cubo 0 Piedra
objtexture Cubo textures/dosmats-b.png
meshmaterial Cubo 0 Material
outview materials
outrow Piedra state huerfano
recdelete materials Piedra
outview textures
resource textures textures/dosmats-b.png users 0
recdelete textures textures/dosmats-b.png
texloaded textures/dosmats-b.png 0
texpurged n 1
outnorow dosmats-b.png
# el undo de "mallamaterial Cubo 0 Material": Piedra vuelve a la malla -> vuelve a su lista y su
# textura se recarga en el MISMO objeto (los punteros viejos siguen valiendo)
undo
resource materials Piedra exists 1 users 1
texloaded textures/dosmats-b.png 1
texpurged n 0
resource textures textures/dosmats-b.png users 1
outrow dosmats-b.png state use
savew3d prueba_outliner_texturas_rt4.w3d
zipentry prueba_outliner_texturas_rt4.w3d textures/dosmats-b.png

# ---- E) NOMBRES con forma de ENTRADA: el guardado no los toma por entradas que faltan ----
animsetsynthetic 1 add
savew3d prueba_outliner_texturas_rt5.w3d
openw3d prueba_outliner_texturas_rt5.w3d
recrename materials Piedra textures/piedra textures/piedra
recrename meshes Cubo meshes/rocas meshes/rocas
recrename animations Personaje animations/heroe animations/heroe
selobj Cubo
objname scripts/jefe
savew3d prueba_outliner_texturas_rt6.w3d
jsonhas prueba_outliner_texturas_rt6.w3d "textures/piedra"
jsonhas prueba_outliner_texturas_rt6.w3d "meshes/rocas"
openw3d prueba_outliner_texturas_rt6.w3d
resource materials textures/piedra exists 1 users 1
resource meshes meshes/rocas exists 1 users 1
resource animations animations/heroe exists 1 users 1
selobj scripts/jefe
savew3d prueba_outliner_texturas_rt7.w3d
w3dequal prueba_outliner_texturas_rt6.w3d prueba_outliner_texturas_rt7.w3d

# ---- lo que no tiene que pasar ----
fail texrefde particula NoExiste
fail recrenombrar textures textures/noexiste.png Algo
