# ==========================================================================
#  ESCENAS / JUEGOS / PREFABS: los BORDES que encontro la revision de la fase 6.
#  Correr DESDE ESTA CARPETA:
#    ../../platform/linux/build/whisk3d --script prueba_escenas_bordes.w3s
#
#  Se prueba:
#    A) borrar la escena del BLOQUE cuando lo que queda es un JUEGO: el juego pasa a ser la del
#       bloque (no aparece una escena "Scene" fantasma al reabrir ni sus objetos repetidos, y el
#       juego compilado arranca en el juego);
#    B) un prefab creado ANTES que una escena: el registro queda en el orden del proyecto y
#       re-guardar sin cambios da los mismos bytes;
#    C) guardar no deja cargadas las escenas que no se abrieron (carga perezosa): el guardado las
#       carga para escribirlas y las vuelve a soltar; la que se abrio sigue cargada;
#    D) borrar una escena desde la vista Scenes del outliner tiene Ctrl+Z / Ctrl+Y (vuelve con sus
#       objetos, en su lugar) y el cartel dice que se borra una escena con sus objetos (no un
#       "recurso huerfano"); tambien la del bloque (al deshacer vuelve a serlo).
# ==========================================================================

window 1280 720

# ==== A) borrar la escena del bloque: queda un juego ====
scenedefault
add cube
objname CuboEscena
rootnew game Nivel
add cube
objname CuboJuego
rootdelete Scene
rootinfo n 1 block Nivel type game
savew3d /tmp/w3d_f6_rbordes/a.w3d
entryexists /tmp/w3d_f6_rbordes/a.w3d scenes/nivel.w3de 0
openw3d /tmp/w3d_f6_rbordes/a.w3d
rootinfo n 1 active Nivel block Nivel type game initial -
rootinfo objects 1
objat CuboJuego 0 0 0 0.001
# re-guardar sin cambios: los mismos bytes
savew3d /tmp/w3d_f6_rbordes/a2.w3d
w3dequal /tmp/w3d_f6_rbordes/a.w3d /tmp/w3d_f6_rbordes/a2.w3d
# ...y si la inicial era el juego que pasa a ser la del bloque, no queda nombrada dos veces
scenedefault
rootnew game Nivel
rootinitial Nivel
rootopen Nivel
rootdelete Scene
rootinfo n 1 block Nivel initial -

# ==== B) un prefab antes que una escena: el orden del proyecto ====
scenedefault
rootnew prefab Enemigo
add cube
objname Cuerpo
rootnew scene Intro
add cube
objname Caja
savew3d /tmp/w3d_f6_rbordes/b.w3d
openw3d /tmp/w3d_f6_rbordes/b.w3d
savew3d /tmp/w3d_f6_rbordes/b2.w3d
w3dequal /tmp/w3d_f6_rbordes/b.w3d /tmp/w3d_f6_rbordes/b2.w3d

# ==== C) el guardado no deja cargado lo que no se abrio ====
scenedefault
rootmenu 3d New Scene
add cube
objname CajaB
rootmenu 3d New Scene
add cube
objname CajaC
rootopen Scene
savew3d /tmp/w3d_f6_rbordes/c.w3d
openw3d /tmp/w3d_f6_rbordes/c.w3d
rootinfo loaded Scene.001 0 loaded Scene.002 0
savew3d /tmp/w3d_f6_rbordes/c2.w3d
rootinfo loaded Scene.001 0 loaded Scene.002 0
w3dequal /tmp/w3d_f6_rbordes/c.w3d /tmp/w3d_f6_rbordes/c2.w3d
# la que se abre queda cargada; la que se vuelve a leer de su entrada nueva esta entera
rootopen Scene.001
rootinfo objects 1
objat CajaB 0 0 0 0.001
rootopen Scene
savew3d /tmp/w3d_f6_rbordes/c3.w3d
rootinfo loaded Scene.001 1 loaded Scene.002 0
rootopen Scene.002
objat CajaC 0 0 0 0.001

# ==== D) borrar una escena desde la vista Scenes: con Ctrl+Z ====
scenedefault
rootmenu 3d New Scene
add cube
objname CajaB
add cube
objname CajaB2
rootmenu 3d New Prefab
rootopen Scene
outview scenes
outclick Scene.001
outkeypc supr
outconfirm si no Delete the orphan resource
rootinfo n 2
undo
rootinfo n 3 loaded Scene.001 1
redo
rootinfo n 2
undo
rootopen Scene.001
rootinfo objects 2
objat CajaB2 0 0 0 0.001
rootopen Scene
# (el registro del modelo, sin UI: borrar y deshacer la del BLOQUE desde otra raiz)
rootopen Scene.001
outview scenes
recdelete scenes Scene
rootinfo n 2 block Scene.001
undo
rootinfo n 3 block Scene
savew3d /tmp/w3d_f6_rbordes/d.w3d
openw3d /tmp/w3d_f6_rbordes/d.w3d
rootinfo n 3 block Scene
rootopen Scene.001
objat CajaB2 0 0 0 0.001
# borrada y guardada: no va al archivo; el Ctrl+Z (despues del guardado) la devuelve de memoria y el
# guardado siguiente la vuelve a escribir entera
rootopen Scene
outview scenes
recdelete scenes Scene.001
rootinfo n 2
savew3d /tmp/w3d_f6_rbordes/e.w3d
entryexists /tmp/w3d_f6_rbordes/e.w3d scenes/scene.001.w3de 0
undo
rootinfo n 3
savew3d /tmp/w3d_f6_rbordes/e2.w3d
entryexists /tmp/w3d_f6_rbordes/e2.w3d scenes/scene.001.w3de 1
openw3d /tmp/w3d_f6_rbordes/e2.w3d
rootinfo n 3
rootopen Scene.001
objat CajaB2 0 0 0 0.001
# el paso de undo se queda con el arbol de la escena borrada: cerrar el proyecto con el adentro lo libera
rootopen Scene
outview scenes
recdelete scenes Scene.001
rootinfo n 2
scenedefault
rootinfo n 1
