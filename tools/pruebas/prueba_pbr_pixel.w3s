# ==========================================================================
#  METALICO, RUGOSIDAD Y TRANSMISION EN LA LUZ POR PIXEL (shaders)
#  Correr DESDE ESTA CARPETA, con el backend de shaders:
#    cd <motor>/tools/pruebas
#    ../../platform/linux/build/whisk3d --backend es2 --script prueba_pbr_pixel.w3s
#  (con OpenGL, el pipeline fijo, la prueba termina en 'sombreadopixel': ahi no hay luz por pixel)
#
#  Los valores PBR del material (los del trazado de rayos) tambien mandan en la Vista 3D con shaders (GLES2,
#  WebGL, Vulkan): el METALICO apaga el difuso (sin entorno que reflejar, un metal queda oscuro con su brillo)
#  y la TRANSMISION deja ver lo de atras (el vidrio casi no tapa el fondo). Antes la transmision y el IOR solo
#  existian para el trazado de rayos.
# ==========================================================================

window 640 480
pixelshading
scenedefault
selobj Cubo
objpos 0 0 -40
add uvsphere
matnew
view3d shading 1
view3d gizmo 0
tick
uishot /tmp/w3d_pbr_base.png
pngpx /tmp/w3d_pbr_base.png 200 230 203 203 203 - 40
matrt 0.15 1
tick
uishot /tmp/w3d_pbr_metal.png
pngpx /tmp/w3d_pbr_metal.png 200 230 38 38 38 - 25
matrt 0.1 0
mattrans 1
tick
uishot /tmp/w3d_pbr_vidrio.png
pngpx /tmp/w3d_pbr_vidrio.png 200 230 21 21 21 - 15
