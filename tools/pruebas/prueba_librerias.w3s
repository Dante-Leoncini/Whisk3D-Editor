# ==========================================================================
#  LIBRERIAS EXTERNAS + PROXIES W3D (io/Librerias.h, objects/ProxyW3d.h)
#  Correr DESDE ESTA CARPETA:
#    ../../platform/linux/build/whisk3d --script prueba_librerias.w3s
#
#  La libreria "personajes" (libcrear): el prefab "Enemigo" (Esqueleto con dos clips + Cuerpo
#  skinneado con el material "Piel" CON TEXTURA + Sensor + enemigo.lua), el prefab "Arbol" y la
#  escena "Decorado" (dos cubos que comparten una malla). Un nivel en OTRA carpeta la vincula:
#    A) montaje + 20 proxies del Enemigo: comparten UNA malla, UN animset, UN material y UNA
#       textura (todos de la libreria, con su prefijo, fuera de la biblioteca del proyecto), cada
#       uno con su pose y su scope; las rutas "lib:" se leen de la libreria; lo generado no se edita
#       (el outliner le pone el CANDADO; Properties no muestra las filas que editan su malla -partes,
#       grupos, mapas UV, capas, modificadores- y sus acciones no hacen nada);
#    B) guardar: el proxy es un nodo ({"tipo": "proxy", libreria, elemento}) y NADA de la libreria
#       entra al nivel (ni sus mallas, ni su material, ni su textura, ni su script); abrir lo
#       regenera igual; re-guardar da los mismos bytes;
#    C) la libreria CAMBIA en disco (su prefab gana un "Casco"): reabrir el nivel lo muestra;
#    D) un proxy de una ESCENA de la libreria; Add > Proxy W3D y Add > Prefab con los de la libreria;
#       cambiar el elemento (con Ctrl+Z) desde la tarjeta de Properties (soltar sobre su selector);
#    E) arrastrar desde la vista de la libreria (outliner): prefab = proxy, malla / material /
#       textura = una REFERENCIA al recurso de la libreria (no se copia al guardar);
#    F) DOS librerias con las mismas entradas y los mismos nombres adentro no chocan;
#    G) desvincular (con Ctrl+Z): sus proxies se regeneran VACIOS (como al reabrir sin ella) y Ctrl+Z / Ctrl+Y
#       los devuelve;
#    H) un script DE LA LIBRERIA (el del prefab "Lanzador") hace instanciar("Arbol"): es el Arbol de SU
#       libreria (un proxy), aunque el proyecto no tenga ningun prefab con ese nombre.
# ==========================================================================

window 1280 720
libcreate /tmp/w3d_f8_lib/lib personajes.w3d dosmats.png
libcreate /tmp/w3d_f8_lib/otra otros.w3d dosmats-b.png

# --- A) el nivel vincula la libreria: 20 proxies que comparten todo ---
scenedefault
libinfo personajes linked 0 mounted 0
liblink /tmp/w3d_f8_lib/lib/personajes.w3d
libinfo personajes linked 1 prefabs 3 scenes 2
libinfo personajes mounted 1
libproxy personajes prefab Enemigo 0 0 -6 times 20
prefablive 20
libproxyinfo Enemigo lib personajes element Enemigo type prefab generated 4 empty 0
prefabnode Enemigo.013 . name Enemigo generated 1
prefabnode Enemigo.013 Esqueleto/Cuerpo type mesh
libshared personajes prefab Enemigo proxies 20 meshes 1 animsets 1 materials 1 textures 1
prefabshared lib:personajes/prefab/Enemigo instances 20 meshes 1 animsets 1
prefabskin Enemigo.007
prefabscope Enemigo.003 Esqueleto Cuerpo Enemigo.003
prefabclip Enemigo.001 Esqueleto Quieto
prefabclip Enemigo.002 Esqueleto Saludo
prefabpose Enemigo.001 Enemigo.002 10 distinct
libresource mesh personajes/Cuerpo exists 1 lib personajes library 0
libresource material personajes/Piel exists 1 lib personajes library 0
libresource animset personajes/Esqueleto exists 1 lib personajes library 0
libresource texture lib:personajes/textures/piel.png exists 1 lib personajes library 0
libpath lib:personajes/project.json lee 1 exists 1
libpath lib:personajes/textures/piel.png lee 1 exists 1
libpath lib:personajes/noexiste.png lee 0 exists 0
libpath lib:noesta/textures/piel.png lee 0 exists 0
libedit Enemigo.004 Esqueleto/Cuerpo
# (Properties: el material de lo generado es de SOLO LECTURA; el proxy muestra su tarjeta con libreria y elemento)
prefabsel Enemigo.006 Esqueleto/Cuerpo
libpropsmat lectura 1
selobj Enemigo.006
libpropsmat card proxy
# (el outliner: lo generado por un proxy lleva el CANDADO; el proxy no)
libmark Enemigo.006 Esqueleto/Cuerpo lock
libmark Enemigo.006 . lock
libmark Enemigo.006 proxy -
# (Properties: las filas que editan la malla generada no estan y sus acciones no hacen nada)
prefabsel Enemigo.006 Esqueleto/Cuerpo
libpropsmesh 2 lectura 1 try
libpropsmesh 3 lectura 1 try
libpropsmesh 4 lectura 1 try
# (lo generado no se borra ni se duplica: es de solo lectura)
prefabsel Enemigo.005 Esqueleto/Cuerpo
delete
prefablive 20
libproxyinfo Enemigo.005 generated 4

# --- B) guardar / abrir: el proxy es un nodo; la libreria no entra al nivel ---
savew3d /tmp/w3d_f8_lib/nivel/nivel.w3d
entryhas /tmp/w3d_f8_lib/nivel/nivel.w3d project.json "proxy", 1
entryhas /tmp/w3d_f8_lib/nivel/nivel.w3d project.json "lib": 1
entryhas /tmp/w3d_f8_lib/nivel/nivel.w3d project.json "libs": 1
entryhas /tmp/w3d_f8_lib/nivel/nivel.w3d project.json ext:../lib/personajes.w3d 1
entryhas /tmp/w3d_f8_lib/nivel/nivel.w3d project.json Esqueleto 0
entryhas /tmp/w3d_f8_lib/nivel/nivel.w3d project.json Piel 0
entryhas /tmp/w3d_f8_lib/nivel/nivel.w3d project.json personajes/Cuerpo 0
entryexists /tmp/w3d_f8_lib/nivel/nivel.w3d textures/piel.png 0
entryexists /tmp/w3d_f8_lib/nivel/nivel.w3d meshes/cuerpo.w3db 0
entryexists /tmp/w3d_f8_lib/nivel/nivel.w3d scripts/enemigo.lua 0
entryexists /tmp/w3d_f8_lib/nivel/nivel.w3d animations/esqueleto.w3da 0
openw3d /tmp/w3d_f8_lib/nivel/nivel.w3d
libinfo personajes linked 1
prefablive 20
libshared personajes prefab Enemigo proxies 20 meshes 1 animsets 1 materials 1 textures 1
prefabskin Enemigo.019
savew3d /tmp/w3d_f8_lib/nivel/nivel2.w3d
openw3d /tmp/w3d_f8_lib/nivel/nivel2.w3d
savew3d /tmp/w3d_f8_lib/nivel/nivel3.w3d
w3dequal /tmp/w3d_f8_lib/nivel/nivel2.w3d /tmp/w3d_f8_lib/nivel/nivel3.w3d

# --- C) la LIBRERIA cambia en disco: reabrir el nivel lo muestra ---
openw3d /tmp/w3d_f8_lib/lib/personajes.w3d
rootopen Enemigo prefab
add cube
objname Casco
parent Casco Esqueleto
rootopen Scene
savew3d /tmp/w3d_f8_lib/lib/personajes.w3d
openw3d /tmp/w3d_f8_lib/nivel/nivel.w3d
prefablive 20
libproxyinfo Enemigo.011 generated 5
prefabnode Enemigo.011 Esqueleto/Casco type mesh generated 1
libshared personajes prefab Enemigo proxies 20 meshes 2 animsets 1

# --- D) una ESCENA de la libreria; Add > Proxy W3D / Add > Prefab; cambiar el elemento con Ctrl+Z ---
scenedefault
liblink /tmp/w3d_f8_lib/lib/personajes.w3d
libproxy personajes scene Decorado 0 0 0
libproxyinfo Decorado type scene element Decorado generated 3
prefabnode Decorado Roca type mesh generated 1
prefabnode Decorado Piedra type mesh generated 1
libshared personajes scene Decorado proxies 1 meshes 1 materials 1
fail libproxy personajes scene NoExiste 0 0 0
libproxy personajes scene NoExiste 0 0 0 fails
undo
prefablive 0
redo
prefablive 1
# Add > Proxy W3D: el explorador elige el .w3d (ya vinculado) y adentro, el elemento
proxyw3d /tmp/w3d_f8_lib/lib/personajes.w3d
fbenter Enemigo
fbaccept
libproxyinfo Enemigo lib personajes element Enemigo generated 5
prefabmenu has personajes/Enemigo has personajes/Arbol
prefabmenupick personajes/Arbol
libproxyinfo Arbol lib personajes element Arbol generated 2
prefablive 3
libchange Arbol personajes prefab Enemigo
libproxyinfo Arbol element Enemigo generated 5
undo
libproxyinfo Arbol element Arbol generated 2
libchange Arbol personajes prefab NoExiste fails
# (soltar un prefab de la libreria sobre el selector de la tarjeta del proxy: pasa a generar ese)
selobj Arbol
propstab 2
outview lib:personajes
outrelease Enemigo props prefab
libproxyinfo Arbol element Enemigo
undo
libproxyinfo Arbol element Arbol

# --- E) ARRASTRAR desde la vista de la libreria: prefab = proxy, recursos = referencias ---
scenedefault
selobj Cubo
matnew
liblink /tmp/w3d_f8_lib/lib/personajes.w3d
outview lib:personajes
outrelease Enemigo 3d 0 0
prefablive 1
libproxyinfo Enemigo lib personajes element Enemigo
undo
prefablive 0
outrelease Cuerpo 3d 0 0
meshcheck Cuerpo resource personajes/Cuerpo
undo
fail selobj Cuerpo
selobj Cubo
libpropsmat lectura 0
outrelease Piel 3d 0 0
meshcheck Cubo material 0 personajes/Piel
libpropsmat lectura 1
undo
meshcheck Cubo material 0 Material
libpropsmat lectura 0
outrelease piel.png 3d 0 0
texrefof material Material lib:personajes/textures/piel.png
add cube
selobj Cubo.001
propstab 3
outrelease Tronco props mesh
meshcheck Cubo.001 resource personajes/Tronco
# (una malla del PROYECTO con una malla de la libreria: lo del recurso es de solo lectura -partes, grupos, mapas-;
#  lo del OBJETO -sus modificadores- es del proyecto)
libpropsmesh 3 lectura 1 try
libpropsmesh 2 lectura 1
libpropsmesh 4 lectura 0
selobj Cubo
libpropsmesh 2 lectura 0
libpropsmesh 3 lectura 0
libpropsmesh 4 lectura 0
savew3d /tmp/w3d_f8_lib/nivel/refs.w3d
entryhas /tmp/w3d_f8_lib/nivel/refs.w3d project.json lib:personajes/textures/piel.png 1
entryhas /tmp/w3d_f8_lib/nivel/refs.w3d project.json personajes/Tronco 1
entryhas /tmp/w3d_f8_lib/nivel/refs.w3d project.json Corteza 0
entryexists /tmp/w3d_f8_lib/nivel/refs.w3d textures/piel.png 0
entryexists /tmp/w3d_f8_lib/nivel/refs.w3d meshes/tronco.w3db 0
openw3d /tmp/w3d_f8_lib/nivel/refs.w3d
meshcheck Cubo.001 resource personajes/Tronco
meshcheck Cubo.001 material 0 personajes/Corteza
texrefof material Material lib:personajes/textures/piel.png
libresource mesh personajes/Tronco exists 1 lib personajes library 0
# (New Copy de una malla de la libreria: la copia es del PROYECTO -sin su prefijo- y se edita; Ctrl+Z vuelve)
meshnew Cubo.001
meshcheck Cubo.001 resource Tronco
selobj Cubo.001
libpropsmesh 3 lectura 0
undo
meshcheck Cubo.001 resource personajes/Tronco

# --- F) DOS librerias con las mismas entradas y los mismos nombres adentro: no chocan ---
scenedefault
liblink /tmp/w3d_f8_lib/lib/personajes.w3d
liblink /tmp/w3d_f8_lib/otra/otros.w3d
libinfo otros linked 1 prefabs 3 count 2
libproxy personajes prefab Enemigo 0 0 0
libproxy otros prefab Enemigo 4 0 0
libdistinct Enemigo Enemigo.001
libshared otros prefab Enemigo proxies 1 meshes 1 animsets 1 materials 1 textures 1
libresource material otros/Piel exists 1 lib otros library 0

# --- G) desvincular (con Ctrl+Z): sus proxies se regeneran VACIOS; Ctrl+Z / Ctrl+Y ---
libunlink otros
libinfo otros linked 0 count 1
libproxyinfo Enemigo.001 lib otros generated 0 empty 1
libproxyinfo Enemigo lib personajes generated 5
undo
libinfo otros linked 1 count 2
libproxyinfo Enemigo.001 lib otros generated 4 empty 0
redo
libproxyinfo Enemigo.001 generated 0 empty 1
undo
libproxyinfo Enemigo.001 generated 4 empty 0

# --- H) un script de la libreria instancia un prefab de SU libreria por su nombre pelado ---
scenedefault
liblink /tmp/w3d_f8_lib/lib/personajes.w3d
libproxy personajes prefab Lanzador 0 0 0
simplay 3
scriptinfo shared lanzado proxy
prefablive 2
simstop
prefablive 1
