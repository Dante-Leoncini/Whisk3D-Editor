solid piramide
  facet normal 0 0 0
    outer loop
      vertex 0 0 0
      vertex 0 1 0
      vertex 1 0 0
    endloop
  endfacet
  facet normal 0 0 0
    outer loop
      vertex 0 0 0
      vertex 1 0 0
      vertex 0 0 2
    endloop
  endfacet
  facet normal 0 0 0
    outer loop
      vertex 1 0 0
      vertex 0 1 0
      vertex 0 0 2
    endloop
  endfacet
  facet normal 0 0 0
    outer loop
      vertex 0 1 0
      vertex 0 0 0
      vertex 0 0 2
    endloop
  endfacet
endsolid piramide
solid suelto
  facet normal 0 0 1
    outer loop
      vertex 3 0 0
      vertex 4 0 0
      vertex 3 1 0
    endloop
  endfacet
endsolid suelto
