# prueba_prop_menu.w3s — el MENU CONTEXTUAL de una propiedad (Properties): click DERECHO con el mouse o el DEDO quieto
#   medio segundo (con el circulo de carga arriba del dedo). Sobre una fila de valor:
#     Restablecer (el valor de fabrica, si se sabe) / Copiar / Pegar
#     ---- (si es animable) Insertar keyframe / Borrar todos los keyframes / Copiar keyframe / Pegar keyframe
ventana 960 540
escala 2
selobj Cubo
propstab 1
objpos 2 0 0
tick
propvalor 2 Location X
# click derecho en la X de la posicion (la fila "Location X"): el menu, con la parte de animacion
propclicder Location X
menuabierto si
menuitem Reset
menuitem Copy
menuitem Paste
menuitem Insert Keyframe
menuitem Delete All Keyframes
menuitem Copy Keyframe
menuitem Paste Keyframe
# copiar el 2, cambiarlo y pegarlo
menuelegir Copy
objpos 5 0 0
tick
propclicder Location X
menuelegir Paste
propvalor 2 Location X
# restablecer: el de fabrica (0), y Ctrl+Z lo devuelve
propclicder Location X
menuelegir Reset
propvalor 0 Location X
undo
tick
propvalor 2 Location X
# KEYFRAMES: insertar en el 1, copiarlo, pegarlo en el 10 y borrarlos todos
frame 1
propclicder Location X
menuelegir Insert Keyframe
canalestado 0 0 2
propclicder Location X
menuelegir Copy Keyframe
frame 10
canalestado 0 0 1
objpos 7 0 0
propclicder Location X
menuelegir Paste Keyframe
canalestado 0 0 2
propvalor 2 Location X
propclicder Location X
menuelegir Delete All Keyframes
canalestado 0 0 0
# EL DEDO: quieto medio segundo sobre la fila abre el mismo menu (y vibra). (Con el panel quieto: un dedo sobre un
# panel que sigue deslizando solo lo FRENA, no es un toque)
propdedo Location X
esperar 200
tick
menuabierto no
esperar 450
tick
menuabierto si
menuitem Copy Keyframe
# soltar el dedo deja el menu abierto (para tocar una opcion); Esc lo cierra
dedo up
menuabierto si
tecla Escape
menuabierto no
# (despues de un dedo, el mouse de verdad se ignora medio segundo: los clicks FANTASMA que sintetizan los navegadores)
esperar 600
# una CASILLA: Visible. Restablecer la vuelve a tildar
propclicder Visible
menuabierto si
menuitem Insert Keyframe
menuelegir Copy
propclic Visible
propvalor 0 Visible
propclicder Visible
menuelegir Reset
propvalor 1 Visible
