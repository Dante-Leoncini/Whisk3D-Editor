# EL PASO "Shader" DE UNA RUTINA (objects/Rutina.cpp: PasoShader): como un estado de GL, prendido hace que los triangulos
# que se dibujan despues usen el shader escrito del archivo; al terminar la rutina se saca solo (lo que se dibuja
# despues, como el cubo de la escena, no lo usa). Solo los backends con shaders (GLES 2.0, Vulkan)
matshader support has
window 1280 720
routine Vidrio
routinestep Vidrio array mode=0 on=1
routinestep Vidrio array mode=1 on=0
routinestep Vidrio array mode=2 on=0
routinestep Vidrio array mode=3 on=0
routinestep Vidrio vertexPointer ref=Cubo
routinestep Vidrio shader ref=../pruebas/shaders/verde.glsl on=1
routinestep Vidrio translate n0=2.5 n1=0 n2=0
routinestep Vidrio draw ref=Cubo
deselectall
vporbit 1.25 0 0 9 -60 0
vpview material
# el cubo que dibuja la rutina (corrido 2.5 en X): con el shader, verde
scenepx 3 1 0.5 es 0 255 0 20
# el cubo de la escena: sin el shader (se saco al terminar la rutina)
scenepx 0.5 1 0.5 noes 0 255 0 40
# el paso apagado: la rutina dibuja sin shader
routineset Vidrio 5 on 0
scenepx 3 1 0.5 noes 0 255 0 40
# GUARDADO: el .glsl del paso entra al .w3d (shaders/) y vuelve al abrir
routineset Vidrio 5 on 1
deletefile prueba_shaders_rutina_tmp.w3d
savew3d prueba_shaders_rutina_tmp.w3d
openw3d prueba_shaders_rutina_tmp.w3d
deselectall
vporbit 1.25 0 0 9 -60 0
vpview material
scenepx 3 1 0.5 es 0 255 0 20
deletefile prueba_shaders_rutina_tmp.w3d
