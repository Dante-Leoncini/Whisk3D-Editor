# LA PANTALLA DE INICIO (ui/ViewPorts/PopUp/InicioPopup.h) y NUEVO PROYECTO (tarjeta Archivo):
#   - el logo (el engranaje que gira y el centro) se carga al abrirla y se LIBERA al cerrarla
#   - abrir y guardar anotan los ARCHIVOS RECIENTES, el mas nuevo primero (config/W3dRecientes.h)
#   - tocar un reciente lo abre (al soltar el dedo) y la cierra; "Nuevo archivo" y el boton "Nuevo proyecto" de la
#     tarjeta Archivo dejan la escena de arranque, sin archivo
#   - con algo SIN GUARDAR, "Nuevo proyecto" pregunta primero (el cartel): cancelar deja todo como estaba
#     (en el harness el cartel no aparece solo: 'cartelprender si' lo pone como en el producto)
#   (el harness empieza con la lista de recientes vacia: /tmp/w3d_prueba_recientes.txt)
window 960 540
scale 2
start open
start texture si
start recent 0
start close
# abrir y guardar anotan los recientes
savew3d ../debug/inicio_a.w3d
savew3d ../debug/inicio_b.w3d
openw3d ../debug/inicio_a.w3d
openw3d ../debug/inicio_b.w3d
start open
start recent 2
start row 1 inicio_b.w3d
start row 2 inicio_a.w3d
# tocar el segundo lo abre y la pantalla se cierra (liberando el logo)
start touch 2
start close
projectpending inicio_a.w3d
start open
start row 1 inicio_a.w3d
# Nuevo archivo: la escena de arranque, sin archivo (con el cartel apagado, como en el harness, lo agregado se va). Con
# layouts guardados (siempre hay uno: el de Animacion viene de fabrica) primero muestra la lista; su fila 0 es el de siempre
add cube
selobj Cubo.001
start touch 0
start touch 0
projectpending nofile
fail selobj Cubo.001
selobj Cubo
start close
# el boton "Nuevo proyecto" de la tarjeta Archivo hace lo mismo (con layouts guardados, un menu: "Default" es el de siempre)
openw3d ../debug/inicio_b.w3d
add cube
propstab 0
propclick New project
menupick Default
projectpending nofile
fail selobj Cubo.001
selobj Cubo
# "Extraer" ahora es de cada recurso (tarjeta Recurso): una COPIA de su archivo de adentro del .w3d a una carpeta
openw3d ../debug/inicio_b.w3d
recextract meshes Cubo ../debug/inicio_extraer
# "Nuevo proyecto" con el cubo agregado SIN GUARDAR: aparece el cartel y no se borra nada hasta elegir
openw3d ../debug/inicio_b.w3d
add cube
dialogshow si
propstab 0
propclick New project
menupick Default
projectpending inicio_b.w3d
selobj Cubo.001
dialogrespond cancel
projectpending inicio_b.w3d
selobj Cubo.001
# otra vez, ahora "seguir sin guardar": la escena de arranque
propclick New project
menupick Default
dialogrespond continue
projectpending nofile
fail selobj Cubo.001
selobj Cubo
# recien creado no hay nada sin guardar: no pregunta
propstab 0
propclick New project
menupick Default
projectpending nofile
dialogshow no
