# Menu ARCHIVO del IDE (y el mismo para las texturas del editor UV): Guardar / Guardar como... / Guardar en el w3d o
# fuera del w3d. Lo que vive ADENTRO se guarda en el .w3d del disco (Guardar guarda tambien el proyecto); "en el w3d"
# y "fuera del w3d" mudan el archivo (las referencias lo siguen).
vpkind 5 7
ideload componente.lua componente.lua
# Guardar como... sin proyecto: solo afuera (una copia en /tmp); el IDE pasa a editar la copia
idefile 2
saveas w3d_prueba_copia.lua 1 /tmp 1
ideinfo /tmp/w3d_prueba_copia.lua
# con un proyecto: Guardar en el w3d -> queda adentro (scripts/) y el proyecto se guarda
savew3d /tmp/w3d_prueba_archivo.w3d
w3dpath /tmp/w3d_prueba_archivo.w3d
idefile 3
ideinfo scripts/w3d_prueba_copia.lua
# Guardar fuera del w3d -> vuelve a un archivo del disco
ideoutside /tmp
ideinfo /tmp/w3d_prueba_copia.lua
# Guardar como... adentro con otro nombre, y Guardar (escribe el .w3d del disco)
idefile 2
saveas w3d_prueba_otro.lua 1 - 1
ideinfo scripts/w3d_prueba_otro.lua
idefile 1
# texturas: Guardar como... afuera, despues en el w3d
add cube
selobj Cubo.001
newtex lienzo 32 32 blank
uvsave 5
saveas w3d_prueba_lienzo.png 0 /tmp 1
texlabel w3d_prueba_lienzo.png
uvsave 3
texlabel w3d_prueba_lienzo.png
# Guardar como... ENCIMA de un .lua que ya existe: el boton Guardar pregunta y con "Si" lo pisa con lo del IDE (que pasa
# a editarlo). Se trababa: IDE::Save lo comparaba con el texto del archivo ANTERIOR, preguntaba "lo cambiaron afuera" y
# no guardaba (y el "Si" de esa segunda pregunta pisaba el archivo de antes)
ideload componente.lua componente.lua
idefile 2
saveas w3d_prueba_pisar.lua 0 /tmp 1
ideload costura_grupo.lua costura_grupo.lua
idefile 2
saveaspress w3d_prueba_pisar.lua 0 /tmp
confirm si w3d_prueba_pisar.lua
popupinfo none
ideinfo /tmp/w3d_prueba_pisar.lua
samefile /tmp/w3d_prueba_pisar.lua costura_grupo.lua
# con "No" no se toca nada (el IDE sigue en el suyo)
ideload componente.lua componente.lua
idefile 2
saveaspress w3d_prueba_pisar.lua 0 /tmp
confirm no w3d_prueba_pisar.lua
samefile /tmp/w3d_prueba_pisar.lua costura_grupo.lua
ideinfo componente.lua
