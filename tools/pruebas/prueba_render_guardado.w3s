# ==========================================================================
#  LA TARJETA RENDER SE GUARDA CON EL PROYECTO
#  "puse que queria exportar en mp4 y cuando lo vuelvo a abrir dice png otra vez": el .w3d guarda el formato, la
#  calidad, el tamano, los pases, la composicion final y el audio (bloque raiz "render"; solo lo que no es de fabrica).
#  Un proyecto nuevo vuelve a los valores de fabrica.
# ==========================================================================
scenedefault
renderformat mp4 70
rendersize 1920 1080
renderpasses 1 0 1
renderfinal 0 0 0
renderaudio mp3 256 0
savew3d /tmp/w3d_render_guardado.w3d
# (otro proyecto en el medio: vuelve todo a fabrica)
scenedefault
openw3d /tmp/w3d_render_guardado.w3d
renders format 3
renders quality 70
renders width 1920
renders height 1080
renders zbuffer 1
renders normal 0
renders alpha 1
renders final 0
renders post 0
renders audio 2
renders kbps 256
renders sound 0
# un proyecto NUEVO: los valores de fabrica
scenedefault
renders format 0
renders width 1280
renders final 1
