# Quad VERTICAL de 1x1 (plano XY, mirando a la camara). Es la geometria OPACA
# que se cruza ENTRE la camara y el agua: el reflejo no puede pintarse encima.
o espejo-tapa
v -0.5 -0.5 0.0
v  0.5 -0.5 0.0
v  0.5  0.5 0.0
v -0.5  0.5 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 0.0 -1.0
usemtl espejo-tapa
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
