# prueba_animsets.w3s — FASE 3: los clips de esqueleto como ANIMSETS binarios (.w3da) y COMPARTIDOS
#
#  Criterios de aceptacion:
#   - los clips salen de proyecto.json a animaciones/<slug>.w3da (formato de bloques, determinista)
#     y el guardado DEDUPLICA POR CLIP (el mismo clip en varios armatures va UNA vez);
#   - en memoria el animset es UN recurso: los armatures con el mismo esqueleto apuntan a los MISMOS
#     clips; el estado de reproduccion es de cada uno;
#   - la reproduccion es IDENTICA antes y despues (posefoto: los bits de toda la pose de cada hueso,
#     en frames de muestra de cada clip de cada armature, en el editor y con el cabezal del juego);
#   - el formato inline viejo se sigue leyendo y al guardar se migra; re-guardar = mismos bytes;
#   - editar es COPIAR (copy-on-write): renombrar un clip, crear uno, borrar un hueso no toca a los
#     demas usuarios; el unico usuario se lleva los clips sin copiar;
#   - huesos por NOMBRE: un armature con los huesos en otro orden usa el animset por una VARIANTE;
#     una variante a la que le falta un hueso no le borra al animset las pistas de ese hueso;
#   - los USUARIOS de un animset (outliner: EN USO / HUERFANO, purgar, renombrar) son los del
#     guardado, tambien para un armature colgado cuyo esqueleto ya no calza;
#   - un animset sin usuarios (huerfano) se conserva; uno roto frena el guardado.
window 1280 720
animsetregistry
animsetcorrupt

# ---- A) el formato INLINE de antes (5 armatures del mismo rig, 5x4 clips + 1 repetido) se lee
#         igual y el guardado lo MIGRA: 22 clips -> 6 distintos (dos "Quieto" y el repetido, que al
#         abrir se renombro "Caminar.001" porque los nombres son unicos por armature) ----
animnoline 1
animsetsynthetic 5 prueba_animsets_viejo_rt.w3d
animnoline 0
animsetsw3d prueba_animsets_viejo_rt.w3d animsets 0 inline 5 armatures 0 registry 0
openw3d prueba_animsets_viejo_rt.w3d
animsetinfo live 0 registry 0
posesnapshot animsets_base.pose game 1
savew3d prueba_animsets_v4.w3d
animsetsw3d prueba_animsets_v4.w3d animsets 1 clips 6 inline 0 armatures 5 registry 1
openw3d prueba_animsets_v4.w3d
animsetinfo live 1 refs 5 clips 6 variants 0 registry 1
animsetarm Personaje shared 1 animset Personaje clips 4 variant 0
animsetarm Personaje.002 shared 1 clips 5
animsetarm SinClips shared 0 clips 0
# el mismo "Caminar" es EL MISMO objeto en memoria para todos; los dos "Quieto" no
animsetclip Personaje 1 name Caminar same Personaje.003 1 1
animsetclip Personaje 0 name Quieto same Personaje.001 0 0
animsetclip Personaje.002 4 name Caminar.001
posesnapshot animsets_v4.pose game 1
posesnapshotequal animsets_base.pose animsets_v4.pose
# abrir/cerrar no deja animsets vivos ni memoria
loadbench prueba_animsets_v4.w3d 3 armatures 6 clips 21 leakkb 64
animsetinfo live 1 refs 5

# ---- B) re-guardar sin cambios = los mismos bytes (dos vueltas) ----
savew3d prueba_animsets_rt1.w3d
w3dequal prueba_animsets_v4.w3d prueba_animsets_rt1.w3d
# el recurso cargado quedo igual a su entrada nueva: sigue con ese id (un armature que se cargue
# despues lo comparte)
animsetrec animations/personaje.w3da refs 5
openw3d prueba_animsets_rt1.w3d
savew3d prueba_animsets_rt2.w3d
w3dequal prueba_animsets_rt1.w3d prueba_animsets_rt2.w3d
posesnapshot animsets_rt2.pose game 1
posesnapshotequal animsets_base.pose animsets_rt2.pose

# ---- C) un armature con el MISMO clip dos veces (un archivo que no paso por el editor): al abrir,
#         la reparacion de nombres renombra el repetido -> ese armature pasa a clips PROPIOS antes
#         (sino renombraba el clip de todos) ----
animsetsynthetic 5 prueba_animsets_dup_rt.w3d
animsetsw3d prueba_animsets_dup_rt.w3d animsets 1 clips 5 armatures 5
openw3d prueba_animsets_dup_rt.w3d
animsetinfo live 1 refs 4 clips 5
animsetarm Personaje.002 shared 0 clips 5
animsetclip Personaje.002 4 name Caminar.001
animsetclip Personaje 1 name Caminar same Personaje.004 1 1
posesnapshot animsets_dup.pose game 1
posesnapshotequal animsets_base.pose animsets_dup.pose
openw3d prueba_animsets_v4.w3d

# ---- D) copy-on-write: editar un armature no toca a los demas ----
animsetrename Personaje.003 1 Paseo
animsetinfo live 1 refs 4 clips 6
animsetarm Personaje.003 shared 0 clips 4
animsetclip Personaje.003 1 name Paseo
animsetclip Personaje 1 name Caminar same Personaje.001 1 1
# 'anim add' (CrearAnimacion) sobre otro: tambien copia antes
animsetactive Personaje.001
anim add
animsetarm Personaje.001 shared 0 clips 5
animsetarm Personaje shared 1 clips 4
animsetinfo live 1 refs 3
# borrar un hueso (remapea las pistas) solo en uno
animsetdeletebone Personaje.004 Brazo
animsetarm Personaje.004 shared 0
animsetclip Personaje.004 2 name Correr keys 405
animsetclip Personaje 2 name Correr keys 501
animsetinfo live 1 refs 2
savew3d prueba_animsets_cow_rt.w3d
# la biblioteca cambio (sumo "Paseo" y el clip nuevo): el recurso viejo se DESENGANCHA de la entrada
# (el proximo que la pida lee la nueva); sus dos usuarios siguen andando con el
animsetrec animations/personaje.w3da none
animsetinfo live 1 refs 2
# Personaje.004 cambio de esqueleto: biblioteca propia (4 clips); "Paseo" y el clip nuevo van a la
# de siempre (6 + 2 = 8): lo que no cambio cae en los mismos clips
animsetsw3d prueba_animsets_cow_rt.w3d animsets 2 clips 12 inline 0 armatures 5 registry 2
openw3d prueba_animsets_cow_rt.w3d
animsetinfo live 2 refs 5 registry 2
animsetclip Personaje.003 1 name Paseo
animsetclip Personaje 2 name Correr same Personaje.003 2 1
animsetclip Personaje.004 2 keys 405
animsetarm Personaje.001 shared 1 clips 5

# ---- D2) un hueso renombrado SIN tocar los clips (el rename de un vertex group lo arrastra): el
#          armature sigue reproduciendo igual y el guardado NO lo deja en el animset por nombre (sus
#          pistas quedarian huerfanas): va a una biblioteca de su esqueleto nuevo ----
openw3d prueba_animsets_v4.w3d
posesnapshot animsets_hueso_a.pose game 1
animsetrenamebone Personaje.001 Cabeza Craneo
animsetarm Personaje.001 shared 1
posesnapshot animsets_hueso_b.pose game 1
posesnapshotequal animsets_hueso_a.pose animsets_hueso_b.pose
savew3d prueba_animsets_hueso_rt.w3d
animsetsw3d prueba_animsets_hueso_rt.w3d animsets 2 armatures 5 registry 2
# en memoria sigue COLGADO del recurso 'Personaje', pero el guardado lo puso en 'Personaje.001': sus
# USUARIOS (lo que usa el outliner para EN USO / HUERFANO y purgar) son los del guardado, no los del
# recurso -> 'Personaje.001' no es huerfano, conserva su carpeta y renombrar 'Personaje' no se lo lleva
animsetarm Personaje.001 shared 1 animset Personaje setname Personaje.001
animsetusers Personaje 4
animsetusers Personaje.001 1
animsetfolder Personaje.001 set Enemigos
animsetpurge 0
animsetrenameset Personaje Heroe Heroe
animsetusers Heroe 4
animsetarm Personaje.001 setname Personaje.001
savew3d prueba_animsets_hueso2_rt.w3d
animsetsw3d prueba_animsets_hueso2_rt.w3d animsets 2 armatures 5 registry 2
zipentry prueba_animsets_hueso2_rt.w3d animations/heroe.w3da
zipentry prueba_animsets_hueso2_rt.w3d animations/personaje.001.w3da
animsetfolder Personaje.001 es Enemigos
openw3d prueba_animsets_hueso_rt.w3d
animsetinfo live 2 refs 5 variants 0
posesnapshot animsets_hueso_c.pose game 1
posesnapshotequal animsets_hueso_a.pose animsets_hueso_c.pose

# ---- E) el UNICO usuario se lleva los clips sin copiar (el recurso muere) ----
animsetsynthetic 1 prueba_animsets_solo_v4.w3d
openw3d prueba_animsets_solo_v4.w3d
posesnapshot animsets_solo_a.pose
animsetinfo live 1 refs 1 clips 4
animsetrename Personaje 3 Brinco
animsetinfo live 0
animsetarm Personaje shared 0 clips 4
animsetclip Personaje 3 name Brinco
animsetrename Personaje 3 Saltar
posesnapshot animsets_solo_b.pose
posesnapshotequal animsets_solo_a.pose animsets_solo_b.pose

# ---- F) huesos por NOMBRE: un esqueleto en otro orden usa el animset por una VARIANTE ----
animsetsynthetic 3 prueba_animsets_var_v4.w3d inverted
animsetsw3d prueba_animsets_var_v4.w3d animsets 2 clips 9 armatures 4 registry 2
openw3d prueba_animsets_var_v4.w3d
posesnapshot animsets_var_base.pose game 1
animsetpoint prueba_animsets_var_v4.w3d prueba_animsets_var2_rt.w3d Invertido Personaje
openw3d prueba_animsets_var2_rt.w3d
# (Personaje.002 trae el clip repetido: pasa a propios al abrir, por eso refs 3)
animsetinfo live 1 refs 3 variants 1 clipsvariant 4 registry 2
animsetarm Invertido shared 1 animset Personaje variant 1 clips 4
animsetarm Personaje shared 1 variant 0
posesnapshot animsets_var.pose game 1
posesnapshotequal animsets_var_base.pose animsets_var.pose
# guardado: la variante vuelve al espacio del animset (dedup con los canonicos); "Invertido" queda huerfano
savew3d prueba_animsets_var_rt.w3d
animsetsw3d prueba_animsets_var_rt.w3d animsets 2 clips 10 armatures 4 registry 2
openw3d prueba_animsets_var_rt.w3d
animsetinfo live 1 refs 4 variants 1 registry 2
posesnapshot animsets_var2.pose game 1
posesnapshotequal animsets_var_base.pose animsets_var2.pose

# ---- G) HUERFANOS: sin usuarios, el animset se conserva (bytes, nombre) ----
animsetdelete Personaje
animsetdelete Personaje.001
animsetdelete Personaje.002
animsetdelete Invertido
animsetinfo live 0 registry 2
savew3d prueba_animsets_huerf_rt.w3d
animsetsw3d prueba_animsets_huerf_rt.w3d animsets 2 armatures 0 registry 2
w3dequal prueba_animsets_var_rt.w3d prueba_animsets_huerf_rt.w3d animations/

# ---- H) FRENO: un animset que no se puede leer deja al armature sin clips y no se guarda encima ----
animsetbreak prueba_animsets_v4.w3d prueba_animsets_roto_rt.w3d cut
openw3d prueba_animsets_roto_rt.w3d
animsetarm Personaje notloaded 1 clips 0
fail guardarw3d prueba_animsets_roto2_rt.w3d
animsetbreak prueba_animsets_v4.w3d prueba_animsets_roto_rt.w3d version
openw3d prueba_animsets_roto_rt.w3d
animsetarm Personaje.004 notloaded 1 clips 0
fail guardarw3d prueba_animsets_roto2_rt.w3d
animsetbreak prueba_animsets_v4.w3d prueba_animsets_roto_rt.w3d req
openw3d prueba_animsets_roto_rt.w3d
animsetarm Personaje notloaded 1
fail guardarw3d prueba_animsets_roto2_rt.w3d
animsetbreak prueba_animsets_v4.w3d prueba_animsets_roto_rt.w3d missing
openw3d prueba_animsets_roto_rt.w3d
animsetarm Personaje notloaded 1
fail guardarw3d prueba_animsets_roto2_rt.w3d
# y reabrir el bueno limpia el freno (y no quedo ningun FALLO de los rotos en el almacen)
openw3d prueba_animsets_v4.w3d
animsetarm Personaje notloaded 0 shared 1 clips 4
animsetinfo live 1 refs 5 descriptores 1

# ---- I) una VARIANTE a la que le FALTA un hueso de la tabla (un "anims" que apunta al animset de
#         otro esqueleto): su copia reindexada deja en -1 las pistas de ese hueso. El guardado
#         escribe el clip CANONICO del recurso: la biblioteca no se duplica (dedup con los demas
#         usuarios; el recurso sigue enganchado a su entrada) y, con la variante como UNICA
#         usuaria, las pistas del hueso que le falta siguen apuntando a el ----
animsetsynthetic 2 prueba_animsets_falta_v4.w3d
openw3d prueba_animsets_falta_v4.w3d
animsetdeletebone Personaje.001 Brazo
savew3d prueba_animsets_falta_b_rt.w3d
animsetpoint prueba_animsets_falta_b_rt.w3d prueba_animsets_falta_c_rt.w3d Personaje.001 Personaje
openw3d prueba_animsets_falta_c_rt.w3d
animsetarm Personaje.001 shared 1 animset Personaje variant 1 clips 4
animsetinfo live 1 refs 2 variants 1 clipsvariant 4
animsettracks prueba_animsets_falta_c_rt.w3d animations/personaje.w3da Brazo 4 - 4
posesnapshot animsets_falta_a.pose game 1
savew3d prueba_animsets_falta_d_rt.w3d
# los mismos 4 clips en personaje.w3da (+ los 4 de 'Personaje.001', huerfano), byte a byte
animsetsw3d prueba_animsets_falta_d_rt.w3d animsets 2 clips 8 armatures 2 registry 2
animsetrec animations/personaje.w3da refs 2
animsettracks prueba_animsets_falta_d_rt.w3d animations/personaje.w3da Brazo 4 - 4
w3dequal prueba_animsets_falta_c_rt.w3d prueba_animsets_falta_d_rt.w3d animations/
# la variante como UNICA usuaria: el animset no pierde las pistas de 'Brazo'
animsetdelete Personaje
savew3d prueba_animsets_falta_e_rt.w3d
animsetsw3d prueba_animsets_falta_e_rt.w3d animsets 2 clips 8 armatures 1 registry 2
animsettracks prueba_animsets_falta_e_rt.w3d animations/personaje.w3da Brazo 4 - 4
w3dequal prueba_animsets_falta_c_rt.w3d prueba_animsets_falta_e_rt.w3d animations/
# BORRAR un clip de esa variante UNICA usuaria tampoco la saca del animset (con clips propios el
# guardado ya no tendria los canonicos): suelta el puntero y 'Brazo' sigue en los que quedan
animsetactive Personaje.001
anim of
animsetarm Personaje.001 shared 1 variant 1 clips 3
savew3d prueba_animsets_falta_f_rt.w3d
animsettracks prueba_animsets_falta_f_rt.w3d animations/personaje.w3da Brazo 3 - 3
openw3d prueba_animsets_falta_d_rt.w3d
posesnapshot animsets_falta_b.pose game 1
posesnapshotequal animsets_falta_a.pose animsets_falta_b.pose

# ---- J) cerrar el proyecto suelta todo ----
scenedefault
animsetinfo live 0 registry 0
