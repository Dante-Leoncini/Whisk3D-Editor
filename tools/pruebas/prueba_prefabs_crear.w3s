# ==========================================================================
#  "CREATE PREFAB" CON Ctrl+Z / Ctrl+Y (io/PrefabsEditor.h: W3dPrefabCrearDesdeSeleccion)
#  Correr DESDE ESTA CARPETA:
#    ../../platform/linux/build/whisk3d --script prueba_prefabs_crear.w3s
#
#  "Create Prefab" es UN paso de undo: la MUDANZA de lo elegido a la raiz de un prefab nuevo + la
#  INSTANCIA que queda en su lugar. Ctrl+Z saca la instancia, devuelve lo elegido TAL CUAL (mismo padre,
#  mismo lugar entre sus hermanos, misma transform, sus curvas de las animaciones de escena, sus luces,
#  la camara activa) y el prefab sale del registro; Ctrl+Y lo rehace. El historial de ANTES sigue
#  valiendo (se deshace despues, por LIFO).
#    A) un objeto (es el objeto raiz del prefab; la instancia toma su transform)
#    B) varios (una camara activa, una luz y un cubo con un hijo) colgados de un vacio
#    C) guardar/abrir despues del Ctrl+Y; y un Ctrl+Z seguido de otra accion (el prefab que habia
#       salido se libera con el paso)
#    D) adentro de un prefab que se edita (el nuevo queda anidado): Ctrl+Z lo devuelve adentro
# ==========================================================================

window 1280 720
prefabenemy /tmp/w3d_f7_cr
rootinfo prefabs 1

# --- A) UN objeto. Antes, un paso cualquiera del historial (una instancia de Enemigo) ---
prefabinstantiate Enemigo 0 0 -6 name Enemigo
selobj CuboAfuera
objrot 30
objscale 1.5 1.5 1.5
animcurve Scene CuboAfuera x 1 4.5 20 6
prefabobj CuboAfuera pos 4.5 0 0 euler 0 30 0 scale 1.5 1.5 1.5 index 1 parent - curves 1
prefabcreate name CuboAfuera
rootinfo prefabs 2
prefabinfo CuboAfuera prefab CuboAfuera generated 1 root CuboAfuera
# (su curva de la animacion de escena pasa a la INSTANCIA, que ocupa su lugar con su transform: la animacion
#  la sigue moviendo. Lo generado no tiene curvas: no se guardarian)
prefabobj CuboAfuera type prefab pos 4.5 0 0 euler 0 30 0 scale 1.5 1.5 1.5 index 1 parent - curves 1
prefabnode CuboAfuera . type mesh
rootobjat CuboAfuera CuboAfuera 0 0 0 0.001
prefablive 2
undo
rootinfo prefabs 1
prefablive 1
prefabobj CuboAfuera type mesh
prefabobj CuboAfuera pos 4.5 0 0 euler 0 30 0 scale 1.5 1.5 1.5 index 1 parent - curves 1
redo
rootinfo prefabs 2
prefablive 2
prefabinfo CuboAfuera prefab CuboAfuera generated 1 root CuboAfuera
prefabobj CuboAfuera type prefab index 1 curves 1
# (dos Ctrl+Z: el Create Prefab y despues la instancia de antes; dos Ctrl+Y: todo de vuelta)
undo
undo
prefablive 0
objrel Enemigo none
prefabobj CuboAfuera type mesh index 1 curves 1
redo
redo
prefablive 2
rootinfo prefabs 2
prefabinfo CuboAfuera generated 1

# --- B) VARIOS: la camara ACTIVA, una luz y el Cubo (con un hijo) quedan colgados de un vacio ---
addlight
objname Luz
add cube
objname Hijo
parent Hijo Cubo
prefabobj Camara camera 1 index 2
prefabobj Luz light 1 index 5
prefabobj Cubo pos 0 0 0 scale 2 2 2 index 0
prefabpick Cubo Camara Luz
prefabcreate name Prefab
rootinfo prefabs 3
prefabinfo Prefab prefab Prefab generated 5 root Prefab
prefabobj Prefab type prefab index 0 scale 1 1 1
prefabnode Prefab Camara type camera generated 1
prefabnode Prefab Luz type light generated 1
prefabnode Prefab Cubo/Hijo type mesh generated 1
undo
rootinfo prefabs 2
prefabobj Cubo pos 0 0 0 scale 2 2 2 index 0 parent -
prefabobj Camara camera 1 index 2 parent -
prefabobj Luz light 1 index 5 parent -
objrel Hijo parent Cubo
prefabobj Hijo type mesh parent Cubo
fail prefabinfo Prefab
redo
rootinfo prefabs 3
prefabinfo Prefab prefab Prefab generated 5
prefabnode Prefab Hijo none
prefabnode Prefab Cubo/Hijo type mesh generated 1

# --- C) guardar/abrir: los dos prefabs creados son del proyecto ---
savew3d /tmp/w3d_f7_cr/crear.w3d
openw3d /tmp/w3d_f7_cr/crear.w3d
rootinfo prefabs 3
prefabinfo CuboAfuera prefab CuboAfuera generated 1
prefabinfo Prefab prefab Prefab generated 5
prefablive 3
# un Ctrl+Z y despues OTRA accion: el Ctrl+Y ya no existe y el prefab que salio se libera con su paso
prefabunpack CuboAfuera
prefablive 2
selobj CuboAfuera
prefabcreate name CuboAfuera.001
rootinfo prefabs 4
undo
rootinfo prefabs 3
prefabinstantiate Enemigo 3 0 -6
redo
rootinfo prefabs 3
prefablive 3

# --- D) adentro de un prefab que se EDITA: el nuevo queda anidado; Ctrl+Z lo devuelve adentro ---
rootopen Enemigo prefab
selobj Sensor
prefabcreate name Sensor
rootinfo prefabs 4
prefabobj Sensor type prefab parent Esqueleto
undo
rootinfo prefabs 3
prefabobj Sensor type hitbox parent Esqueleto
redo
rootinfo prefabs 4
rootopen Scene
prefabinfo Enemigo generated 5
prefabnode Enemigo Esqueleto/Sensor type prefab
