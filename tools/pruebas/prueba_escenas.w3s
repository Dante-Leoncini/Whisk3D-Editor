# ==========================================================================
#  ESCENAS 3D MULTIPLES (W3dRaices.h / io/RaicesEditor.h) en el editor.
#  Correr DESDE ESTA CARPETA:
#    ../../platform/linux/build/whisk3d --script prueba_escenas.w3s
#
#  Cada escena 3D es una RAIZ propia; una sola es SceneCollection. Se prueba:
#    - crear escenas por el SELECTOR de la barra del viewport 3D y el "+" del outliner;
#    - el CONTEXTO por raiz: seleccion, objeto activo, camara activa, coleccion activa,
#      animaciones de escena y LUCES (el tope de 8 de GL es por escena);
#    - Parent normalizado (un objeto de primer nivel tiene a su raiz de padre);
#    - el undo LIMPIO al cambiar (el historial era de la otra escena);
#    - la vista "Scenes" del outliner: renombrar (con undo), carpetas, no borrar la
#      abierta, "Purge Orphans" no toca escenas;
#    - guardar/abrir: registro "escenas3d" + entradas .w3de, carga PEREZOSA, la sesion
#      reabre la escena que se editaba, re-guardar da los mismos bytes, la escena
#      inicial del juego, y borrar una escena saca su entrada;
#    - una escena SIN ABRIR no se rompe cuando se renombra o se purga un recurso que
#      solo ella usa (se cargan todas antes).
# ==========================================================================

window 1280 720
scenedefault
rootinfo n 1 active Scene block Scene initial -
selobj Cubo
rootcontext active Cubo sel 1 camera Cámara lights 1 anims 1 collection Colección
rootbar 3d Scene
rootbar outliner Scene

# ---- una escena nueva por el SELECTOR de la barra del 3D ----
rootmenu 3d New Scene
rootinfo n 2 active Scene.001 scenes 2
rootcontext active - sel 0 camera - lights 0 collection -
rootinfo objects 0
rootbar 3d Scene.001
rootbar outliner Scene.001
add cube
objname CajaB
rootparent CajaB
rootcamera CamB
addlight
selobj CajaB
rootcontext active CajaB sel 1 camera CamB lights 1

# ---- volver: cada escena conserva lo suyo ----
rootopen Scene
rootcontext active Cubo sel 1 camera Cámara lights 1 collection Colección
# (los 4 de la escena + las 2 rutinas que trae todo proyecto: Constructor y Limpiar pantalla)
rootinfo objects 6
# las LUCES son por escena: la del bloque crea 9 mas (pasadas las 8 de GL comparten numero: el trazado usa todas) y la
# otra sigue creando las suyas
rootlights 9 created 9
rootcontext lights 10
selobj Cubo
rootmenu outliner Scene.001
rootinfo active Scene.001
rootcontext active CajaB camera CamB lights 1
rootlights 2 created 2
rootcontext lights 3

# ---- el undo es de la escena que se deja (se limpia al cambiar) ----
add cube
objname Temporal
rootinfo objects 6
rootopen Scene
undo
rootinfo objects 15
rootopen Scene.001
rootinfo objects 6
undo
rootinfo objects 6

# ---- la vista "Scenes" del outliner ----
outview scenes
outrows n 2
outrow Scene.001 users 0
recrename scenes Scene.001 Nivel2
rootinfo active Nivel2
rootbar 3d Nivel2
undo
rootinfo active Scene.001
redo
rootinfo active Nivel2
foldernew scenes - Niveles
recmove scenes Nivel2 Niveles
outrow Nivel2 folder Niveles prof 1
recdelete scenes Nivel2 fails
recpurge scenes n 0
outrows n 3
outview scene

# ---- un PREFAB por el selector de la escena de la barra del outliner (su raiz aislada, con su objeto raiz) ----
rootbutton prefab
rootinfo n 3 active Prefab type prefab prefabs 1 objects 1
rootcontext collection Prefab
rootbar 3d Prefab icon prefab

# ---- la escena con la que arranca el juego ----
rootopen Nivel2
rootmenu 3d Set as Start Scene
rootinfo initial Nivel2

# ---- guardar: registro + una entrada por escena/prefab ----
rootopen Scene
savew3d /tmp/w3d_f6_escenas.w3d
entryexists /tmp/w3d_f6_escenas.w3d scenes/nivel2.w3de 1
entryexists /tmp/w3d_f6_escenas.w3d prefabs/prefab.w3dp 1
entryhas /tmp/w3d_f6_escenas.w3d project.json scenes3d 1
entryhas /tmp/w3d_f6_escenas.w3d project.json initialScene3d 1
entryhas /tmp/w3d_f6_escenas.w3d project.json Niveles 1
entryhas /tmp/w3d_f6_escenas.w3d scenes/nivel2.w3de CajaB 1
entryhas /tmp/w3d_f6_escenas.w3d project.json CamB 0
entryhas /tmp/w3d_f6_escenas.w3d scenes/nivel2.w3de CamB 1

# ---- abrir: la del bloque cargada, el resto PEREZOSO ----
openw3d /tmp/w3d_f6_escenas.w3d
rootinfo n 3 active Scene loaded Nivel2 0 loaded Prefab 0 initial Nivel2
rootcontext active Cubo sel 1
rootopen Nivel2
rootinfo loaded Nivel2 1 objects 6
rootcontext camera CamB lights 3
outview scenes
outrow Nivel2 folder Niveles
outview scene
rootopen Scene
savew3d /tmp/w3d_f6_escenas_2.w3d
w3dequal /tmp/w3d_f6_escenas.w3d /tmp/w3d_f6_escenas_2.w3d

# ---- la sesion reabre la escena que se estaba editando ----
rootopen Nivel2
selobj CajaB
savew3d /tmp/w3d_f6_escenas_3.w3d
openw3d /tmp/w3d_f6_escenas_3.w3d
rootinfo active Nivel2 loaded Scene 1 loaded Prefab 0
rootcontext active CajaB sel 1

# ---- un recurso que SOLO usa una escena sin abrir no se purga ni queda nombrado viejo ----
openw3d /tmp/w3d_f6_escenas.w3d
rootinfo loaded Nivel2 0
recpurge meshes n 0
rootinfo loaded Nivel2 1
resource meshes CajaB users 1
openw3d /tmp/w3d_f6_escenas.w3d
rootinfo loaded Nivel2 0
recrename meshes CajaB CajaX
rootinfo loaded Nivel2 1
savew3d /tmp/w3d_f6_escenas_4.w3d
entryhas /tmp/w3d_f6_escenas_4.w3d scenes/nivel2.w3de CajaX 1
openw3d /tmp/w3d_f6_escenas_4.w3d
rootopen Nivel2
resource meshes CajaX users 1
rootinfo objects 6

# ---- borrar una escena (no la abierta): su entrada se va del contenedor ----
rootopen Scene
outview scenes
recdelete scenes Nivel2
outview scene
rootinfo n 2 scenes 1 initial -
savew3d /tmp/w3d_f6_escenas_5.w3d
entryexists /tmp/w3d_f6_escenas_5.w3d scenes/nivel2.w3de 0
entryexists /tmp/w3d_f6_escenas_5.w3d prefabs/prefab.w3dp 1
# la ultima escena no se borra
rootdelete Scene fails
