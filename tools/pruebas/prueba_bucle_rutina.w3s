# BUCLE DE RUTINA: la lista corre N veces seguidas sin reponer nada entre vueltas ("trasladar, dibujar" x 5 = 5 cubos
# corridos). Se dibujan N veces los triangulos y el campo "repetir" viaja en el .w3d.
# Y el TOTAL del overlay "faces: dibujadas/total" cuenta lo que dibujan las rutinas (antes solo los objetos malla: con
# un escenario unido en rutinas las dibujadas pasaban al total, conversiones/mobile_legend)
routine Bucle
routinestep Bucle array mode=0 on=1
routinestep Bucle array mode=1 on=0
routinestep Bucle array mode=2 on=0
routinestep Bucle array mode=3 on=0
routinestep Bucle vertexPointer ref=Cubo
routinestep Bucle translate n0=2.5 n1=0 n2=0
routinestep Bucle draw ref=Cubo
tris3d
tris3d
# el objeto Cubo (12) + el cubo de la rutina (12)
facestotal 24
# 5 vueltas: 4 cubos mas (12 triangulos cada uno)
routinerepeat Bucle 5
tris3d 48
facestotal 72
savew3d /tmp/w3d_prueba_bucle.w3d
openw3d /tmp/w3d_prueba_bucle.w3d
tris3d 0
facestotal 72

# --- los rangos: el total es SIN recorte (las banderas de un rango array no restan) ---
routinerepeat Bucle 1
tris3d
# un rango manual: triangulos 2..5 (4) en vez del cubo entero
routine Rangos
routinestep Rangos array mode=0 on=1
routinestep Rangos array mode=1 on=0
routinestep Rangos array mode=2 on=0
routinestep Rangos array mode=3 on=0
routinestep Rangos vertexPointer ref=Cubo
routinestep Rangos draw ref=Cubo range=1 n0=2 n1=5
tris3d 4
facestotal 28
# un rango array con banderas: [2 rangos, 0..1 con la bandera 0, 6..-1 (hasta el ultimo) con la bandera 1] = 2 + 6
memory ra 0 2
memory ra 1 0
memory ra 2 1
memory ra 3 0
memory ra 4 6
memory ra 5 -1
memory ra 6 1
memory rb 0 1
memory rb 1 1
routinestep Rangos draw ref=Cubo range=2 n2=@ra[0] n3=@rb[0]
tris3d 8
facestotal 36
# apagar las dos banderas: se dibujan 8 menos, el total no cambia
memory rb 0 0
memory rb 1 0
tris3d -8
facestotal 36
