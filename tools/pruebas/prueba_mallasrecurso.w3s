# ==========================================================================
#  LAS MALLAS 3D COMO RECURSO COMPARTIDO (libs/Whisk3DCore/objects/MallaRecurso.h,
#  main/io/MallasProyecto.h). Correr DESDE ESTA CARPETA:
#    cd <motor>/tools/pruebas
#    ../../platform/linux/build/whisk3d --script prueba_mallasrecurso.w3s
#
#  Lo que se exige (la aceptacion de la fase):
#   A) MIL objetos con la misma malla: UNA malla del proyecto (un .w3db), UN juego
#      de arrays y UN juego de VBO; abrir no deriva nada, reabrir no deja memoria,
#      y guardar sin cambios da los MISMOS bytes (la entrada se copia tal cual).
#   B) EDITAR la malla de un objeto edita el RECURSO: al salir de Edit Mode la ven
#      todos sus objetos (y el Ctrl+Z del move vuelve en todos).
#   C) "Make Single User" separa (Arbol.001) y "New Copy" tambien; con undo/redo.
#   D) Alt+D = duplicado VINCULADO (el mismo recurso, la misma memoria); Shift+D =
#      copia con recurso propio (nombre siguiente). Con undo/redo de la creacion.
#   E) el material de una parte es dato de la MALLA: cambiarlo en un objeto lo ve
#      todo usuario; renombrar el recurso (con undo) lo renombra para todos (el rename y
#      la carpeta van por la tarjeta "Malla 3D" de Properties, como en la UI).
#   F) HUERFANAS: una malla del proyecto sin objetos se conserva al guardar/abrir.
#   G) ARCHIVOS VIEJOS ("geometria" por objeto) abren y al guardarse migran al
#      registro "mallas" (agrupando las iguales).
#   H) SKINNING por instancia: dos personajes con la MISMA malla y dos esqueletos
#      con poses distintas (cada pose identica a la de una copia suelta), tambien
#      guardado y reabierto. Los grupos/formas viven UNA vez por usuario: el recurso
#      no se queda con otra copia.
#   I) MIRAR sin materializar: alambre, snap y seleccion por caja de una malla con
#      la edicion pendiente usan la topologia COMPARTIDA del recurso (aristas y
#      caras), identica a la de la malla editada.
#   J) la PURGA de los recursos de la sesion que ya nadie usa ni nombra el undo.
#   K) la POSE de la sesion (flipbook) sobrevive a que OTRO usuario publique, y un
#      duplicado se lleva el flipbook.
#   T) el FORMATO DE TEXTO tiene el mismo registro (una .w3dm por malla, dedup),
#      migra a binario y vuelve, huerfanas incluidas.
#  Escribe en tools/debug.
# ==========================================================================
# autocull APAGADO para esta prueba: es de CONTABILIDAD de recursos (las 1000 instancias tienen
# que materializar sus arrays/VBO para que los contadores cierren); el autocull por frustum no
# dibuja (ni materializa) lo que la camara no ve, y eso es correcto pero no es lo que se mide aca.
autocull 0
window 1280 720
formatmeshes binary

# --- A) mil arboles iguales -> una malla ------------------------------------------
scenesynthetic 1000 ../debug/mr_mil.w3d
w3dbinfo ../debug/mr_mil.w3d w3db 1 w3dm 0
loadbench ../debug/mr_mil.w3d 3 meshes 1000 meshesbin 1000 derived 0 objects 1003 leakkb 64
openw3d ../debug/mr_mil.w3d
meshesregistry n 1 loaded 1
meshrender
meminfo meshes 1
meminfo meshesrefs 1000
meminfo meshresources 1
meminfo sharedvbo 1
# ...y NINGUN objeto sube VBO propios: los mil se dibujaron con TODAS sus capas desde los VBO
# del recurso (un juego de VBO para los mil, no uno por objeto ademas del compartido)
meshesvbo own 0 delresource 1000 drawn 1000
meshcheck Arbol resource Arbol users 1000 vbo shared edit pending shares Arbol.500
# sin grupos ni formas: el recurso no guarda extras (y ningun arbol paga la identidad de sus puntos)
meshesregistry extras 0
savew3d ../debug/mr_mil2.w3d
w3dequal ../debug/mr_mil.w3d ../debug/mr_mil2.w3d

# --- B) editar un usuario modifica a todos ---------------------------------------
scenesynthetic 20 ../debug/mr_sint.w3d
openw3d ../debug/mr_sint.w3d
# --- I) mirar sin materializar (alambre / snap / caja con la topologia del recurso) ------
meshlook Arbol.009
meshcheck Arbol.009 edit pending
meshvert Arbol 0 save a0
meshvert Arbol.009 0 save b0
selobj Arbol.005
mode edit
select all
move 0.5
mode object
meshcheck Arbol.005 resource Arbol users 20
meshvert Arbol 0 delta a0 0.5 0 0
meshvert Arbol.009 0 delta b0 0.5 0 0
meshcheck Arbol shares Arbol.005
# el Ctrl+Z del move (el primero deshace el cambio de modo): vuelve en TODOS al salir
undo
undo
mode object
meshvert Arbol 0 delta a0 0 0 0
meshvert Arbol.005 0 delta a0 0 0 0
selobj Arbol.005
mode edit
select all
move 0.5
mode object
meshvert Arbol.012 0 delta a0 0.5 0 0

# --- C) hacer unica / nueva copia (con undo) ---------------------------------------
meshunique Arbol.007
meshcheck Arbol.007 resource Arbol.001 users 1 noshare Arbol
meshcheck Arbol resource Arbol users 19
undo
meshcheck Arbol.007 resource Arbol users 20 shares Arbol
# Arbol.001 se quedo sin usuarios, pero el redo lo nombra: no se purga
meshespurge n 0
meshesregistry has Arbol.001
redo
meshcheck Arbol.007 resource Arbol.001 users 1
# editar la unica NO mueve a las demas
meshvert Arbol.007 0 save u0
selobj Arbol.007
mode edit
select all
move 0.25
mode object
meshvert Arbol.007 0 delta u0 0.25 0 0
meshvert Arbol 0 delta a0 0.5 0 0
meshnew Arbol.011
meshcheck Arbol.011 resource Arbol.002 users 1
undo
meshcheck Arbol.011 resource Arbol users 19

# --- D) Alt+D vinculado / Shift+D copia (con undo de la creacion) -------------------
meshdup Arbol.003 linked
meshcheck @ultimo resource Arbol users 20 shares Arbol.003
undo
meshcheck Arbol resource Arbol users 19
redo
meshcheck @ultimo resource Arbol users 20
# --- J) el Alt+D descarto el redo del "New Copy": Arbol.002 (de la sesion, sin usuarios y sin
#     paso de undo que lo nombre) se PURGA y su nombre queda libre
meshespurge n 1
meshesregistry hasnot Arbol.002
meshdup Arbol.003 copy
meshcheck @ultimo resource Arbol.002 users 1 noshare Arbol.003
undo
meshcheck Arbol.003 resource Arbol users 20
redo
meshcheck @ultimo resource Arbol.002 users 1

# --- E) el material es de la malla; renombrar el recurso ----------------------------
meshmaterial Arbol.004 0 MatCorteza
meshcheck Arbol.010 material 0 MatCorteza
meshcheck Arbol.007 material 0 Default
undo
meshcheck Arbol.010 material 0 Default
redo
meshcheck Arbol.010 material 0 MatCorteza
meshrename Arbol.004 Pino
meshcheck Arbol.010 resource Pino users 20
undo
meshcheck Arbol.010 resource Arbol
redo
meshcheck Arbol.010 resource Pino
# la CARPETA (cosmetica): normalizada, con undo, la ven todos los objetos de la malla
meshfolder Arbol.010 Vegetacion//Arboles/
meshcheck Arbol.004 folder Vegetacion/Arboles
undo
meshcheck Arbol.004 folder -
redo
meshcheck Arbol.004 folder Vegetacion/Arboles
savew3d ../debug/mr_sint2.w3d
openw3d ../debug/mr_sint2.w3d
meshesregistry n 3 has Pino has Arbol.001 has Arbol.002 hasnot Arbol hasnot Arbol.003 folder Pino Vegetacion/Arboles folder Arbol.001 -
meshcheck Arbol.010 resource Pino users 20 shares Arbol.004 material 0 MatCorteza
meshcheck Arbol.007 resource Arbol.001 users 1
meshvert Arbol 0 delta a0 0.5 0 0
meshvert Arbol.007 0 delta u0 0.25 0 0
# guardar sin tocar nada: los mismos bytes
savew3d ../debug/mr_sint3.w3d
w3dequal ../debug/mr_sint2.w3d ../debug/mr_sint3.w3d

# --- F) una HUERFANA (sin objetos) sobrevive a guardar y abrir ----------------------
meshassign Arbol.007 Pino
meshcheck Arbol.007 resource Pino users 21
meshesregistry has Arbol.001
savew3d ../debug/mr_huerf.w3d
openw3d ../debug/mr_huerf.w3d
meshesregistry n 3 has Arbol.001 loaded 2
savew3d ../debug/mr_huerf2.w3d
w3dequal ../debug/mr_huerf.w3d ../debug/mr_huerf2.w3d
# la huerfana se puede pedir por el almacen como la pide una ListaCarga "malla:" (async: la
# carga la bomba) y se suelta con las transitorias
meshacquire meshes/arbol.001.w3db async
recinfo mesh meshes/arbol.001.w3db state EN_VUELO
pump 1
recinfo mesh meshes/arbol.001.w3db state LISTO
meshesregistry loaded 3
purge
recinfo mesh meshes/arbol.001.w3db state NADA
meshesregistry loaded 2

# --- G) un proyecto VIEJO (.w3dm de texto, "geometria" por objeto) migra al registro --
formatmeshes text
mesheslegacy on
scenesynthetic 6 ../debug/mr_viejo.w3d
mesheslegacy off
w3dbinfo ../debug/mr_viejo.w3d w3db 0 w3dm 6
openw3d ../debug/mr_viejo.w3d
# TODA malla es un recurso (la biblioteca): las mallas de un archivo viejo lo tienen YA al abrir, no recien
# al guardar, y las iguales comparten UNO (6 arboles -> una malla 3D)
meshesregistry n 1
meshcheck Arbol resource Arbol users 6
formatmeshes binary
savew3d ../debug/mr_migrado.w3d
w3dbinfo ../debug/mr_migrado.w3d w3db 1 w3dm 0
meshcheck Arbol.003 resource Arbol users 6
openw3d ../debug/mr_migrado.w3d
meshesregistry n 1
meshcheck Arbol.005 resource Arbol users 6 shares Arbol
loadbench ../debug/mr_migrado.w3d 1 meshes 6 meshesbin 6 derived 0

# --- H) skinning por instancia con la malla compartida ------------------------------
meshskintwo build
meshcheck PersonajeB resource Personaje users 2 shares PersonajeA
meshskintwo verify
meshrender
meshcheck PersonajeA vbo pose
savew3d ../debug/mr_skin.w3d
openw3d ../debug/mr_skin.w3d
# cada personaje tiene SUS grupos (el skinning los lee de la malla) y el recurso ya no guarda
# otra copia: los solt?? cuando el primer usuario limpio los tuvo
meshesregistry n 1 extras 0
meshcheck PersonajeA resource Personaje users 2 shares PersonajeB groups 2
meshcheck PersonajeB groups 2
meshskintwo verify
# un tercero vinculado copia los grupos de un usuario limpio (sin releer la entrada)
meshdup PersonajeA linked
meshcheck @ultimo resource Personaje users 3 groups 2 shares PersonajeA
meshesregistry extras 0

# --- K) la POSE de la sesion sobrevive a que OTRO usuario publique ----------------------
scenesynthetic 6 ../debug/mr_pose.w3d
openw3d ../debug/mr_pose.w3d
# Arbol.004 anima sus UV (flipbook propio, parado en el cuadro 1 de 4: u + 0.25) y Arbol.005
# esta POSADO por su vertex anim (cuadro 10 = el doble de su reposo)
meshuv Arbol.004 0 save base
meshflip Arbol.004 4 1
meshuv Arbol.004 0 delta base 0.25 0
meshvert Arbol.004 0 save p0
meshva Arbol.005 10
meshvert Arbol.005 0 save va10
selobj Arbol.002
mode edit
select all
move 0.5
mode object
# la geometria nueva le llego a Arbol.004... y sigue en su cuadro (antes quedaba en reposo)
meshvert Arbol.004 0 delta p0 0.5 0 0
meshuv Arbol.004 0 delta base 0.25 0
meshcheck Arbol.004 flipbook si resource Arbol users 6
# Arbol.005 sigue en la pose de su anim (antes volvia al reposo nuevo hasta el proximo cuadro)
meshvert Arbol.005 0 delta va10 0 0 0
meshcheck Arbol.005 resource Arbol users 6
# el duplicado (vinculado o copia) se lleva el flipbook, en el mismo cuadro
meshdup Arbol.004 linked
meshcheck @ultimo flipbook si resource Arbol
meshuv @ultimo 0 delta base 0.25 0
meshdup Arbol.004 copy
meshcheck @ultimo flipbook si
meshuv @ultimo 0 delta base 0.25 0

# --- T) el FORMATO DE TEXTO: el mismo registro, una .w3dm por malla ----------------------
formatmeshes text
scenesynthetic 20 ../debug/mr_texto.w3d
w3dbinfo ../debug/mr_texto.w3d w3db 0 w3dm 1
openw3d ../debug/mr_texto.w3d
meshesregistry n 1 has Arbol
meshcheck Arbol.013 resource Arbol users 20 shares Arbol edit pending
meshlook Arbol.013
meshvert Arbol 0 save t0
selobj Arbol.006
mode edit
select all
move 0.5
mode object
meshvert Arbol.019 0 delta t0 0.5 0 0
savew3d ../debug/mr_texto2.w3d
w3dbinfo ../debug/mr_texto2.w3d w3db 0 w3dm 1
openw3d ../debug/mr_texto2.w3d
meshvert Arbol.019 0 delta t0 0.5 0 0
meshcheck Arbol.019 users 20 shares Arbol.006
# guardar sin tocar nada: la .w3dm se copia tal cual
savew3d ../debug/mr_texto3.w3d
w3dequal ../debug/mr_texto2.w3d ../debug/mr_texto3.w3d
# de texto a binario: la malla pasa a .w3db
formatmeshes binary
savew3d ../debug/mr_texto_bin.w3d
w3dbinfo ../debug/mr_texto_bin.w3d w3db 1 w3dm 0
openw3d ../debug/mr_texto_bin.w3d
meshesregistry n 1
meshvert Arbol.019 0 delta t0 0.5 0 0
# de binario a texto con una HUERFANA (sin objetos: sale de sus bytes)
openw3d ../debug/mr_huerf.w3d
formatmeshes text
savew3d ../debug/mr_huerf_t.w3d
w3dbinfo ../debug/mr_huerf_t.w3d w3db 0 w3dm 3
openw3d ../debug/mr_huerf_t.w3d
meshesregistry n 3 has Arbol.001
meshacquire meshes/arbol.001.w3dm bloqueante
recinfo mesh meshes/arbol.001.w3dm state LISTO
purge
savew3d ../debug/mr_huerf_t2.w3d
w3dequal ../debug/mr_huerf_t.w3d ../debug/mr_huerf_t2.w3d
formatmeshes project
