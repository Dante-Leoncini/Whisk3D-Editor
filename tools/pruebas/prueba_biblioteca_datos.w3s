# prueba_biblioteca_datos.w3s — FASE 4b: lo que la biblioteca sabe de cada recurso y lo que se hace con el
#
#  Criterios de aceptacion:
#   - DATOS por tipo (la tarjeta del recurso en Properties): textura (formato, resolucion, canal alfa si/no
#     binario/con transparencias, bytes, memoria sin/con mipmaps), sonido (formato, frecuencia, canales,
#     bits, duracion, bytes, loop smpl), malla 3D (vertices, triangulos, partes, memoria, usuarios),
#     material, animaciones, escena, script;
#   - ADENTRO / AFUERA del .w3d por recurso (un archivo al lado del proyecto, relativo), con undo; se guarda
#     como "ext:" y vuelve igual al abrir; si el archivo externo FALTA, sus datos lo avisan (tambien al abrir);
#   - BORRAR un recurso EN USO (sus usuarios quedan sin el, con undo) y un huerfano; DUPLICAR un recurso;
#   - TODA malla es un recurso con nombre (primitivas, duplicados, lo que se abre de un archivo viejo) y la
#     vista Mallas 3D lista EXACTAMENTE los vivos + los huerfanos;
#   - Properties: la tarjeta "Malla 3D" vive en la pestania VERTICES (la 3), primera, con el selector (nunca
#     "(sin recurso)"); NO hay pestania "Recurso": un recurso de la biblioteca se muestra en la 3;
#   - ARRASTRAR de la biblioteca al 3D (una malla = un objeto nuevo con esa malla; un material = el de la
#     parte bajo el mouse) y a los desplegables de Properties (la malla del selector: cubo -> cilindro),
#     con undo; lo que no se puede soltar ahi se marca invalido;
#   - una LIBRERIA externa (.w3d vinculado) se explora SIN montarla, de solo lectura; su contenido se arrastra
#     como una referencia (fase de librerias: prueba_librerias.w3s).
window 1280 720

# ---- 0) un proyecto con una textura por cada clase de alfa, un sonido y un script ----
scenedefault
selobj Cubo
matnew
objtexture Cubo dosmats.png
animsetsynthetic 1 add
savew3d prueba_biblioteca_datos_v4.w3d
openw3d prueba_biblioteca_datos_v4.w3d
entryraw sounds/bip.wav sounds/bip.wav
entryraw textures/particula.png textures/particula.png
texentry dosmats-b.png
entrytext scripts/ia.lua -- un script
outview library
outrow bip.wav type sounds state huerfano
outrow ia.lua type scripts state huerfano

# ---- A) los DATOS de cada tipo ----
recfield textures textures/dosmats.png Format = PNG
recfield textures textures/dosmats.png Resolution = 64 x 64
recfield textures textures/dosmats.png Alpha channel = Yes (binary)
recfield textures textures/particula.png Alpha channel = Yes (with transparency)
recfield textures textures/dosmats-b.png Alpha channel = Yes
recfield textures textures/dosmats.png Memory = 16.0 KB (21.3 KB with mipmaps)
recfield textures textures/particula.png Bytes = 132 B
recfield sounds sounds/bip.wav Format = WAV
recfield sounds sounds/bip.wav Sample rate = 11025 Hz
recfield sounds sounds/bip.wav Channels = mono (1)
recfield sounds sounds/bip.wav Bits = 16
recfield sounds sounds/bip.wav Duration = 0.25 s
recfield sounds sounds/bip.wav Loop (smpl) = No
recfield meshes Cubo Vertices = 24
recfield meshes Cubo Triangles = 12
recfield meshes Cubo Parts = 1 (Material)
recfield meshes Cubo Users = 1
recfield materials Material Texture = dosmats.png
recfield animations Personaje Clips = 4
recfield scripts scripts/ia.lua Type = Script
recfield scripts scripts/ia.lua Bytes = 12 B
# la tarjeta del recurso: la pestania 3 (no hay pestania "Recurso")
outclick bip.wav
recactive sounds sounds/bip.wav
propsmesh tab 3 resource 1 mesh3d 0 tabs 10

# las ACCIONES del tipo en la tarjeta: Play / Stop de un sonido, Open in IDE de un script, Open de una escena
recbutton action
recbutton stop
outclick ia.lua
recbutton action
recbutton stop hidden
rootbutton escena
outview library
outclick Scene
recactive scenes Scene
recbutton action
# (el selector de la escena es del OUTLINER: la biblioteca es otro viewport)
outview scene
rootbar outliner Scene
outview library
outclick Scene
recbutton stop hidden

# ---- B) ADENTRO / AFUERA del .w3d (con undo; se guarda "ext:") ----
reclocation textures textures/particula.png inside
reclocate textures textures/particula.png outside prueba_biblioteca_rt_particula.png
reclocation textures prueba_biblioteca_rt_particula.png outside
recfield textures prueba_biblioteca_rt_particula.png Resolution = 8 x 8
undo
reclocation textures textures/particula.png inside
redo
reclocation textures prueba_biblioteca_rt_particula.png outside
reclocate sounds sounds/bip.wav outside prueba_biblioteca_rt_bip.wav
recfield sounds prueba_biblioteca_rt_bip.wav Duration = 0.25 s
# un HUERFANO que se paso afuera sigue en la biblioteca (nadie lo nombra, pero es del proyecto) y va a una carpeta
outview library
outrow prueba_biblioteca_rt_particula.png type textures state huerfano
outrow prueba_biblioteca_rt_bip.wav type sounds state huerfano
outnorow particula.png
foldernew - Afuera
recmove textures prueba_biblioteca_rt_particula.png Afuera
recmove sounds prueba_biblioteca_rt_bip.wav Afuera
savew3d prueba_biblioteca_datos_rt1.w3d
zipentry prueba_biblioteca_datos_rt1.w3d textures/particula.png no
zipentry prueba_biblioteca_datos_rt1.w3d sounds/bip.wav no
# (el registro "externos": los de afuera que no nombra nadie mas, con su carpeta; y EXTERNOS.txt)
jsonhas prueba_biblioteca_datos_rt1.w3d "external"
entryhas prueba_biblioteca_datos_rt1.w3d EXTERNALS.txt prueba_biblioteca_rt_bip.wav
openw3d prueba_biblioteca_datos_rt1.w3d
outview library
reclocation textures prueba_biblioteca_rt_particula.png outside
reclocation sounds prueba_biblioteca_rt_bip.wav outside
outrow prueba_biblioteca_rt_particula.png type textures folder Afuera
outrow prueba_biblioteca_rt_bip.wav type sounds folder Afuera
# el AVISO si el archivo externo FALTA (se movio o se borro por fuera de Whisk3D): la fila Warning
recfield textures prueba_biblioteca_rt_particula.png File size = 132 B
fail recdato textures prueba_biblioteca_rt_particula.png Warning = The external file is missing
filemove prueba_biblioteca_rt_particula.png prueba_biblioteca_rt_particula_movida.png
recfield textures prueba_biblioteca_rt_particula.png Warning = The external file is missing
# (donde vive no es un dato: lo dice el desplegable Ubicacion de la tarjeta)
reclocation textures prueba_biblioteca_rt_particula.png outside
filemove prueba_biblioteca_rt_bip.wav prueba_biblioteca_rt_bip_movido.wav
recfield sounds prueba_biblioteca_rt_bip.wav Warning = The external file is missing
# (sin su archivo no se puede meter adentro)
fail recubicar sounds prueba_biblioteca_rt_bip.wav inside
# al ABRIR el proyecto sin sus archivos: siguen en la biblioteca, con el aviso
openw3d prueba_biblioteca_datos_rt1.w3d
outview library
outrow prueba_biblioteca_rt_particula.png type textures folder Afuera
outrow prueba_biblioteca_rt_bip.wav type sounds folder Afuera
recfield textures prueba_biblioteca_rt_particula.png Warning = The external file is missing
recfield sounds prueba_biblioteca_rt_bip.wav Warning = The external file is missing
# vuelven a su lugar: el aviso se va
filemove prueba_biblioteca_rt_particula_movida.png prueba_biblioteca_rt_particula.png
filemove prueba_biblioteca_rt_bip_movido.wav prueba_biblioteca_rt_bip.wav
recfield textures prueba_biblioteca_rt_particula.png File size = 132 B
fail recdato textures prueba_biblioteca_rt_particula.png Warning = The external file is missing
recfield sounds prueba_biblioteca_rt_bip.wav Duration = 0.25 s
fail recdato sounds prueba_biblioteca_rt_bip.wav Warning = The external file is missing
# y de vuelta ADENTRO
reclocate sounds prueba_biblioteca_rt_bip.wav dentro
reclocation sounds sounds/prueba_biblioteca_rt_bip.wav inside
# (una sola fila: la de adentro, en la carpeta que tenia)
outrow prueba_biblioteca_rt_bip.wav folder Afuera
resource sounds prueba_biblioteca_rt_bip.wav exists 0
savew3d prueba_biblioteca_datos_rt2.w3d
zipentry prueba_biblioteca_datos_rt2.w3d sounds/prueba_biblioteca_rt_bip.wav
entryhas prueba_biblioteca_datos_rt2.w3d EXTERNALS.txt prueba_biblioteca_rt_bip.wav 0
# BORRAR un huerfano de afuera: deja de ser del proyecto (su archivo de disco queda) y no vuelve al guardar
recdelete textures prueba_biblioteca_rt_particula.png
resource textures prueba_biblioteca_rt_particula.png exists 0
savew3d prueba_biblioteca_datos_rt2b.w3d
jsonhas prueba_biblioteca_datos_rt2b.w3d "external" 0
resource textures prueba_biblioteca_rt_particula.png exists 0

# ---- C) BORRAR (en uso: sus usuarios quedan sin el, con undo; huerfano) y DUPLICAR ----
recduplicate materials Material Material.001
resource materials Material.001 users 0
recdelete materials Material.001
resource materials Material.001 exists 0
resource materials Material users 1
recdeleteforced materials Material
resource materials Material exists 0
meshcheck Cubo material 0 Default
undo
resource materials Material exists 1 users 1
meshcheck Cubo material 0 Material
# una malla 3D en uso: se borran sus objetos (con undo)
recduplicate meshes Cubo Cubo.001
resource meshes Cubo.001 users 0
recdeleteforced meshes Cubo
resource meshes Cubo exists 0
outview scene
fail selobj Cubo
undo
selobj Cubo
meshcheck Cubo resource Cubo
recpurge meshes n 1
resource meshes Cubo.001 exists 0

# ---- D) TODA malla es un recurso con nombre ----
add cube
add cylinder
meshesresource n 3
meshcheck Cubo.001 resource Cubo.001
meshcheck Cilindro resource Cilindro
selobj Cubo
propstab 3
propsmesh tab 3 mesh3d 1 resource 0 tabs 10 selector Cubo

# ---- E) ARRASTRAR de la biblioteca: al 3D y a Properties ----
outview meshes
outrelease Cilindro 3d 0 0
selection n 1 has Cilindro.001
meshcheck Cilindro.001 resource Cilindro users 2
undo
fail selobj Cilindro.001
resource meshes Cilindro users 1
# al selector "Malla 3D" de Properties: el cubo pasa a ser un cilindro
selobj Cubo
propstab 3
outrelease Cilindro props mesh
meshcheck Cubo resource Cilindro
undo
meshcheck Cubo resource Cubo
# un material sobre la parte bajo el mouse (el cubo del centro de la vista)
matloose Rojo
outview materials
outrelease Rojo 3d 0 0
meshcheck Cubo material 0 Rojo
undo
meshcheck Cubo material 0 Material
# una textura sobre el material de esa parte
outview textures
outrelease dosmats-b.png 3d 0 0
texrefof material Material textures/dosmats-b.png
undo
texrefof material Material textures/dosmats.png
# a los desplegables de la tarjeta Material (la pestania 2): el material de la parte y su textura
selobj Cubo
propstab 2
outview materials
outrelease Rojo props material
meshcheck Cubo material 0 Rojo
undo
meshcheck Cubo material 0 Material
outview textures
outrelease dosmats-b.png props texture
texrefof material Material textures/dosmats-b.png
undo
texrefof material Material textures/dosmats.png
# un sonido soltado en el 3D es un objeto Sonido nuevo donde cae (objects/Sonido.h); Ctrl+Z lo saca
outview sounds
outrelease prueba_biblioteca_rt_bip.wav 3d 0 0
undo

# ---- F) una LIBRERIA externa: se explora sin montarla, de solo lectura ----
savew3d prueba_biblioteca_datos_lib_v4.w3d
scenedefault
liblink prueba_biblioteca_datos_lib_v4.w3d
libs n 1
fail libvincular prueba_biblioteca_datos_lib_v4.w3d
fail libvincular dosmats.png
outview lib:prueba_biblioteca_datos_lib_v4
outfilter all
outrow Cilindro type meshes
outrow Rojo type materials
outrow dosmats-b.png type textures
fail outdobleclick Rojo
# (su contenido se ARRASTRA -fase de librerias-: la malla queda como una REFERENCIA al recurso de la libreria)
outrelease Cilindro 3d 0 0
meshcheck Cilindro resource prueba_biblioteca_datos_lib_v4/Cilindro
undo
fail selobj Cilindro
savew3d prueba_biblioteca_datos_rt3.w3d
# (el registro: nombre + archivo "ext:", relativo al .w3d cuando esta abajo de su carpeta)
jsonhas prueba_biblioteca_datos_rt3.w3d "file"
jsonhas prueba_biblioteca_datos_rt3.w3d "ext:
openw3d prueba_biblioteca_datos_rt3.w3d
libs n 1
libunlink prueba_biblioteca_datos_lib_v4
libs n 0
undo
libs n 1

# ---- lo que no tiene que pasar ----
fail recubicar textures textures/noexiste.png fuera x.png
fail recdato textures textures/dosmats-b.png NoExiste = 1
