# Cuatro quads, uno por material de dosmats.mtl. Lo importante no es la
# geometria: es que UN solo .mtl deje CUATRO materiales vivos, dos de ellos
# compartiendo la misma imagen.
mtllib dosmats.mtl

o dosmats-a
v -1.6 -0.5 0.0
v -0.6 -0.5 0.0
v -0.6  0.5 0.0
v -1.6  0.5 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 0.0 -1.0
usemtl dosmats
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

o dosmats-b
v -0.5 -0.5 0.0
v  0.5 -0.5 0.0
v  0.5  0.5 0.0
v -0.5  0.5 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 0.0 -1.0
usemtl dosmats-sombra
f 5/5/2 6/6/2 7/7/2
f 5/5/2 7/7/2 8/8/2

o dosmats-c
v  0.6 -0.5 0.0
v  1.6 -0.5 0.0
v  1.6  0.5 0.0
v  0.6  0.5 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 0.0 -1.0
usemtl dosmats-otra
f 9/9/3 10/10/3 11/11/3
f 9/9/3 11/11/3 12/12/3

o dosmats-d
v  1.7 -0.5 0.0
v  2.7 -0.5 0.0
v  2.7  0.5 0.0
v  1.7  0.5 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 0.0 -1.0
usemtl dosmats-sintex
f 13/13/4 14/14/4 15/15/4
f 13/13/4 15/15/4 16/16/4
