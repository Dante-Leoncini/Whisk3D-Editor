# ==========================================================================
#  PREFABS COMO RECURSO (W3dRaices.h): "New Prefab" crea uno vacio y abre su raiz
#  AISLADA para editarlo (las instancias son de la fase siguiente).
#  Correr DESDE ESTA CARPETA:
#    ../../platform/linux/build/whisk3d --script prueba_escenas_prefab.w3s
#
#  El prefab se guarda en prefabs/<slug>.w3dp = {"nombre", "raiz": <objeto con hijos>}
#  (lo que quede suelto al primer nivel, al lado de su objeto raiz, va a "sueltos" y
#  vuelve igual). Su vista del outliner lista los prefabs (0 usuarios hasta las
#  instancias: "Purge Orphans" no los toca), los renombra con undo y los borra.
# ==========================================================================

window 1280 720
scenedefault
rootnew prefab Enemigo
rootinfo n 2 active Enemigo type prefab prefabs 1 objects 1
rootcontext collection Enemigo lights 0 camera -
rootparent Enemigo
add cube
objname Cuerpo
parent Cuerpo Enemigo
objrel Cuerpo parent Enemigo
rootcamera Suelta
rootinfo objects 3
rootopen Scene
# (los 4 de la escena + las 2 rutinas que trae todo proyecto: Constructor y Limpiar pantalla)
rootinfo objects 6

# ---- guardar: la entrada del prefab, con su raiz, sus hijos y lo suelto ----
savew3d /tmp/w3d_f6_prefab.w3d
entryexists /tmp/w3d_f6_prefab.w3d prefabs/enemigo.w3dp 1
entryhas /tmp/w3d_f6_prefab.w3d prefabs/enemigo.w3dp "root" 1
entryhas /tmp/w3d_f6_prefab.w3d prefabs/enemigo.w3dp Cuerpo 1
entryhas /tmp/w3d_f6_prefab.w3d prefabs/enemigo.w3dp loose 1
entryhas /tmp/w3d_f6_prefab.w3d project.json Suelta 0
entryhas /tmp/w3d_f6_prefab.w3d project.json prefabs/enemigo.w3dp 1

# ---- abrir: el prefab no se carga hasta que se lo abre ----
openw3d /tmp/w3d_f6_prefab.w3d
rootinfo n 2 active Scene loaded Enemigo 0
rootopen Enemigo prefab
rootinfo type prefab objects 3
rootparent Enemigo
rootparent Suelta
objrel Cuerpo parent Enemigo
rootopen Scene
savew3d /tmp/w3d_f6_prefab_2.w3d
w3dequal /tmp/w3d_f6_prefab.w3d /tmp/w3d_f6_prefab_2.w3d

# ---- su vista del outliner ----
outview prefabs
outrows n 1
outrow Enemigo users 0 state huerfano
recpurge prefabs n 0
outrows n 1
recrename prefabs Enemigo Soldado
outrow Soldado
undo
outrow Enemigo
redo
savew3d /tmp/w3d_f6_prefab_3.w3d
entryexists /tmp/w3d_f6_prefab_3.w3d prefabs/soldado.w3dp 1
entryexists /tmp/w3d_f6_prefab_3.w3d prefabs/enemigo.w3dp 0
recdelete prefabs Soldado
outrows n 0
rootinfo n 1 prefabs 0
outview scene
savew3d /tmp/w3d_f6_prefab_4.w3d
entryexists /tmp/w3d_f6_prefab_4.w3d prefabs/soldado.w3dp 0
entryhas /tmp/w3d_f6_prefab_4.w3d project.json prefabs 0
