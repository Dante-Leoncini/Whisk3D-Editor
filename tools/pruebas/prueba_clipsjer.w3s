# ==========================================================================
#  CLIPS DE JERARQUIA COMPARTIDOS (animation/W3dAnimSet.h) y RETARGET por tamano.
#  Correr DESDE ESTA CARPETA:
#    ../../platform/linux/build/whisk3d --script prueba_clipsjer.w3s
#
#  Un clip de jerarquia lo TIENE un objeto raiz y anima a la raiz y a sus descendientes por
#  RUTA RELATIVA de nombres ("." / "Chasis/Puerta"); vive COMPARTIDO en una biblioteca (un
#  animset .w3da, bloques JCLP) que cualquier jerarquia con los mismos nombres puede usar: N
#  raices = UNA copia en memoria. Se prueba:
#    - las rutas (con los sufijos .NNN de una copia) y crear el clip desde el selector del
#      timeline ("New Animation > Hierarchy Clip"), editarlo en su VISTA (keyframes sobre la
#      raiz y sus hijos; lo que no es de la jerarquia no entra) y el preview del editor;
#    - duplicar la jerarquia: la copia usa la MISMA biblioteca (refs, una copia en memoria);
#    - guardar/abrir: registro "animsets", entrada .w3da con JCLP, "clipsJerarquia" en el nodo,
#      re-guardar da los mismos bytes;
#    - reproducir en varias raices a la vez e independientes (loop / una pasada / velocidad), la
#      raiz RELATIVA (cada una en su lugar), nodos que la jerarquia no tiene se ignoran;
#    - editar el clip desde OTRA raiz lo cambia para todas;
#    - retarget "rotaciones" de una jerarquia mas grande (el movimiento de la raiz escalado, los
#      hijos con su traslacion propia) y de un armature (huesos con la traslacion de su reposo,
#      la raiz escalada);
#    - dos bibliotecas iguales quedan en una al guardar;
#    - en un JUEGO editar un clip no lo vuelve animado (volver a "Juego" = su frame 1);
#    - lua: animObjeto("Biblioteca/clip"), animObjetoVelocidad, animRetarget;
#    - los "clips" de objeto inline de la primera version de esta fase se leen y se migran.
# ==========================================================================

window 1280 720

# ---- el formato de la PRIMERA version de esta fase ("clips" de objeto inline en el nodo): se sigue
#      leyendo y cada clip pasa a ser un clip de jerarquia de la biblioteca de su objeto ----
openw3d prueba_clipsjer_viejo.w3d
hierinfo Puerta lib Puerta clips 1 tracks abrir 2 path abrir . path abrir Hoja
hierplay Puerta abrir loop 0
hiertick 0.1666667 1
rotat Puerta 0 45 0 0.1
objat Puerta 3 0 0 0.001
objat Hoja 1.5 0 0 0.01
hierreset
savew3d /tmp/w3d_f6_clipsjer_viejo.w3d
entryexists /tmp/w3d_f6_clipsjer_viejo.w3d animations/puerta.w3da 1
entryhas /tmp/w3d_f6_clipsjer_viejo.w3d project.json "clips" 0
entryhas /tmp/w3d_f6_clipsjer_viejo.w3d project.json hierarchyClips 1

scenedefault

# ---- la jerarquia: Auto > Chasis > Puerta (x=1) ; Auto > Antena ----
add cube
objname Auto
add cube
objname Chasis
parent Chasis Auto
add cube
objname Puerta
parent Puerta Chasis
selobj Puerta
objpos 1 0 0
add cube
objname Antena
parent Antena Auto
hierpath Auto Auto .
hierpath Auto Puerta Chasis/Puerta
hiernode Auto Chasis/Puerta Puerta
hiernode Auto Chasis/Nada -

# ---- un clip NUEVO desde el selector del timeline, sobre la raiz elegida ----
selobj Auto
clipmenu Hierarchy Clip
clipinfo Auto n 1 active Clip
clipname abrir
animrange 1 11
clipinfo Auto n 1 has abrir active abrir
hierinfo Auto lib Auto clips 1 refs 1
# keyframes en su VISTA: la puerta gira y avanza, la raiz sube
animcurve Auto:abrir Puerta ry 1 0 11 90
animcurve Auto:abrir Puerta x 1 1 11 3
animcurve Auto:abrir . y 1 0 11 2
hierinfo Auto tracks abrir 2 path abrir Chasis/Puerta path abrir .
# lo que no es de su jerarquia no entra (la I sobre otro objeto no le agrega nada)
add cube
objname Suelto
selobj Suelto
rootkey n 0
# el preview del editor: el cabezal posa la jerarquia
frame 6
objat Auto 0 1 0 0.01
objat Puerta 2 0 0 0.01
rotat Puerta 0 45 0 0.1
frame 1
objat Auto 0 0 0 0.001
rootanim Scene

# ---- duplicar la jerarquia: las copias usan la MISMA biblioteca ----
duphierarchy copy Auto +hijos
duphierarchy copy Auto +hijos
hierinfo Auto.001 lib Auto refs 3
hierpath Auto.001 Puerta.001 Chasis/Puerta
hiernode Auto.001 Chasis/Puerta Puerta.001
hiermem clips 1
selobj Auto.001
objpos 10 0 0
selobj Auto.002
objpos -10 0 0
objscale 2 2 2
# una jerarquia que NO tiene la puerta (el nodo se ignora) usa la misma biblioteca
add cube
objname Moto
add cube
objname Chasis
parent Chasis.003 Moto
hierlib Moto Auto
# y una SIN biblioteca (el juego le pide el clip por su nombre calificado)
add cube
objname Bici
add cube
objname Chasis
parent Chasis.004 Bici

# ---- guardar / abrir ----
selobj Auto
savew3d /tmp/w3d_f6_clipsjer.w3d
entryexists /tmp/w3d_f6_clipsjer.w3d animations/auto.w3da 1
entryhas /tmp/w3d_f6_clipsjer.w3d project.json hierarchyClips 1
entryhas /tmp/w3d_f6_clipsjer.w3d project.json animations/auto.w3da 1
entryhas /tmp/w3d_f6_clipsjer.w3d animations/auto.w3da JCLP 1
entryhas /tmp/w3d_f6_clipsjer.w3d animations/auto.w3da Chasis/Puerta 1
openw3d /tmp/w3d_f6_clipsjer.w3d
hierinfo Auto lib Auto clips 1 refs 4 tracks abrir 2
hierinfo Moto lib Auto
hierinfo Bici lib -
hiermem clips 1
savew3d /tmp/w3d_f6_clipsjer_2.w3d
w3dequal /tmp/w3d_f6_clipsjer.w3d /tmp/w3d_f6_clipsjer_2.w3d

# ---- reproducir: varias raices a la vez, cada una con su cabezal y en su lugar ----
hierplay Auto abrir loop 0 dur 0.3667
hierplay Auto.001 abrir loop 1
hierplay Moto abrir loop 0
hiermem playing 3
hierinfo Auto refs 7
hiertick 0.1666667 1
hierframe Auto 6 0.01 clip abrir ended 0
objat Auto 0 1 0 0.01
objat Puerta 2 0 0 0.01
rotat Puerta 0 45 0 0.1
objat Auto.001 10 1 0 0.01
objat Puerta.001 2 0 0 0.01
objat Moto 0 1 0 0.01
hiervel Auto.001 2
hiertick 0.1666667 1
hierframe Auto 11 0.01 ended 1
hierframe Auto.001 5 0.01 ended 0
objat Auto 0 2 0 0.01
objat Auto.001 10 0.8 0 0.01
hierreset
hiermem playing 0
hierinfo Auto refs 4

# ---- retarget "rotaciones": la copia al doble de tamano ----
hierretarget Auto.002 rotations
hierplay Auto.002 abrir loop 0
hiertick 0.1666667 1
objat Auto.002 -10 2 0 0.01
objat Puerta.002 1 0 0 0.01
rotat Puerta.002 0 45 0 0.1
hierreset
selobj Auto.002
objpos -10 0 0
# ...y el mismo retarget como opcion POR DEFECTO del clip (la instancia vuelve a "el del clip")
hierretarget Auto.002 clip
hierclipretarget Auto abrir rotations
hierplay Auto.002 abrir loop 0
hiertick 0.1666667 1
objat Auto.002 -10 2 0 0.01
objat Puerta.002 1 0 0 0.01
hierreset
hierclipretarget Auto abrir completo
selobj Auto.002
objpos -10 0 0

# ---- editar el clip desde OTRA raiz lo cambia para todas (es compartido) ----
selobj Auto.001
clipmenu Auto.001: abrir
clipinfo Auto.001 active abrir
animcurve Auto.001:abrir Puerta.001 ry 11 45
rootanim Scene
hierplay Auto abrir loop 0
hiertick 0.5 1
rotat Puerta 0 45 0 0.1
hierreset

# ---- lua: el nombre calificado, la velocidad y el retarget ----
selobj Auto
objpos 0 0 0
rootscript Suelto prueba_clipsjer.lua
simplay 4
hierframe Bici 3 0.01 clip abrir
objat Bici 0 0.4 0 0.01
objat Auto.002 -10 1.6 0 0.01
scriptinfo shared bici_dur true
scriptinfo shared bici_vel true
scriptinfo shared nada true
simstop
objat Bici 0 0 0 0.001
objat Auto.002 -10 0 0 0.001

# ---- el retarget de un ARMATURE: la misma caminata en un esqueleto al doble ----
rigretarget Rig 2
checkbonepose RigA Cadera 5 1 0 0.01 frame 6
checkbonepose RigB Cadera 5 1 0 0.01 frame 6
checkbonepose RigB Pecho 0 2.5 0 0.01 frame 6
hierretarget RigB rotations
checkbonepose RigB Cadera 10 2 0 0.01 frame 6
checkbonepose RigB Pecho 0 2 0 0.01 frame 6
checkbonepose RigA Cadera 5 1 0 0.01 frame 6

# ---- dos bibliotecas IGUALES quedan en una al guardar ----
add cube
objname Farol
clipnew Farol parpadeo 1 11
animcurve Farol:parpadeo . vis 1 1 6 0
add cube
objname Farol2
clipnew Farol2 parpadeo 1 11
animcurve Farol2:parpadeo . vis 1 1 6 0
hierinfo Farol lib Farol
hierinfo Farol2 lib Farol2
rootanim Scene
savew3d /tmp/w3d_f6_clipsjer_3.w3d
hierinfo Farol2 lib Farol refs 2
entryexists /tmp/w3d_f6_clipsjer_3.w3d animations/farol.w3da 1
entryexists /tmp/w3d_f6_clipsjer_3.w3d animations/farol2.w3da 0

# ---- en un JUEGO editar un clip no lo vuelve animado: volver a "Juego" = su frame 1 ----
roottype game
rootanim game
rootmode kind 2 game 1
selobj Auto
clipmenu Auto: abrir
rootmode kind 0 game 0
frame 11
objat Auto 0 2 0 0.01
rootanim game
rootmode kind 2 game 1
objat Auto 0 0 0 0.001
rootinfo type game
