# EL TUTORIAL 9, ANIMAR LA PUERTA (docs/manual/es/tutoriales/animar-puerta.md): la puerta del tutorial 8 con su
# picaporte y, despues, los pasos del texto con sus teclas. Tiene que dejar los MISMOS keyframes que la animacion del
# duenio (puerta-picaporte.w3d, 2026-11-09): el picaporte baja del 1 al 9 (R Y -34), se queda abajo hasta el 26 y
# vuelve en el 33; la puerta se abre del 11 al 26 (R Z -80); el picaporte con la Cuadratica (acelera y frena de golpe).
# Generado desde tools/capturas/recetas_picaporte.py y recetas_animar.py (las mismas ETAPAS que filman los videos).

# ---- la puerta con su picaporte (tutorial 8) ----
objname Puerta
objscale 0.45 1 0.05
objpos 0 1 0
apply scale
cursor3d 0.45 1 0
origin cursor
cursor3d 0 -30 0
selobj Puerta
mouseview3d
key Tab
selmode face
select none
picknear -0.45 0.05 0
key Left_Shift down
key d
key Left_Shift up
key Escape
key s
text 0.15
key Return
key s
key z
text 0.45
key Return
key g
key x
text -0.31
key Return
key e
text 0.03
key Return
linked
mouseview3d
key p
key Tab
selobj Puerta
matname Madera
matcolor 0.55 0.33 0.17
selobj Puerta.001
matnew
matname Metal
matcolor 0.75 0.75 0.78
selobj Puerta.001
addui modifier 1
propstab 4
drawframe
propclick Mirror X
propclick Mirror Y
selobj Puerta.001
mouseview3d
key Keypad_/
key Tab
selmode face
picknear -0.76 0.08 0
key Left_Shift down
key d
key Left_Shift up
key Escape
key s
text 0.6
key Return
key e
text 0.08
key Return
selmode edge
picknear -0.8005 0.16 0
key g
key y
text 0.05
key Return
selmode face
picknear -0.76 0.185 0
key e
key x
text 0.34
key Return
key s
key x
text 0
key Return
linked
key p
key Tab
key Keypad_/
renamerow Puerta.002 Manija
selobj Puerta.001
propstab 4
drawframe
propclick Apply Modifier
selobj Puerta.001
selname Puerta
mouseview3d
key Left_Ctrl down
key j
key Left_Ctrl up
selobj Puerta
mouseview3d
key Tab
selmode face
picknear -0.76 0.05 0
picknear -0.76 -0.05 0 +
key x
menupick Faces
key Tab
selobj Manija
propstab 4
drawframe
propclick Apply Modifier
mouseview3d
key Tab
selmode face
picknear -0.76 0.08 0
picknear -0.76 -0.08 0 +
key Left_Shift down
key s
key Left_Shift up
menupick Cursor to Selected
key x
menupick Faces
key Tab
origin cursor
selobj Manija
selname Puerta
mouseview3d
key Left_Ctrl down
key p
key Left_Ctrl up
menupick Object (Keep Transform)

# ---- picaporte ----
selobj Manija
mouseview3d
frame 1
key i
menupick Rotation Only
frame 9
key r
key y
text -34
key Return
key i
menupick Rotation Only
keyvalue rot y 1 0
keyvalue rot y 9 -34

# ---- duplicados ----
tl selframe 9
tl duplicate
tl value 16
tl accept
tl selframe 1
tl duplicate
tl value 31
tl accept
keyvalue rot y 26 -34
keyvalue rot y 33 0
tlframes 1 9 26 33

# ---- puerta ----
selobj Puerta
mouseview3d
frame 11
key i
menupick Rotation Only
frame 26
key r
key z
text -80
key Return
key i
menupick Rotation Only
keyvalue rot z 11 0
keyvalue rot z 26 -80
tlframes 11 26
# el picaporte, hijo de la puerta, no se toco
selobj Manija
keyvalue rot y 9 -34
selobj Puerta

# ---- fin ----
tl end 50

# ---- limpias ----
selobj Manija
tl deletecurve rot x
tl deletecurve rot z
selobj Puerta
tl deletecurve rot x
tl deletecurve rot y

# ---- curvas ----
selobj Manija
keyinterp cuadratica 1 rot
keyinterp cuadratica 9 rot
keyinterp cuadratica 26 rot
keyinterp cuadratica 33 rot
keyvalue rot y 1 0 4
keyvalue rot y 9 -34 4
keyvalue rot y 26 -34 4
keyvalue rot y 33 0 4
selobj Puerta
keyvalue rot z 11 0 2
