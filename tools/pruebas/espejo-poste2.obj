# Quad VERTICAL de 1x1 centrado en el origen, mirando a -Z (a la camara).
mtllib espejo-poste2.mtl
o espejo-poste2
v -0.5 -0.5 0.0
v  0.5 -0.5 0.0
v  0.5  0.5 0.0
v -0.5  0.5 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 0.0 -1.0
usemtl espejo-poste2
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
