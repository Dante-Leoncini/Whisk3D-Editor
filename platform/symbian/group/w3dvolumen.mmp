// ============================================================================
//  w3dvolumen.mmp - w3dvolumen.dll: las TECLAS DE VOLUMEN del costado (RemCon). Aparte del exe a proposito (ver
//  src/w3dvolumendll.cpp): Whisk3D la carga con RLibrary; si al telefono le falta algo, no carga y el editor sigue.
// ============================================================================
TARGET          w3dvolumen.dll
TARGETTYPE      dll
UID             0x1000008d 0xA00D0221
VENDORID        0
EXPORTUNFROZEN
// las MISMAS capacidades que whisk3D.exe (Whisk3D.mmp): un proceso no carga una DLL con menos (err -46)
CAPABILITY      ReadUserData WriteUserData NetworkServices

ALWAYS_BUILD_AS_ARM
OPTION_REPLACE  ARMCC --cpu 6
OPTION_REPLACE  ARMCC -O2 -Otime

SOURCEPATH      ..\src
SOURCE          w3dvolumendll.cpp

USERINCLUDE     ..\inc
SYSTEMINCLUDE   \epoc32\include
SYSTEMINCLUDE   \epoc32\include\mw
SYSTEMINCLUDE   \epoc32\include\platform
SYSTEMINCLUDE   \epoc32\include\platform\mw

LIBRARY         euser.lib
LIBRARY         remconinterfacebase.lib
LIBRARY         remconcoreapi.lib
