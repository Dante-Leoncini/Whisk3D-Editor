/*
 * ==============================================================================
 *  Name        : Whisk3D.mmp
 *  Part of     : OpenGLEx / Whisk3D
 * ==============================================================================
 */

//New style application exe
// DOS VARIANTES desde este mismo archivo (una sola lista de fuentes):
//  - Whisk3D.mmp       -> whisk3D.exe, OpenGL ES 1.1 (pipeline fijo): N95 y todo S60 3rd/5th
//  - Whisk3D_gles2.mmp -> whisk3D_gles2.exe, OpenGL ES 2.0 (shaders): N8/C7/E7 y Symbian^3+.
//    Define W3D_MMP_GLES2 e incluye este archivo. Cambia el backend de graficos (graphics/gles2/w3dGraphicsGLES2.cpp,
//    el mismo de Android y la web), las libs (libglesv2 + libegl) y no vuelve a compilar los recursos.
//    El .pkg de GLES2 lo instala como Whisk3D.exe (misma UID: una variante reemplaza a la otra).
#ifdef W3D_MMP_GLES2
TARGET          whisk3D_gles2.exe
#else
TARGET          whisk3D.exe
#endif
TARGETTYPE      exe
UID             0x100039CE 0xA00D021D

EPOCSTACKSIZE   0x14000 // 80 KB, el maximo de EKA2 (era 30000: la carga de un proyecto grande -JSON, inflate, prefabs anidados- anda cerca)
EPOCHEAPSIZE    0x10000 0x6000000  // heap: 64 KB min, 96 MB max (subido de 64 MB para proyectos grandes; el N95 8GB tiene 128 MB RAM)

// Fase 3 unificacion: el codigo compartido del core se compila con este
// define (activa el dialecto Symbian: GLES/gl.h, shims de app-state, etc.)
MACRO           W3D_SYMBIAN
#ifdef W3D_MMP_GLES2
// backend de shaders: W3D_GLES2 = "Symbian con ES 2.0"; W3D_WEBGL = el backend emulado (Light.cpp, etc.)
MACRO           W3D_GLES2
MACRO           W3D_WEBGL
#endif

// Lua 5.4 en RVCT/C89: sin esto luaconf.h corta con "Compiler does not support
// 'long long'". LUA_USE_C89 usa numeros C89 (long + double) y evita las
// funciones de C99. Solo aplica a los .c de lua (nadie mas incluye luaconf.h).
MACRO           LUA_USE_C89
// lstate.h usa l_signalT = sig_atomic_t (de <signal.h>), que el Open C del N95 no
// define. l_signalT es un override sancionado por Lua (flags volatiles de trap/hook).
MACRO           l_signalT=int
// os.clock() de Lua (loslib.c) usa CLOCKS_PER_SEC de <time.h>, que Open C no define
// (clock() si existe). Valor POSIX estandar; os.clock no es critico para el juego.
MACRO           CLOCKS_PER_SEC=1000000
// AUDIO: prende el mixer real del Core (efectos + musica) y su backend Symbian
// (CMdaAudioOutputStream). Sin esto W3dAudio.cpp compila solo los stubs no-op.
MACRO           W3D_ENABLE_AUDIO

// Compilador RVCT 2.2 (ARMV6 en bld.inf): forzar ARM, ARMv6 y FPU por hardware.
// Es lo que aprovecha la VFP del N95/N8.
ALWAYS_BUILD_AS_ARM
OPTION_REPLACE  ARMCC --cpu 6
OPTION_REPLACE  ARMCC --fpu vfpv2 --fpmode fast
OPTION_REPLACE  ARMCC -O2 -Otime
// El CODIGO (region RO) ya supera los 4 MB linkeados: con la base RW default (--rw-base
// 0x400000) armlink cortaba con L6221E "Load region LR_1 overlaps". Se sube la base de
// datos a 8 MB; es solo una direccion DE LINK (el loader de Symbian reubica igual), lo
// unico que importa es que RO y RW no se pisen. Si el codigo algun dia pasa los 8 MB,
// subir de nuevo. (armlink toma la ULTIMA --rw-base de la linea: esta pisa la default.)
LINKEROPTION    ARMCC --rw-base 0x800000

VENDORID        0

SOURCEPATH      ..\src
