<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Leer texturas/modelos del almacenamiento (Descargas, etc.) en Android <=10: el pedido en runtime lo hace
         main.cpp (SDL_AndroidRequestPermission, solo API<=29). Desde Android 11 todo pasa por MANAGE_EXTERNAL_STORAGE.
         NO va READ_MEDIA_IMAGES: nadie lo pedia en runtime (no servia de nada; las texturas se leen con "All files
         access") y Google Play obliga a justificar los permisos de fotos y videos o usar el selector de fotos. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Escribir el OBJ/MTL exportado y el render PNG. WRITE_EXTERNAL_STORAGE es no-op
         en API 30+ (scoped storage); con requestLegacyExternalStorage vale en API<=29,
         que es donde el file browser escribe a /sdcard por fopen. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
                     android:maxSdkVersion="29" />
    <!-- API 30+ (Android 11): para leer/escribir ARCHIVOS arbitrarios (modelos .obj/.w3d, texturas) con el file
         browser interno (opendir/fopen). Los permisos de media solo dan imagenes/videos -> no se cargaban modelos.
         "All files access": se pide en runtime (el Activity abre la pantalla de Settings). Mantiene nuestro browser. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Jugar en red (net/W3dRed.cpp: LAN, wifi o internet por UDP). Es un permiso "normal": no se pide en
         runtime. El permiso de cada proyecto lo da el editor (le pregunta al usuario al abrirlo). -->
    <!-- la vibracion del agarre de la biblioteca (pulsacion larga) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- enableOnBackInvokedCallback=false: con targetSdk 36 el "atras predictivo" viene prendido y Android deja de
         llamar a onBackPressed, que es por donde SDL (SDLActivity) le pasa la tecla Atras al editor -->
    <application
        android:requestLegacyExternalStorage="true"
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- launchMode=singleTask: reabrir desde el launcher/recientes TRAE la instancia existente (onResume), NO crea
             otra Activity. Sin esto, con los globals C++ estaticos vivos, main() se relanzaba y ConstructUniversal
             DUPLICABA la escena (aparecia otro cubo + camara + luz encima de lo que ya habia).
             configChanges: rotar / mostrar teclado / cambiar densidad NO destruye ni recrea la Activity (sino tambien
             se relanzaba main -> misma duplicacion + perdida del contexto GL = texturas negras). SDL maneja el resize. -->
        <activity
            android:name=".Whisk3DActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|touchscreen|locale|fontScale"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- abrir un proyecto .w3d desde el gestor de archivos (equivale al
                 doble click de PC). Se filtra por EXTENSION porque .w3d no tiene
                 MIME registrado en Android (llega como octet-stream o texto). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.w3d" android:mimeType="*/*" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.w3d" android:mimeType="*/*" />
            </intent-filter>
        </activity>

    </application>

</manifest>
