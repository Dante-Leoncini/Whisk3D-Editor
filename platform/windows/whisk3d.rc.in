// Recurso de icono embebido en el exe (lo genera CMake via configure_file -> @W3D_ICON_ABS@ = ruta
// absoluta de res/Whisk3D.ico). El ICON con el ID mas bajo (1) es el que el Explorador, el menu
// inicio, la barra de tareas y Alt+Tab usan como icono del programa. Sin esto el exe queda con el
// icono generico de Windows (SDL_SetWindowIcon en runtime NO afecta al acceso directo del menu inicio).
1 ICON "@W3D_ICON_ABS@"

// LOS DATOS DEL PROGRAMA (Propiedades > Detalles del exe): quien lo hace, que es, la version (la fecha AA.MM.DD del
// momento en que se configura CMake). Un exe sin ellos es una de las cosas que los antivirus miran para desconfiar
// (McAfee lo marcaba como virus). Sin #include <winver.h>: los numeros van a mano (VS_FF_*, VOS_NT_WINDOWS32, VFT_APP)
1 VERSIONINFO
FILEVERSION @W3D_RC_YY@,@W3D_RC_MM@,@W3D_RC_DD@,0
PRODUCTVERSION @W3D_RC_YY@,@W3D_RC_MM@,@W3D_RC_DD@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Dante Leoncini"
            VALUE "FileDescription", "Whisk3D - 3D editor and engine"
            VALUE "FileVersion", "@W3D_RC_VERSION@"
            VALUE "InternalName", "whisk3d"
            VALUE "LegalCopyright", "Copyright (c) Dante Leoncini. MIT License"
            VALUE "OriginalFilename", "whisk3d.exe"
            VALUE "ProductName", "Whisk3D"
            VALUE "ProductVersion", "@W3D_RC_VERSION@"
            VALUE "Comments", "https://whisk3d.com.ar"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
