# ===============================
# WEBGL / EMSCRIPTEN
# ===============================

# salida compilada del build web (build_web.sh -> platform/web/build/): whisk3d.html/.js/.wasm/.data.
# Ya la cubre la regla generica 'build/' de arriba; el resto de platform/web/ (shim de GL, shell.html,
# serve_nocache.py) SI va al repo. La vieja carpeta raiz /web quedo obsoleta.

# ===============================
# IDEs
# ===============================

.vscode/
.settings/

# volcados de depuracion (posiciones de vertices / esqueleto por frame). Son salida de las herramientas de debug
# del importador: no son parte del proyecto y no tienen que volver a entrar por un "git add ." distraido.
die_f*.txt
gw_f*.txt
skel_f*.txt
w_f*.txt
wf*.txt
wchk.txt
tmp.txt
g_tmp.txt
n_tmp.txt
u.txt
whisk3d.log

# ===============================
# BASURA DE LOS TESTS DEL HARNESS (--script)
# ===============================
# proyectos temporales que guardan los tests (vtxcheck/curvcheck/armsave...)
/vtxchk
/curvchk
/contenido/
platform/linux/debug/

# proyectos sueltos en la RAIZ del repo: son basura de pruebas manuales (guardarw3d con
# ruta relativa deja el .w3d y su carpeta de contenido al lado del ejecutable/cwd).
# Los proyectos de verdad viven en Whisk3D-Examples o en "W3D Examples".
/*.w3d
/*.w3dm
/contenido/
/scratchpad/

# spec del .w3dm + corpus de archivos viejos para testear la retrocompatibilidad.
# Util para desarrollar, pero no va al repo (pedido de Dante). Si algun dia se quiere
# versionar (es el punto de coordinacion entre las dos PCs para los nombres de bloque),
# sacar esta linea.
/formato/
